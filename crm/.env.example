# Copy to .env.local and fill in. .env.local is gitignored and must stay that way —
# it holds a database URL and an OAuth client secret.

# ── Database ────────────────────────────────────────────────────────────────
# Local development against Homebrew postgres@16:
DATABASE_URL=postgres://panta@localhost:5432/panta_crm_dev
# Production is a Neon connection string. The driver is selected automatically
# by hostname (see src/lib/db/client.ts) — anything containing "neon.tech" uses
# the serverless HTTP driver, everything else uses node-postgres over TCP.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.us-west-2.aws.neon.tech/panta_crm?sslmode=require

# ── Auth ────────────────────────────────────────────────────────────────────
# The ONLY address permitted to sign in. There is no account creation.
ALLOWED_EMAIL=damonjhastings@gmail.com

# Google Cloud Console → Credentials → OAuth client ID → Web application.
# Day-one scopes are openid/email/profile only. gmail.readonly is added in
# Phase 3b via incremental authorization on this same client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Absolute origin used to build the OAuth redirect URI. Must exactly match one
# of the Authorized redirect URIs registered on the OAuth client.
PUBLIC_APP_ORIGIN=http://localhost:4390

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Signs nothing today; encrypts Google refresh tokens at rest in Phase 3b.
TOKEN_ENCRYPTION_KEY=

# ── Phase 3b ────────────────────────────────────────────────────────────────
# Bearer token the daily Vercel cron presents to /api/cron/gmail-sync.
CRON_SECRET=
