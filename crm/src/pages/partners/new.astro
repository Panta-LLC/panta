---
export const prerender = false;

import App from '../../layouts/App.astro';
import { requireUser } from '../../lib/auth/guard.ts';

requireUser(Astro.locals);

const error = Astro.url.searchParams.get('error');
---

<App title="Add a partner">
  <p class="kicker"><a href="/partners">Partners</a> · New</p>
  <h1>Add a partner</h1>
  <p class="muted lede">
    Generates a private referral link for them. Only the name is required — the rest
    is context for reading the leads they send.
  </p>

  {error === 'name' && <p class="err">A name is required.</p>}

  <form method="POST" action="/api/partners" class="form">
    <div>
      <label for="name">Partner name</label>
      <input id="name" name="name" type="text" required autofocus />
      <p class="hint">
        The organization or person as you'd say it out loud. It appears on their form
        — "This is {'{name}'}'s private link."
      </p>
    </div>

    <div class="row">
      <div>
        <label for="contactName">Person</label>
        <input id="contactName" name="contactName" type="text" />
        <p class="hint">Their form greets them by first name.</p>
      </div>
      <div>
        <label for="email">Email</label>
        <input id="email" name="email" type="email" />
      </div>
    </div>

    <div>
      <label for="phone">Phone</label>
      <input id="phone" name="phone" type="tel" />
    </div>

    <div>
      <label for="relationship">How you know them</label>
      <input id="relationship" name="relationship" type="text"
        placeholder="Bookkeeper for two of our nonprofits" />
      <p class="hint">
        Shown in the partner list. It is the context that makes a referral from them
        make sense six months later.
      </p>
    </div>

    <div>
      <label for="notes">Notes</label>
      <textarea id="notes" name="notes" rows="3"></textarea>
    </div>

    <div class="actions">
      <button class="btn btn--primary" type="submit">Add and generate a link</button>
      <a class="btn btn--ghost" href="/partners">Cancel</a>
    </div>
  </form>
</App>

<style>
  .lede {
    max-width: var(--measure);
    margin-top: -0.5rem;
  }
  .form {
    max-width: 34rem;
  }
  .form > * + * {
    margin-top: 1.25rem;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .hint {
    font-size: 0.85rem;
    color: var(--stone-deep);
    margin: 0.35rem 0 0;
  }
  .actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }
  .err {
    border-left: 2px solid var(--amber);
    background: var(--amber-soft);
    padding: 0.6rem 0.85rem;
    font-size: 0.9rem;
  }
</style>
