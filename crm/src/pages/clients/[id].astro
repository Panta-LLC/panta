---
export const prerender = false;

import App from '../../layouts/App.astro';
import Timeline from '../../components/Timeline.astro';
import { requireUser } from '../../lib/auth/guard.ts';
import { getClient } from '../../lib/db/queries/clients.ts';
import { listPulseChecksForClient } from '../../lib/db/queries/pulse.ts';
import { listTimeline, MANUAL_KINDS } from '../../lib/db/queries/interactions.ts';
import { listLeadsForClient, URGENCY_LABELS } from '../../lib/db/queries/leads.ts';
import {
  listProjectsForClient,
  PROJECT_KIND_LABELS,
  PROJECT_STATUS_LABELS,
  fmtPrice,
} from '../../lib/db/queries/projects.ts';
import { fmtDate, fmtCountdown } from '../../lib/format.ts';

requireUser(Astro.locals);

const { id } = Astro.params;
const client = id ? await getClient(id) : null;
if (!client) return Astro.redirect('/clients', 302);

const [checks, timeline, projects, originLeads] = await Promise.all([
  listPulseChecksForClient(client.id),
  listTimeline(client.id),
  listProjectsForClient(client.id),
  // Where this organization came from, if it came from anywhere. Almost always
  // empty — most clients are added by hand — which is why it renders nothing
  // at all rather than an "Origin: —" row taking up space on every page.
  listLeadsForClient(client.id),
]);

const STATUS_LABELS: Record<string, string> = {
  scheduled: 'Scheduled',
  prepped: 'Prep done',
  in_call: 'In call',
  captured: 'Captured',
  readout_drafted: 'Readout drafted',
  readout_sent: 'Readout sent',
  abandoned: 'Abandoned',
};

function hrefFor(c: (typeof checks)[number]) {
  if (c.status === 'scheduled') return `/pulse/${c.id}/prep`;
  if (c.status === 'prepped' || c.status === 'in_call') return `/pulse/${c.id}/run`;
  return `/pulse/${c.id}/capture`;
}

const site = client.websiteUrl
  ? client.websiteUrl.startsWith('http')
    ? client.websiteUrl
    : `https://${client.websiteUrl}`
  : null;

// Pre-fill the note timestamp with now, in the input's expected local format.
const nowLocal = new Date(Date.now() - new Date().getTimezoneOffset() * 60000)
  .toISOString()
  .slice(0, 16);
---

<App title={client.name}>
  <p class="kicker"><a href="/clients">Clients</a></p>
  <div class="head">
    <div>
      <h1>{client.name}</h1>
      <p class="muted meta">
        {client.sector ?? 'Sector not set'}
        {client.city && ` · ${client.city}${client.state ? `, ${client.state}` : ''}`}
        {' · '}
        {
          site ? (
            <a href={site} target="_blank" rel="noreferrer noopener">
              {site.replace(/^https?:\/\//, '')}
            </a>
          ) : (
            'no website'
          )
        }
      </p>
    </div>
    <form method="POST" action="/api/pulse">
      <input type="hidden" name="clientId" value={client.id} />
      <button class="btn btn--primary" type="submit">Start a Pulse Check</button>
    </form>
  </div>

  {client.notes && <div class="card" style="margin-bottom:2rem"><p style="margin:0">{client.notes}</p></div>}

  {
    originLeads.length > 0 && (
      <div class="origin">
        {originLeads.map((l) => (
          <>
            <p class="origin__line">
              {l.partnerName ? (
                <>
                  Referred by{' '}
                  <a href={`/partners/${l.partnerId}`}>{l.partnerName}</a>
                </>
              ) : (
                'Came in as a lead'
              )}
              {' · '}
              <a href={`/leads/${l.id}`}>{fmtDate(l.createdAt)}</a>
              {' · '}
              <span class="muted">{URGENCY_LABELS[l.urgency] ?? l.urgency}</span>
              {/*
                Carried onto the client page because it changes how you open
                the first conversation, and by the time you are looking at this
                record you have usually forgotten which it was.
              */}
              {!l.permissionToContact && (
                <span class="origin__cold"> · they were not told to expect us</span>
              )}
            </p>
            {l.referrerNote && <p class="origin__note">"{l.referrerNote}"</p>}
          </>
        ))}
      </div>
    )
  }

  <div class="cols">
    <div>
      <h2 id="timeline">Timeline</h2>

      <form method="POST" action="/api/interactions" class="note">
        <div class="note__row">
          <select name="kind" aria-label="Kind">
            {MANUAL_KINDS.map((k) => <option value={k}>{k[0]!.toUpperCase() + k.slice(1)}</option>)}
          </select>
          <input type="datetime-local" name="occurredAt" value={nowLocal} aria-label="When" />
        </div>
        <input type="hidden" name="clientId" value={client.id} />
        <input type="text" name="subject" placeholder="Subject (optional)" />
        <textarea name="body" rows="2" placeholder="What happened?" required></textarea>
        <button class="btn btn--ghost" type="submit">Log it</button>
      </form>

      <Timeline entries={timeline} />
    </div>

    <aside>
      <h2>Pulse Checks</h2>
      {
        checks.length === 0 ? (
          <p class="muted">None yet.</p>
        ) : (
          <ul class="side">
            {checks.map((c) => {
              const due =
                c.readoutDueAt && c.status !== 'readout_sent'
                  ? fmtCountdown(c.readoutDueAt)
                  : null;
              return (
                <li>
                  <a href={hrefFor(c)}>{STATUS_LABELS[c.status] ?? c.status}</a>
                  <span class="kicker">
                    {c.endedAt ? fmtDate(c.endedAt) : fmtDate(c.createdAt)}
                  </span>
                  {due && (
                    <span class={`kicker${due.overdue || due.urgent ? ' is-warn' : ''}`}>
                      readout {due.text}
                    </span>
                  )}
                </li>
              );
            })}
          </ul>
        )
      }

      <div class="side__head">
        <h2>Projects</h2>
        <a class="kicker" href={`/projects/new?clientId=${client.id}`}>+ new</a>
      </div>
      {
        projects.length === 0 ? (
          <p class="muted">None yet.</p>
        ) : (
          <ul class="side">
            {projects.map((p) => (
              <li>
                <a href={`/projects/${p.id}`}>{p.name}</a>
                <span class="kicker">
                  {PROJECT_STATUS_LABELS[p.status] ?? p.status}
                  {p.kind && ` · ${PROJECT_KIND_LABELS[p.kind] ?? p.kind}`}
                </span>
                <span class="kicker">{fmtPrice(p.priceCents)}</span>
              </li>
            ))}
          </ul>
        )
      }
    </aside>
  </div>
</App>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .head h1 {
    margin-bottom: 0.25rem;
  }
  .meta {
    font-size: 0.9rem;
    margin: 0;
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: 3rem;
    align-items: start;
  }
  .cols h2 {
    font-size: 1.05rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1rem;
  }
  .note {
    margin-bottom: 2rem;
  }
  .note > * + * {
    margin-top: 0.5rem;
  }
  .note__row {
    display: flex;
    gap: 0.5rem;
  }
  .note__row select {
    max-width: 9rem;
  }
  .side {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
  }
  .side li {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }
  .side a {
    font-weight: 500;
    text-decoration: none;
    color: var(--charcoal);
  }
  .side a:hover {
    color: var(--bamboo-deep);
  }
  .side .is-warn {
    color: var(--amber);
  }
  .side__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .side__head h2 {
    flex: 1;
  }
  .side__head .kicker {
    padding-left: 0.5rem;
  }
  @media (max-width: 60rem) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
  }

  /* Provenance, not content: a hairline strip above the working columns rather
     than a card, so it reads as a fact about the record and never competes
     with the timeline. */
  .origin {
    border-left: 2px solid var(--sage);
    padding: 0.15rem 0 0.15rem 0.9rem;
    margin-bottom: 2rem;
  }
  .origin__line {
    margin: 0;
    font-size: 0.92rem;
  }
  .origin__note {
    font-family: var(--font-serif);
    color: var(--stone-deep);
    margin: 0.35rem 0 0;
    max-width: var(--measure);
  }
  .origin__cold {
    color: var(--amber);
  }
</style>
