---
export const prerender = false;

import App from '../../../layouts/App.astro';
import { requireUser } from '../../../lib/auth/guard.ts';
import { getPulseCheck } from '../../../lib/db/queries/pulse.ts';
import { fmtCountdown, fmtDateTime } from '../../../lib/format.ts';

requireUser(Astro.locals);

const { id } = Astro.params;
const check = id ? await getPulseCheck(id) : null;
if (!check) return Astro.redirect('/pulse', 302);

const p = check.pulse;
const due = p.readoutDueAt ? fmtCountdown(p.readoutDueAt) : null;

// The funnel fields, §3 of docs/FUNNEL-MEASUREMENT.md. Kept out of `rows`
// below on purpose: `rows` is the capture sheet, which prints in questionnaire
// order and belongs to the pinned instrument. These are pipeline bookkeeping —
// they are not asked as instrument questions, they are not versioned with it,
// and folding them into that list would be the first step toward the
// questionnaire quietly growing sales questions.
const SOURCE_LABELS: Record<string, string> = {
  referral: 'referral — someone told them',
  search: 'search — Google, etc.',
  google_business_profile: 'Google Business Profile',
  social: 'social',
  newsletter: 'newsletter',
  pulse_article: 'a Pulse article',
  outreach: 'our outreach',
  repeat_client: 'worked with us before',
  event: 'event or in person',
  unknown: "asked, but it didn't resolve",
};

const OUTCOME_LABELS: Record<string, string> = {
  no_show: 'no-show',
  held_no_proposal: 'held — no proposal',
  proposal_sent: 'proposal sent',
  closed_won: 'closed won',
  closed_lost: 'closed lost',
};

const CAPACITY_LABELS: Record<string, string> = {
  under_1h: 'under 1 hr',
  '1_3h': '1–3 hrs',
  '3_plus': '3+ hrs',
  none_done_for_us: "none — it'd have to be done for us",
};

/** The capture sheet, in the order the questionnaire prints it. */
const rows: { key: string; label: string; value: string | number | null; long?: boolean }[] = [
  { key: 'triggerText', label: 'Trigger (why now)', value: p.triggerText, long: true },
  { key: 'goalInTheirWords', label: 'Their goal, in their words', value: p.goalInTheirWords, long: true },
  { key: 'fiveSecondRead', label: 'My 5-second read', value: p.fiveSecondRead, long: true },
  { key: 'whatTheyActuallyDo', label: 'What they actually do', value: p.whatTheyActuallyDo, long: true },
  { key: 'findNoticed', label: 'FIND — noticed', value: p.findNoticed, long: true },
  { key: 'trustNoticed', label: 'TRUST — noticed', value: p.trustNoticed, long: true },
  { key: 'chooseNoticed', label: 'CHOOSE — noticed', value: p.chooseNoticed, long: true },
  { key: 'stepsToContact', label: 'Steps to contact', value: p.stepsToContact },
  { key: 'honestReplyTime', label: 'Honest reply time', value: p.honestReplyTime },
  { key: 'lockedAssets', label: 'Locked assets', value: p.lockedAssets, long: true },
  { key: 'decisionMaker', label: 'Decision-maker', value: p.decisionMaker, long: true },
  { key: 'oneThingSaidOutLoud', label: 'Said out loud as the one thing', value: p.oneThingSaidOutLoud, long: true },
  { key: 'planShapedNotAnswered', label: 'Plan-shaped, deliberately not answered', value: p.planShapedNotAnswered, long: true },
];
---

<App title={`Capture · ${check.client.name}`}>
  <p class="kicker">
    <a href={`/clients/${check.client.id}`}>{check.client.name}</a> · Pulse Check
  </p>

  <div class="head">
    <div>
      <h1>Capture sheet</h1>
      <p class="muted" style="margin:0">
        Held {fmtDateTime(p.endedAt ?? p.startedAt)}. Everything the readout is built from.
      </p>
    </div>
    {
      due && (
        <div class={`due${due.overdue ? ' is-overdue' : due.urgent ? ' is-urgent' : ''}`}>
          <p class="kicker" style="margin:0">Readout due</p>
          <p class="due__text">{due.text}</p>
          <p class="kicker" style="margin:0">{fmtDateTime(p.readoutDueAt)}</p>
        </div>
      )
    }
  </div>

  <form method="POST" action={`/api/pulse/${p.id}/capture`} class="cap">
    {
      rows.map((r) => (
        <div class="cap__row">
          <label for={r.key}>{r.label}</label>
          {r.long ? (
            <textarea id={r.key} name={r.key} rows="2">{r.value ?? ''}</textarea>
          ) : (
            <input id={r.key} name={r.key} type="text" value={r.value ?? ''} />
          )}
        </div>
      ))
    }

    <div class="cap__row">
      <label for="capacity">Capacity</label>
      <select id="capacity" name="capacity">
        <option value="">—</option>
        {
          Object.entries(CAPACITY_LABELS).map(([v, label]) => (
            <option value={v} selected={p.capacity === v}>{label}</option>
          ))
        }
      </select>
    </div>

    {/* Below the capture sheet and visibly separate from it, because it is a
        different kind of record: the sheet is what they said, this is what the
        conversation did. Same form and same submit, so it saves in one action
        rather than becoming a second thing to remember. */}
    <fieldset class="cap__funnel">
      <legend>Funnel</legend>
      <p class="muted cap__note">
        Two questions, asked every time — the verbatim answers are the point,
        the categories are just how they get counted. &ldquo;What made you
        book?&rdquo; is the Trigger field above.
      </p>

      <div class="cap__row">
        <label for="sourceVerbatim">&ldquo;How did you find me?&rdquo; — word for word</label>
        <textarea id="sourceVerbatim" name="sourceVerbatim" rows="2">{p.sourceVerbatim ?? ''}</textarea>
      </div>

      <div class="cap__row">
        <label for="sourceCategory">Source, categorized</label>
        <select id="sourceCategory" name="sourceCategory">
          <option value="">— not asked yet</option>
          {
            Object.entries(SOURCE_LABELS).map(([v, label]) => (
              <option value={v} selected={p.sourceCategory === v}>{label}</option>
            ))
          }
        </select>
      </div>

      <div class="cap__row">
        <label for="serviceInterest">Closest service line</label>
        <input
          id="serviceInterest"
          name="serviceInterest"
          type="text"
          value={p.serviceInterest ?? ''}
          placeholder="web-design-development"
        />
        <p class="muted cap__hint">
          The site&rsquo;s service slug, so it joins against the
          <code>service_line</code> property on the analytics side.
        </p>
      </div>

      <div class="cap__row">
        <label for="salesOutcome">Outcome</label>
        <select id="salesOutcome" name="salesOutcome">
          <option value="">— not resolved yet</option>
          {
            Object.entries(OUTCOME_LABELS).map(([v, label]) => (
              <option value={v} selected={p.salesOutcome === v}>{label}</option>
            ))
          }
        </select>
        <p class="muted cap__hint">
          Come back and set this when it resolves. Engagement value isn&rsquo;t
          here — it lives on the project this call produced.
        </p>
      </div>
    </fieldset>

    <div class="cap__actions">
      <button class="btn btn--ghost" type="submit" name="action" value="save">Save</button>
      <button class="btn btn--primary" type="submit" name="action" value="readout">
        Write the readout →
      </button>
      <a class="btn btn--ghost" href={`/pulse/${p.id}/run`}>Back to the interview</a>
    </div>
  </form>
</App>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    margin-bottom: 2rem;
  }
  .head h1 {
    margin-bottom: 0.25rem;
  }
  /* The 48-hour promise is the only unconditional commitment the offer makes,
     so it is the loudest thing on this page. */
  .due {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
    text-align: right;
    min-width: 11rem;
  }
  .due__text {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    margin: 0.15rem 0;
  }
  .due.is-urgent,
  .due.is-overdue {
    border-color: var(--amber);
    background: var(--amber-soft);
  }
  .due.is-overdue .due__text {
    color: var(--amber);
  }
  .cap {
    max-width: 42rem;
  }
  .cap__row {
    margin-bottom: 1.25rem;
  }
  .cap__row label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--stone-deep);
  }
  .cap__funnel {
    margin-top: 2rem;
    padding: 1.25rem 1.25rem 0.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .cap__funnel legend {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--stone-deep);
    padding-inline: 0.4rem;
  }
  .cap__note {
    margin: 0 0 1.25rem;
    font-size: 0.85rem;
  }
  .cap__hint {
    margin: 0.35rem 0 0;
    font-size: 0.78rem;
  }
  .cap__actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
</style>
