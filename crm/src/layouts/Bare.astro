---
/**
 * Chrome-free shell for pages that must render without a session (/login) or
 * without navigation (the readout print route).
 */
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Panta CRM</title>
  </head>
  <body>
    <slot />
  </body>
</html>
