# Contact form SMTP relay (used by /api/contact — set these in Vercel too)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=app-password-here
# Where contact-form submissions are delivered (defaults to hello@panta.co)
CONTACT_TO=damon@panta.llc

# Newsletter — Buttondown (used by /api/subscribe — set this in Vercel too).
# Get it from Buttondown → Settings → Programming → API key.
# Subscribers are created WITHOUT a `type` field, which is what triggers
# Buttondown's own double opt-in; see src/pages/api/subscribe.ts.
# Leave unset locally to exercise the dev fake-success path.
BUTTONDOWN_API_KEY=

# Optional overrides — sensible defaults are baked in
# PUBLIC_GA4_MEASUREMENT_ID=G-N46J0CDDZF
# PUBLIC_SANITY_PROJECT_ID=tdi9ql1j
# PUBLIC_SANITY_DATASET=pantaco
