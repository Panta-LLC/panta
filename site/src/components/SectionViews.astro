---
// Section-view tracking for any page whose sections carry data-section.
// Extracted from index.astro when the mission sections (verbs/origin) moved to
// /about/ — both pages now report through this one component instead of the
// homepage owning a private copy.
//
// The event name stays `home_section_view` even off the homepage: the series
// has already changed shape twice (scroll → slide → scroll), and renaming the
// event would orphan it. Annotate the switch to Plausible in the dashboard.
---
<script>
  // One event with a `section` property, not N event names: it keeps drop-off
  // readable as a single funnel. In Plausible, `section` and `via` are custom
  // properties — add them under the site's Properties settings or they are
  // collected and never displayed.
  const seen = new Set<string>();

  // The buffering that used to live here is gone with GA4. It existed because
  // the consent banner appeared 600ms in, so the early sections — the
  // denominator of the funnel — were usually observed before the visitor had
  // decided, and pantaTrack dropped anything sent before gtag loaded.
  // Plausible needs no consent, and Analytics.astro defines pantaTrack inline
  // at parse time and queues until the tracker module resolves, so a call made
  // this early is held rather than lost.
  const send = (section: string, via = 'scroll') => {
    (window as any).pantaTrack?.('home_section_view', { section, via });
  };

  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const id = (entry.target as HTMLElement).dataset.section ?? '';
        if (!id || seen.has(id)) continue;
        seen.add(id);
        send(id);
        io.unobserve(entry.target);
      }
    },
    { threshold: 0.4 }
  );

  document
    .querySelectorAll<HTMLElement>('[data-section]')
    .forEach((el) => io.observe(el));
</script>
