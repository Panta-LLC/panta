---
/**
 * Plausible, via the official npm tracker.
 *
 * Replaced a consent-gated GA4 loader and, alongside it, Vercel Web Analytics
 * and Speed Insights — three trackers counting the same pageviews. Plausible is
 * cookieless and stores no personal data, which is why there is no consent
 * banner in front of it any more: there is nothing to consent to.
 *
 * Excluding your own visits needs no code: the tracker checks
 * `localStorage.plausible_ignore === 'true'` before every event and drops it.
 * It also ignores localhost and file:// on its own, so `pnpm dev` never
 * reaches the dashboard.
 *
 * No frontmatter variable for the domain, and no define:vars — that directive
 * forces is:inline, inline scripts are not bundled, and a bare import
 * specifier would then reach the browser unresolved. The bundled script below
 * reads PUBLIC_PLAUSIBLE_DOMAIN, which Vite replaces at build time.
 */
---

{/* Parse-time and inline, ahead of the module below, because the rest of the
    site calls window.pantaTrack from its own scripts — six components plus
    sixty data-track attributes — and a bundled module resolves too late to
    catch the first clicks. This defines the API immediately and queues; the
    module swaps in the real sender and drains the queue.

    Kept as one global rather than an export: every existing caller already
    reads it off window, and importing from here would make analytics a
    build-time dependency of six unrelated components. */}
<script is:inline>
  (function () {
    window.__pantaQ = window.__pantaQ || [];
    window.pantaTrack = function (event, params) {
      window.__pantaQ.push([event, params || {}]);
    };

    // Declarative click tracking, behaviour unchanged from the GA4 build: any
    // element carrying data-track fires that event name on click, and its
    // data-track-* attributes become properties (data-track-cta -> cta).
    // Capture phase so a handler that stops propagation upstream cannot
    // silently swallow the event.
    document.addEventListener(
      'click',
      function (e) {
        var target = e.target instanceof Element ? e.target : null;
        if (!target) return;

        var el = target.closest('[data-track]');
        if (el) {
          var props = {};
          for (var key in el.dataset) {
            if (key === 'track' || key.indexOf('track') !== 0) continue;
            var prop = key
              .slice(5)
              .replace(/[A-Z]/g, function (m) { return '_' + m.toLowerCase(); })
              .replace(/^_/, '');
            props[prop] = el.dataset[key];
          }
          window.pantaTrack(el.dataset.track, props);
        }

        // ⚠ Nothing here may write to sessionStorage, localStorage or a cookie.
        //
        // An earlier draft of the funnel work stashed the last booking CTA
        // click here so /thanks/ could report which placement produced the
        // booking. It cannot: /privacy/ tells visitors in as many words that
        // this site "sets no cookies, stores nothing on your device", and that
        // it is why there is no cookie banner. A stashed attribution object is
        // storage on the device, and quietly contradicting a published privacy
        // promise costs more than the datapoint is worth.
        //
        // It is also unnecessary. Plausible stitches the session server-side:
        // put `cta_click` and `pulse_check_booked` in one funnel and the
        // placement breakdown falls out of the funnel report, with no state
        // carried across the navigation by us. See docs/FUNNEL-MEASUREMENT.md.

        // Plausible's own outboundLinks option only covers http(s) links to
        // another host, so every mailto: on the site was invisible — including
        // the footer address, which is the escape hatch for anyone who won't
        // use a form. Handled here rather than at the link, because these are
        // scattered and half of them are rendered from Sanity.
        //
        // Not exclusive with the data-track branch above: a mailto that also
        // carries data-track is both a CTA click and an email click, and
        // collapsing them would hide it from one report or the other.
        var mail = target.closest('a[href^="mailto:"]');
        if (mail) {
          window.pantaTrack('outbound_email_click', {
            // Address only — the subject/body query string on some of these
            // carries prefilled copy that would bloat the property's cardinality
            // for no analytical gain.
            address: (mail.getAttribute('href') || '').slice(7).split('?')[0],
          });
        }
      },
      true
    );
  })();
</script>

{/* Bundled by Astro, so the tracker ships with the site instead of as a
    third-party script tag. Same codebase as the hosted script per Plausible's
    README — verified: this build carries the same v36 marker and the same
    plausible_ignore check. */}
<script>
  import { init, track } from '@plausible-analytics/tracker';

  // Plausible matches on the domain registered in its own settings, which is
  // the bare host — no scheme, no www — where `site` in astro.config.mjs is a
  // full origin including www. They agree on the domain now and still must not
  // be derived from one another.
  const domain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN || 'allthingspanta.com';

  init({
    domain,
    // The three the hosted script for this site had switched on.
    outboundLinks: true,
    fileDownloads: true,
    formSubmissions: true,
  });

  // Every event carries the page it fired on and, where the page declares one,
  // the service line it belongs to. Both are required on every event by the
  // funnel measurement plan (docs/FUNNEL-MEASUREMENT.md) and both are added
  // here rather than at the call sites: there are sixty-five of those, and any
  // parameter that has to be remembered by hand is one that will be missing
  // from the events that matter most.
  //
  // Plausible records the page for *pageviews* already, but a custom event's
  // page is not queryable without this — which is precisely the breakdown the
  // plan runs on ("which placements actually drive bookings").
  //
  // Read at send time, not at module load: `service_line` comes off <html>,
  // which Base.astro sets per page.
  const enrich = (params) => {
    const props = { ...(params || {}) };
    if (props.source_page == null) props.source_page = location.pathname;
    const line = document.documentElement.dataset.serviceLine;
    if (line && props.service_line == null) props.service_line = line;
    return props;
  };

  // Plausible takes properties under `props`; callers pass a flat object,
  // exactly as GA4 wanted, so the shape is adapted here rather than at sixty
  // call sites.
  window.pantaTrack = function (event, params) {
    track(event, { props: enrich(params) });
  };

  // The queued events are enriched on drain rather than on push, so enrichment
  // lives in exactly one place. Safe because the site is an MPA: the drain
  // happens in the same page load that queued them, so location.pathname is
  // still what it was at click time.
  const queued = window.__pantaQ || [];
  window.__pantaQ = [];
  queued.forEach(([event, params]) => window.pantaTrack(event, params));
</script>
