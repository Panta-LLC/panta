---
import '@fontsource/ibm-plex-mono/400.css';
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import SectionViews from '../../components/SectionViews.astro';
import PriceStrip from '../../components/PriceStrip.astro';
import ProofStrip from '../../components/ProofStrip.astro';
import AudienceCards from '../../components/AudienceCards.astro';
import ThreeDoors from '../../components/ThreeDoors.astro';
import { getService, getServiceSlugs, getProjects, getPillars } from '../../lib/sanity.js';
import { serviceHref } from '../../lib/pillars.js';
import { serviceSchema, faqSchema } from '../../lib/schema.js';
import { PRICE_STRIP, QUOTE_PROMISE, ROUTES } from '../../lib/offer.js';

// One template for every service (PULSE-HOME-BUILD.md §8 Phase 3, rebuilt to
// journey-redesign.md §4). Sections render only when their fields are
// populated, following work/[slug].astro — so a service with three sections and
// one with eight both look deliberate.
//
// Four things are NOT conditional, because they are the template's whole point:
// the price strip, the proof, the "who this is for" cards, and the three-door
// close. Before this, a visitor could read a service page end to end and learn
// neither what it costs nor who it is for, and the only exit was the same
// review CTA printed twice.
export async function getStaticPaths() {
  const slugs = await getServiceSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const p = await getService(slug);
if (!p) {
  return Astro.redirect('/services/');
}

// featuredProjects is per-service. Falling back to the global `featured` flag
// keeps the migrated web design page rendering exactly as it did before
// anyone sets explicit references.
//
// The fallback is no longer gated on the work section's labels: the proof strip
// (§1.2, "proof travels with the service") needs a project whether or not this
// service also runs a full work section, and gating it on a label meant the
// pages with the least copy — exactly the ones needing proof most — showed none.
let projects = (p.featuredProjects ?? []).filter(Boolean);
if (!projects.length) {
  projects = ((await getProjects()) ?? []).filter((x) => x.featured).slice(0, 2);
}

const pillar = (await getPillars()).find((x) => x.id === p.pillar);
const faqs = (p.faqs ?? []).filter((f) => f?.q && f?.a);

// Defaults live here, not in Sanity, so every page closes properly even if an
// editor empties the fields. The closing section is the three doors now, and
// these strings are its heading and lede — the old single-CTA block (title,
// body, label, note) is gone, along with the second copy of it that used to sit
// in the hero. Buttons describe, copy brands: the door labels come from
// lib/offer.js and no button carries the offer's name (§7.1).
const CLOSE = {
  title: p.ctaTitle ?? 'Not sure this is what you need?',
  body:
    p.ctaBody ??
    'Take whichever door fits. If you are not sure, the review is free and we will tell you honestly — including if the answer is something else, or nothing at all.',
};

// §4's price strip. One band across all five services (lib/offer.js explains
// why it is one band and not five ranges); `priceStrip` in the Studio overrides
// it per service the day per-service numbers exist.
const priceStrip = p.priceStrip ?? PRICE_STRIP;

// The "who this is for" cards. Sanity-driven, and absent rather than invented
// when a service has not had them written — AudienceCards renders nothing on an
// empty array, and the gap below makes that visible instead of silent.
const audience = (p.audience ?? []).filter((a) => a?.title && a?.body);

const schema = [
  serviceSchema({
    name: p.title,
    serviceType: p.serviceType ?? p.title,
    description: p.seoDescription ?? p.summary,
    url: new URL(`/services/${p.slug}/`, Astro.site).toString(),
  }),
  faqSchema(faqs),
].filter(Boolean);

/** A section promised by the page but not yet written blocks the build. */
const gap = (cond, note) => (p.pageReady && cond ? note : null);
const gaps = [
  gap(!(p.includes ?? []).length, `what "${p.title}" includes — 3 or more cards`),
  gap(!p.heroLede, `hero lede for "${p.title}"`),
  // Both new, and both real launch blockers rather than nice-to-haves: §1.2 and
  // §4 make proof and audience part of the template, and a template section
  // that silently vanishes when unfilled is how the pages ended up without them
  // in the first place.
  gap(!audience.length, `"who this is for" cards for "${p.title}" — 2 or 3 personas`),
  gap(!projects.length, `a case study to reference from "${p.title}" (Studio → Featured projects)`),
  ...(p.contentGaps ?? []),
].filter(Boolean);
---
<Base
  title={p.seoTitle ?? `${p.title} — Panta`}
  description={p.seoDescription ?? p.summary}
  schema={schema}
  noindex={!p.pageReady}
  serviceLine={slug}
>
  <!-- ===================== hero ===================== -->
  <section class="section section--dark hero svc-hero" data-section="hero">
    <div class="container">
      <p class="kicker svc-hero__crumb">
        <a class="crumb" href="/services/">Services</a>
        {pillar && <> / <span class="svc-hero__pillar">{pillar.kicker}</span> <span class="gloss">· {pillar.head.replace('.', '').toLowerCase()}</span></>}
      </p>
      <h1 class="svc-hero__title">{p.heroTitle ?? p.title}</h1>
      <p class="lede">{p.heroLede ?? p.summary}</p>
      {/* Two doors in the hero, not one. §1.1: the ready buyer arriving on a
          service page had exactly one control, and it committed them to a call
          they were on this page specifically to avoid. The review stays the
          recommendation (filled); the quote is the alternative (ghost).

          `heroSecondaryLabel` — a per-service ghost button, usually pointing at
          the work — no longer renders here. It was optional, and where it was
          set it took the slot the quote door needs; the work is one section
          below this in the proof strip either way. */}
      <div class="btn-row">
        <a
          href={ROUTES.review}
          class="btn btn--primary"
          data-track="cta_click"
          data-track-cta="pulse_check"
          data-track-location={`service_${p.slug}_hero`}
        >Get a free review</a>
        <a
          href={`${ROUTES.quote}?need=${p.slug}`}
          class="btn btn--ghost"
          data-track="cta_click"
          data-track-cta="quote_request"
          data-track-location={`service_${p.slug}_hero`}
        >Request a quote</a>
      </div>
      {/* The number, at the top, where the "can we even afford this" question
          is actually forming — §1.3. */}
      <PriceStrip tone="dark" text={priceStrip} />
      <p class="svc-hero__quote-note">
        Already know what you need built? {QUOTE_PROMISE}
      </p>
    </div>
  </section>

  {gaps.length > 0 && (
    <section class="section">
      <div class="container">
        {gaps.map((g) => <Placeholder note={g}>[{g} — not written yet]</Placeholder>)}
      </div>
    </section>
  )}

  <!-- ===================== proof strip ===================== -->
  <!-- Was a hairline row of client NAMES under the hero — a list of words with
       no evidence attached, which is the weakest form proof can take. It is now
       the case study itself plus the client's own sentence about it, on the page
       where this service is decided (§1.2). ProofStrip renders nothing when
       there is no project, and the gap above blocks the build in that state. -->
  <ProofStrip
    label={p.proofLabel ?? 'Proof'}
    projects={projects}
    location={`service_${p.slug}`}
  />

  <!-- ===================== who this is for ===================== -->
  <AudienceCards
    label={p.audienceLabel ?? 'Who this is for'}
    heading={p.audienceTitle}
    cards={audience}
  />

  <!-- ===================== selected work ===================== -->
  {projects.length > 0 && (p.workLabel || p.workTitle) && (
    <section class="section" data-section="work">
      <div class="container">
        {p.workLabel && <p class="label">{p.workLabel}</p>}
        {p.workTitle && <h2>{p.workTitle}</h2>}
        <div class="grid grid--3" style="margin-top: 2.5rem;">
          {projects.map((x) => (
            <a class="card work-card" href={`/work/${x.slug}/`}>
              <h3>{x.name}</h3>
              <p>{x.summary}</p>
              <span class="work-more">Read the story <span aria-hidden="true">→</span></span>
            </a>
          ))}
          {p.moreCardTitle && (
            <a class="card card--more" href="/work/">
              <h3>{p.moreCardTitle}</h3>
              <p>{p.moreCardBody}</p>
              <span class="work-more">{p.moreCardLinkLabel} <span aria-hidden="true">→</span></span>
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- ===================== what this includes ===================== -->
  {(p.includes ?? []).length > 0 && (
    <section class="section section--dark" data-section="includes">
      <div class="container">
        {p.includesLabel && <p class="label">{p.includesLabel}</p>}
        {p.includesTitle && <h2>{p.includesTitle}</h2>}
        <div class="grid grid--3" style="margin-top: 2.5rem;">
          {p.includes.map((c) => (
            <div class="card card--onDark">
              <span class="label" style="margin-bottom: 0.5rem;">{c.kicker}</span>
              <h3 style="margin-bottom: 1rem;">{c.title}</h3>
              <p style="color: var(--sage);">{c.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===================== pivot band ===================== -->
  {p.pivotTitle && (
    <section class="section section--bamboo" id={p.pivotAnchor} data-section="pivot">
      <div class="container">
        {p.pivotLabel && <p class="label" style="color: var(--cream);">{p.pivotLabel}</p>}
        <h2 style="color: var(--cream);">{p.pivotTitle}</h2>
        {p.pivotLede && <p class="lede" style="color: var(--cream); max-width: 54ch;">{p.pivotLede}</p>}
        {(p.pivotChecklist ?? []).length > 0 && (
          <div class="card" style="background: var(--cream); border-color: transparent; color: var(--charcoal); margin-top: 2rem; max-width: 44rem;">
            {p.pivotIntro && <p>{p.pivotIntro}</p>}
            <ul class="checklist" style="margin-block: 1.25rem;">
              {p.pivotChecklist.map((c) => (
                <li><strong>{c.title}</strong>{c.body ? ` — ${c.body}` : ''}</li>
              ))}
            </ul>
            {p.pivotCtaLabel && (
              <a
                class="btn btn--primary"
                href={p.pivotCtaHref ?? '/services/'}
                data-track="cta_click"
                data-track-cta="pivot"
                data-track-location={`service_${p.slug}_pivot`}
              >{p.pivotCtaLabel}</a>
            )}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ===================== process pointer ===================== -->
  {p.processTitle && (
    <section class="section" data-section="process">
      <div class="container">
        {p.processLabel && <p class="label">{p.processLabel}</p>}
        <h2>{p.processTitle}</h2>
        {p.processBody && (
          <p class="lede" style="max-width: 56ch;">
            {p.processBody}
            {/* Defaults to /process/, not /services/. The old default was the
                reason two "see how it works" links on this site landed on a list
                of what we sell (§3) — a service list is not an answer to how a
                project runs, and now there is a page that is. */}
            {p.processLinkLabel && (
              <> <a href={p.processLinkHref ?? ROUTES.process}>{p.processLinkLabel} →</a></>
            )}
          </p>
        )}
      </div>
    </section>
  )}

  <!-- ===================== related services ===================== -->
  {(p.relatedServices ?? []).filter(Boolean).length > 0 && (
    <section class="section" style="padding-top: 0;" data-section="related">
      <div class="container">
        <p class="kicker">Often paired with</p>
        <ul class="related">
          {p.relatedServices.filter(Boolean).map((r) => (
            <li>
              <a href={serviceHref(r)}>
                <span class="related__name">{r.title}</span>
                <span class="related__body">{r.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ===================== FAQ ===================== -->
  {faqs.length > 0 && (
    <section class="section" style="padding-top: 0;" data-section="faq">
      <div class="container" style="max-width: 46rem;">
        {p.faqLabel && <p class="label">{p.faqLabel}</p>}
        {p.faqTitle && <h2>{p.faqTitle}</h2>}
        <div style="margin-top: 1.5rem;">
          {faqs.map((f) => (
            <details class="faq">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ================= closing: three doors (always) ================= -->
  <!-- Replaces the single review CTA that closed every service page — the
       second copy of the ask already made in the hero. All three exits now,
       with the review still recommended: §1.1. `need` carries this service
       through to the quote form's dropdown. -->
  <ThreeDoors
    location={`service_${p.slug}_doors`}
    heading={CLOSE.title}
    body={CLOSE.body}
    need={p.slug}
  />
</Base>

<style>
  .svc-hero { padding-block: clamp(3.5rem, 8vw, 6rem); }

  .svc-hero__crumb { margin-bottom: 1rem; }
  .crumb { color: inherit; text-decoration: none; }
  .crumb:hover { text-decoration: underline; }
  /* Pillar in green — one of the permitted uses. */
  .svc-hero__pillar { color: var(--sage); }

  .svc-hero__title {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  /* The quote door's promise, directly under the two buttons — the ready buyer
     should not have to find it in the FAQ (§4, Web Design specifics). */
  .svc-hero__quote-note {
    margin: 0.75rem 0 0;
    font-size: 0.88rem;
    color: var(--sage);
  }

  /* --- work cards --- */
  .work-card, .card--more {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .work-card:hover, .card--more:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 40px -28px rgba(0, 0, 0, 0.45);
  }

  .work-more {
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--bamboo-deep);
  }

  .card--onDark {
    background: transparent;
    border-color: rgba(245, 241, 231, 0.28);
    color: var(--cream);
  }

  .card--onDark h3 { color: var(--cream); }
  .card--onDark p { color: var(--sage); }

  /* --- related services --- */
  .related {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    border-top: 1px solid var(--line);
    max-width: 46rem;
  }

  .related li { border-bottom: 1px solid var(--line); }

  .related a {
    display: grid;
    gap: 0.25rem;
    padding: 0.9rem 0;
    text-decoration: none;
  }

  .related__name { font-weight: 500; color: var(--charcoal); }
  .related a:hover .related__name { color: var(--bamboo-deep); }
  .related__body { font-size: 0.9rem; color: var(--stone-deep); }

  /* --- FAQ --- */
  .faq {
    border-bottom: 1px solid var(--line);
    padding-block: 0.9rem;
  }

  .faq summary {
    cursor: pointer;
    font-weight: 500;
    list-style: none;
  }

  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: ' +'; color: var(--bamboo-deep); }
  .faq[open] summary::after { content: ' –'; }
  .faq p { margin: 0.6rem 0 0; color: var(--stone-deep); }

  @media (prefers-reduced-motion: reduce) {
    .work-card, .card--more { transition: none; }
  }
</style>

<SectionViews />
