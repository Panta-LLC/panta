---
/**
 * Celebration of life — Willie Lee Grider (1933–2026).
 *
 * A standalone page, deliberately outside Base.astro: it carries none of the
 * site's chrome, palette, type or analytics. A memorial that opened inside the
 * consulting site's header and "Book a Pulse Check" footer would be doing two
 * jobs at once, and the second one badly.
 *
 * It is noindex and excluded from the sitemap (see astro.config.mjs) because it
 * is shared by link with a family, not published as surface for this business.
 * Nothing on the site links here.
 *
 * The twelve program pages are rendered server-side rather than built by a
 * script as in the original: the whole program is then in the HTML, readable
 * with JS off, and the first page starts loading from the markup instead of
 * after a module runs. The PDF is an ordinary <a download> — the original's
 * button existed only because the artifact runtime has no file downloads.
 *
 * ── The pager, and why it is built the way it is ──────────────────────────────
 * The program is read one page at a time, the way the printed one is held. That
 * is layered on top of the twelve figures rather than replacing them:
 *
 *   - Without JS the markup is unchanged — twelve pages, top to bottom, and no
 *     controls (they are shown by a `.js` rule, so nothing dead is ever drawn).
 *   - An inline script in <head> sets `.js` BEFORE first paint, and page one is
 *     server-rendered already carrying `.is-current`. Without that ordering the
 *     browser would paint all twelve and then collapse them to one — a visible
 *     lurch on exactly the element people came for.
 *   - Setup runs in a try/catch that strips `.js` again if anything throws, so a
 *     failure lands back on the plain scrolling program rather than on one page
 *     with buttons that do nothing.
 *
 * Neighbouring pages are warmed (their `loading` flipped to eager) as you move,
 * so the next page is usually decoded before it is asked for; loading all twelve
 * up front would be ~2.5 MB for a program most people read a few pages of.
 *
 * Assets live in public/memorial/willie-lee-grider/ and are served unprocessed;
 * they are already sized for display (1100×1424) and re-encoding a scanned
 * program buys nothing.
 */
const PAGE_COUNT = 12;
const pages = Array.from({ length: PAGE_COUNT }, (_, i) => String(i + 1).padStart(2, '0'));
const PDF = '/memorial/willie-lee-grider/Willie-Lee-Grider-Program.pdf';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>Willie Lee Grider — Celebration of Life</title>
    <meta
      name="description"
      content="Celebrating the life of Willie Lee Grider, November 5, 1933 – September 11, 2026. Service details and the full program."
    />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0c0d0c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Willie Lee Grider — Celebration of Life" />
    <meta
      property="og:description"
      content="November 5, 1933 – September 11, 2026. Service details and the full program."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;1,400;1,500&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap"
    />
    <!--
      Set before first paint so page one is the only one ever drawn. Deferring
      this to the setup script at the end of the body would paint all twelve
      pages and then collapse them — see the note in the frontmatter.
    -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <style>
      :root {
        color-scheme: dark;
        --ground: #0c0d0c;
        --panel: #161816;
        --lily: #f3f0e8;
        --muted: #a9ab9f;
        --gold: #c9b27a;
        --sage: #8fa68f;
        --rule: #2c302b;
      }
      *,
      *::before,
      *::after { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--ground);
        color: var(--lily);
        font: 400 1.0625rem/1.6 'EB Garamond', Georgia, 'Times New Roman', serif;
        padding-inline: 16px;
      }
      img { max-width: 100%; }
      .wrap {
        max-width: 760px;
        margin: 0 auto;
        padding-block: 48px 64px;
        display: flex;
        flex-direction: column;
        gap: 40px;
      }
      header {
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 6px;
        border: 1px solid var(--rule);
        padding: 40px 20px 34px;
      }
      .eyebrow {
        font: italic 400 clamp(1.3rem, 4vw, 1.7rem) / 1.2 'Cormorant Garamond', Georgia, serif;
        color: var(--gold);
      }
      h1 {
        margin: 0;
        font: italic 500 clamp(2.6rem, 10vw, 4.4rem) / 1.05 'Cormorant Garamond', Georgia, serif;
        text-wrap: balance;
      }
      .dates {
        font: italic 400 1.25rem/1.4 'Cormorant Garamond', Georgia, serif;
        color: var(--muted);
        margin-top: 6px;
      }
      .verse {
        font-style: italic;
        color: var(--muted);
        font-size: 0.98rem;
        max-width: 34em;
        margin: 18px auto 0;
      }
      .verse cite {
        display: block;
        font-style: normal;
        font-size: 0.8rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--sage);
        margin-top: 4px;
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: center;
        margin-top: 24px;
      }
      .btn {
        appearance: none;
        border: 1px solid var(--gold);
        background: var(--gold);
        color: #16140e;
        font: 500 1rem/1 'EB Garamond', Georgia, serif;
        letter-spacing: 0.04em;
        padding: 14px 22px;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
      }
      .btn.ghost { background: transparent; color: var(--gold); }
      .btn:focus-visible { outline: 2px solid var(--lily); outline-offset: 3px; }
      .btn:hover { filter: brightness(1.08); }
      .details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1px;
        background: var(--rule);
        border: 1px solid var(--rule);
      }
      .details section {
        background: var(--panel);
        padding: 20px 22px;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .details h2 {
        margin: 0 0 6px;
        font: italic 500 1.35rem/1.2 'Cormorant Garamond', Georgia, serif;
        color: var(--gold);
      }
      .details p { margin: 0; color: var(--lily); }
      .details a { color: var(--sage); font-size: 0.9rem; margin-top: 8px; text-underline-offset: 3px; }
      .program { display: flex; flex-direction: column; gap: 18px; }
      .program-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px;
        border-bottom: 1px solid var(--rule);
        padding-bottom: 10px;
      }
      .program-head h2 {
        margin: 0;
        font: italic 500 1.6rem/1.2 'Cormorant Garamond', Georgia, serif;
      }
      .program-head span {
        font-size: 0.8rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .pages { display: flex; flex-direction: column; gap: 18px; }
      figure { margin: 0; display: flex; flex-direction: column; gap: 6px; }
      figure img {
        display: block;
        width: 100%;
        height: auto;
        max-width: 100%;
        background: #1b1d1b;
        box-shadow: 0 2px 24px rgba(0, 0, 0, 0.5);
      }
      figcaption {
        font-size: 0.78rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
        text-align: right;
        font-variant-numeric: tabular-nums;
      }

      /* One page at a time, once the pager is running. */
      .js .pages > figure { display: none; }
      .js .pages > figure.is-current { display: flex; }
      /*
       * Capping the WIDTH is what keeps a whole page in view, not `max-height`.
       * A width of 100% gives the image a definite size before it loads, so the
       * width/height attributes can reserve its box; `width: auto` with a height
       * cap collapses an unloaded image to nothing and the pager jumps down the
       * screen as each page arrives. 54vh is the width at which the page's own
       * 1100×1424 proportion lands at about 70vh tall — the image and the pager
       * under it then fit together on a laptop screen.
       */
      .js .pages > figure img {
        width: 100%;
        max-width: 54vh;
        height: auto;
        margin-inline: auto;
      }
      /* The pager states the page number; the caption would say it twice. */
      .js .pages figcaption { display: none; }

      /* Drawn only when the script that drives it is running. */
      .pager { display: none; }
      .js .pager {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        border-top: 1px solid var(--rule);
        padding-top: 16px;
      }
      .pager-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        width: 100%;
      }
      .pager-btn {
        appearance: none;
        background: transparent;
        border: 1px solid var(--rule);
        color: var(--gold);
        font: 500 0.95rem/1 'EB Garamond', Georgia, serif;
        letter-spacing: 0.04em;
        padding: 11px 18px;
        cursor: pointer;
      }
      .pager-btn:hover:not(:disabled) { border-color: var(--gold); }
      .pager-btn:disabled { color: var(--rule); cursor: default; }
      .pager-status {
        font-size: 0.78rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
        font-variant-numeric: tabular-nums;
        min-width: 9em;
        text-align: center;
      }
      .pager-jump {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 6px;
      }
      .pager-jump button {
        appearance: none;
        background: transparent;
        border: 1px solid transparent;
        color: var(--muted);
        font: 400 0.9rem/1 'EB Garamond', Georgia, serif;
        font-variant-numeric: tabular-nums;
        min-width: 2.1em;
        padding: 7px 4px;
        cursor: pointer;
      }
      .pager-jump button:hover { color: var(--lily); }
      .pager-jump button[aria-current='true'] {
        color: var(--gold);
        border-color: var(--rule);
      }
      .pager-btn:focus-visible,
      .pager-jump button:focus-visible {
        outline: 2px solid var(--lily);
        outline-offset: 2px;
      }
      .pager-hint { font-size: 0.85rem; color: var(--muted); font-style: italic; }
      footer { text-align: center; color: var(--muted); font-style: italic; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header>
        <div class="eyebrow">celebrating the life of</div>
        <h1>Willie Lee Grider</h1>
        <div class="dates">November 5, 1933 ~ September 11, 2026</div>
        <p class="verse">
          “But they that wait upon the Lord shall renew their strength; they shall mount up with
          wings as eagles; they shall run, and not be weary; and they shall walk, and not faint.”
          <cite>Isaiah 40:31</cite>
        </p>
        <div class="actions">
          <a class="btn" href={PDF} download>Download the program (PDF)</a>
          <a class="btn ghost" href="#program">View it below</a>
        </div>
      </header>

      <div class="details">
        <section>
          <h2>Celebration of Life</h2>
          <p>Saturday, September 26, 2026</p>
          <p>Southside Church of Christ</p>
          <p>1501 Florida Avenue</p>
          <a
            href="https://www.google.com/maps/search/?api=1&query=Southside+Church+of+Christ+1501+Florida+Ave+Richmond+CA"
            target="_blank"
            rel="noopener">Directions</a
          >
        </section>
        <section>
          <h2>Interment</h2>
          <p>Rolling Hills Memorial Park</p>
          <p>4100 Hilltop Dr</p>
          <a
            href="https://www.google.com/maps/search/?api=1&query=Rolling+Hills+Memorial+Park+4100+Hilltop+Dr+Richmond+CA"
            target="_blank"
            rel="noopener">Directions</a
          >
        </section>
        <section>
          <h2>Repast</h2>
          <p>Moose Lodge</p>
          <p>4660 Appian Way</p>
          <p>El Sobrante, CA 94803</p>
          <a
            href="https://www.google.com/maps/search/?api=1&query=Moose+Lodge+4660+Appian+Way+El+Sobrante+CA+94803"
            target="_blank"
            rel="noopener">Directions</a
          >
        </section>
      </div>

      <section class="program" id="program" aria-labelledby="program-title">
        <div class="program-head">
          <h2 id="program-title">The Program</h2><span>{PAGE_COUNT} pages</span>
        </div>

        <div class="pages" data-pages>
          {
            pages.map((n, i) => (
              <figure class={i === 0 ? 'is-current' : undefined}>
                <img
                  src={`/memorial/willie-lee-grider/pages/p-${n}.jpg`}
                  alt={`Program page ${i + 1} of ${PAGE_COUNT}`}
                  width="1100"
                  height="1424"
                  loading={i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                <figcaption>
                  Page {i + 1} of {PAGE_COUNT}
                </figcaption>
              </figure>
            ))
          }
        </div>

        <nav class="pager" data-pager aria-label="Program pages">
          <div class="pager-row">
            <button type="button" class="pager-btn" data-prev>‹ Previous</button>
            <span class="pager-status" data-status aria-live="polite">
              Page 1 of {PAGE_COUNT}
            </span>
            <button type="button" class="pager-btn" data-next>Next ›</button>
          </div>
          <div class="pager-jump" data-jump>
            {
              pages.map((_, i) => (
                <button
                  type="button"
                  data-go={i}
                  aria-label={`Go to page ${i + 1}`}
                  aria-current={i === 0 ? 'true' : 'false'}
                >
                  {i + 1}
                </button>
              ))
            }
          </div>
          <p class="pager-hint">Use the arrow keys, or swipe, to turn the page.</p>
        </nav>
      </section>

      <footer>
        “Well done, good and faithful servant… Enter into the joy of your Lord.” ~ Matthew 25:23
      </footer>
    </div>

    <script is:inline>
      /*
       * Turns the twelve stacked pages into one page at a time.
       *
       * Inline and unbundled on purpose: the `.js` class is already set in the
       * head, so from that moment the page is committed to showing one figure.
       * A module script would be deferred until after the document parses,
       * leaving a window in which the program is a single page with no way to
       * leave it. This runs the instant the markup above it exists.
       *
       * If anything here throws, `.js` comes off and the page is the plain
       * scrolling program again — the failure mode is "less clever", not
       * "unreadable".
       */
      (function () {
        try {
          var figures = Array.prototype.slice.call(
            document.querySelectorAll('[data-pages] > figure'),
          );
          var jumps = Array.prototype.slice.call(
            document.querySelectorAll('[data-jump] button'),
          );
          var prev = document.querySelector('[data-prev]');
          var next = document.querySelector('[data-next]');
          var status = document.querySelector('[data-status]');
          var pages = document.querySelector('[data-pages]');
          if (!figures.length || !prev || !next || !status || !pages) throw new Error('no pager');

          var last = figures.length - 1;
          var at = 0;

          /* The page either side is the one most likely to be asked for next,
             and a lazy image inside a display:none figure never starts. */
          function warm(i) {
            [i - 1, i, i + 1].forEach(function (n) {
              var img = figures[n] && figures[n].querySelector('img');
              if (img) img.loading = 'eager';
            });
          }

          function show(i, moveFocus) {
            at = Math.max(0, Math.min(last, i));
            figures.forEach(function (fig, n) {
              fig.classList.toggle('is-current', n === at);
            });
            jumps.forEach(function (btn, n) {
              btn.setAttribute('aria-current', n === at ? 'true' : 'false');
            });
            prev.disabled = at === 0;
            next.disabled = at === last;
            status.textContent = 'Page ' + (at + 1) + ' of ' + figures.length;
            warm(at);

            /* A disabled button drops focus to the body, which would strand a
               keyboard user at the end of the program. Hand it to the control
               that still works. */
            if (moveFocus && document.activeElement && document.activeElement.disabled) {
              (at === 0 ? next : prev).focus();
            }
            /* Only claw the view back when the page has been scrolled off. */
            if (pages.getBoundingClientRect().top < 0) {
              pages.scrollIntoView({ block: 'start' });
            }
          }

          prev.addEventListener('click', function () {
            show(at - 1, true);
          });
          next.addEventListener('click', function () {
            show(at + 1, true);
          });
          jumps.forEach(function (btn) {
            btn.addEventListener('click', function () {
              show(Number(btn.getAttribute('data-go')), false);
            });
          });

          document.addEventListener('keydown', function (e) {
            if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
            /* A held arrow key auto-repeats several times a second, which flings
               the reader to the last page. One press, one page. */
            if (e.repeat) return;
            var tag = (e.target.tagName || '').toLowerCase();
            if (tag === 'input' || tag === 'textarea' || e.target.isContentEditable) return;
            if (e.key === 'ArrowRight') {
              show(at + 1, false);
              e.preventDefault();
            } else if (e.key === 'ArrowLeft') {
              show(at - 1, false);
              e.preventDefault();
            }
          });

          /* Swipe, but only a deliberate horizontal one — the page still has to
             scroll normally under a finger dragged up or down. */
          var x0 = null;
          var y0 = null;
          pages.addEventListener(
            'touchstart',
            function (e) {
              if (e.touches.length !== 1) return;
              x0 = e.touches[0].clientX;
              y0 = e.touches[0].clientY;
            },
            { passive: true },
          );
          pages.addEventListener(
            'touchend',
            function (e) {
              if (x0 === null || !e.changedTouches.length) return;
              var dx = e.changedTouches[0].clientX - x0;
              var dy = e.changedTouches[0].clientY - y0;
              x0 = null;
              y0 = null;
              if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.5) {
                show(dx < 0 ? at + 1 : at - 1, false);
              }
            },
            { passive: true },
          );

          show(0, false);
        } catch (err) {
          document.documentElement.classList.remove('js');
        }
      })();
    </script>
  </body>
</html>
