---
import Base from '../../layouts/Base.astro';
import ReadDepth from '../../components/ReadDepth.astro';
import { getCaseStudies } from '../../lib/sanity.js';
import { serviceHref } from '../../lib/pillars.js';
import { ROUTES } from '../../lib/offer.js';

export async function getStaticPaths() {
  const { getCaseStudies } = await import('../../lib/sanity.js');
  const studies = await getCaseStudies();
  return studies.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: `${p.name} — case study`,
    about: p.name,
    creator: { '@type': 'ProfessionalService', name: 'Panta LLC', url: 'https://www.allthingspanta.com' },
    description: p.summary,
    ...(p.url ? { subjectOf: { '@type': 'WebSite', url: p.url } } : {}),
  },
];
---
<Base
  title={`${p.name} — case study — Panta`}
  description={p.summary}
  schema={schema}
>
  <section class="section section--dark" style="padding-block: clamp(3rem, 7vw, 4.5rem);">
    <div class="container">
      <p class="label">
        <a href="/work/" class="crumb">Client work</a>
        {p.year && <span class="crumb-sep">·</span>}{p.year}
      </p>
      <h1 style="font-size: clamp(2rem, 4.2vw, 3.1rem);">{p.name}</h1>
      {p.summary && <p class="lede">{p.summary}</p>}
      <div class="btn-row">
        {p.url && (
          <a href={p.url} class="btn btn--primary" target="_blank" rel="noopener noreferrer">Visit the live site ↗</a>
        )}
        {p.articleUrl && p.articleLabel && (
          <a href={p.articleUrl} class="btn btn--ghost" target="_blank" rel="noopener noreferrer">{p.articleLabel} ↗</a>
        )}
      </div>
      {(p.contributions ?? []).length > 0 && (
        <ul class="tagrow">
          {p.contributions.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </div>
  </section>

  {p.hero && (
    <div class="shot-wrap">
      <div class="container">
        <img class="shot" src={p.hero} alt={p.heroAlt} width="1200" height="750" loading="eager" />
      </div>
    </div>
  )}

  {p.challengeBody && (
    <section class="section">
      <div class="container narrow">
        <p class="label">{p.challengeLabel}</p>
        <h2>{p.challengeTitle}</h2>
        <p>{p.challengeBody}</p>
      </div>
    </section>
  )}

  {(p.approachItems ?? []).length > 0 && (
    <section class="section" style="padding-top: 0;">
      <div class="container">
        <p class="label">{p.approachLabel}</p>
        <h2>{p.approachTitle}</h2>
        <div class="grid grid--2" style="margin-top: 2.5rem; gap: 1.25rem;">
          {p.approachItems.map((item) => (
            <div class="card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {p.outcomeBody && (
    <section class="section section--dark">
      <div class="container narrow">
        <p class="label">{p.outcomeLabel}</p>
        <h2>{p.outcomeTitle}</h2>
        <p class="lede">{p.outcomeBody}</p>
        {p.url && (
          <div class="btn-row" style="margin-top: 1.5rem;">
            <a href={p.url} class="btn btn--primary" target="_blank" rel="noopener noreferrer">See it live ↗</a>
          </div>
        )}
      </div>
    </section>
  )}

  {p.quote && (
    <section class="section">
      <div class="container">
        <div class="quote-card">
          <blockquote>{p.quote}</blockquote>
          <p class="quote-by"><strong>{p.quoteAuthor}</strong> — {p.quoteRole}</p>
        </div>
      </div>
    </section>
  )}

  {/* Before the closing CTA, not after: the CTA block is the thing a read is
      supposed to lead to, so counting it as part of the story would mean
      nobody reads a case study without also converting past it. */}
  <ReadDepth event="case_study_read" props={{ study: p.slug }} />

  {/* The services this case demonstrates (journey-redesign.md §5.6: "each case
      study page should end with a link to the SERVICE it demonstrates, not only
      to the review"). A visitor who has just read a whole case study is more
      interested than almost anyone else on the site, and the only exit was a
      calendar. Renders nothing when the project has no services set. */}
  {(p.services ?? []).filter(Boolean).length > 0 && (
    <section class="section" style="padding-top: 0;">
      <div class="container narrow">
        <p class="label">What this project was</p>
        <ul class="svc-out">
          {p.services.filter(Boolean).map((svc) => (
            <li>
              <a
                href={serviceHref(svc)}
                data-track="cta_click"
                data-track-cta={`service_${svc.slug}`}
                data-track-location="case_study_services"
              >
                <span class="svc-out__name">{svc.title}</span>
                <span class="svc-out__body">{svc.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section section--bamboo">
    <div class="container">
      <h2>Want this kind of clarity for your organization?</h2>
      <p class="lede" style="max-width: 54ch;">
        Every project starts the same way: a free 30-minute conversation and an
        honest read on where you stand. If you already know what you need built,
        skip the call and send the brief instead.
      </p>
      <div class="btn-row" style="margin-top: 1.5rem;">
        <a
          href={ROUTES.review}
          class="btn btn--primary"
          data-track="cta_click"
          data-track-cta="pulse_check"
          data-track-location="case_study_cta"
        >Get a free review</a>
        {/* The second door. It replaced "See more client work" — a link back to
            the index the visitor came from, offered to the one person on the
            site who has read a case study end to end. */}
        <a
          href={ROUTES.quote}
          class="btn btn--ghost"
          data-track="cta_click"
          data-track-cta="quote_request"
          data-track-location="case_study_cta"
        >Request a quote</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .crumb { color: var(--sage); text-decoration: none; }
  .crumb:hover { color: var(--cream); }
  .crumb-sep { margin-inline: 0.4rem; opacity: 0.6; }

  .narrow { max-width: 46rem; }

  /* --- the services this case demonstrates --- */
  .svc-out {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    border-top: 1px solid var(--line);
  }

  .svc-out li { border-bottom: 1px solid var(--line); }

  .svc-out a {
    display: grid;
    gap: 0.2rem;
    padding: 0.9rem 0;
    text-decoration: none;
  }

  .svc-out__name { font-weight: 500; color: var(--charcoal); }
  .svc-out a:hover .svc-out__name { color: var(--bamboo-deep); }
  .svc-out__body { font-size: 0.9rem; color: var(--stone-deep); }

  .tagrow {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.75rem 0 0;
    padding: 0;
  }

  .tagrow li {
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(245, 241, 231, 0.28);
    color: var(--sage);
  }

  .shot-wrap {
    background: var(--cream-soft);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }

  .shot {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid var(--line);
    box-shadow: 0 28px 56px -32px rgba(0, 0, 0, 0.4);
  }

  .quote-card {
    background: var(--cream-soft);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 4vw, 2.75rem);
    position: relative;
    overflow: hidden;
  }

  .quote-card::before {
    content: '\201C';
    font-family: var(--font-serif);
    position: absolute;
    top: -2.5rem;
    left: 1.25rem;
    font-size: 11rem;
    color: var(--line);
    line-height: 1;
  }

  .quote-card blockquote {
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    font-weight: 300;
    line-height: 1.3;
    max-width: 30ch;
    margin: 0;
    position: relative;
  }

  .quote-by {
    margin: 1.25rem 0 0;
    font-size: 0.9rem;
    color: var(--stone-deep);
  }

  .quote-by strong { color: var(--charcoal); }
</style>
