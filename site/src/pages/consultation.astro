---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import SectionViews from '../components/SectionViews.astro';
import { getDoc, getProjects } from '../lib/sanity.js';
import { bookingEmbedUrl } from '../lib/booking.js';

const c = await getDoc('consultationPage');
const settings = await getDoc('siteSettings');
const projects = await getProjects();

// The Koalendar booking page, managed in Sanity → Site Settings. The embed URL
// is derived from it (see lib/booking.js) rather than stored separately —
// `calEmbedUrl` is the retired Google Calendar field and is no longer read.
const SCHEDULE_URL = settings.scheduleUrl;
const CAL_EMBED_URL = bookingEmbedUrl(SCHEDULE_URL);

// "Audit", "scorecard" and "graded" belong to the paid Digital Presence Plan.
// This page sells the free call, so it says "consultation" throughout —
// otherwise prospects think the free call already delivered the paid plan.
const description =
  'The Pulse Check: a free 30-minute review for organizations at any stage. Walk away with an honest read on where you stand and a one-page written readout within 48 hours.';

const consultSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Free 30-Minute Consultation',
    serviceType: 'Digital presence review',
    description,
    provider: { '@type': 'ProfessionalService', name: 'Panta LLC', url: 'https://www.allthingspanta.com' },
    areaServed: 'Worldwide',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
  },
];
---
<Base
  title="Free 30-Minute Consultation — Panta"
  description={description}
  schema={consultSchema}
>
  <!-- HERO -->
  <section class="section section--dark" style="padding-block: clamp(3.5rem, 8vw, 6rem);">
    <div class="container hero-grid">
      <div>
        <p class="label">{c.heroLabel}</p>
        <h1 style="font-size: clamp(2.2rem, 4.5vw, 3.4rem);">{c.heroTitle}</h1>
        <p class="lede">{c.heroLede}</p>
        <div class="btn-row">
          <a
            class="btn btn--primary"
            href="#book"
            data-track="cta_click"
            data-track-cta="scroll_to_booking"
            data-track-location="consultation_hero"
          >{c.bookCtaLabel}</a>
          <span class="small"><strong>{c.bookNote}</strong></span>
        </div>
      </div>

      <!-- diagnostic panel: the whole picture we map together -->
      <div class="panel" aria-label="What the consultation maps">
        <div class="panel-head">
          <span class="panel-label">{c.panelLabel}</span>
          <span class="panel-url">your web presence</span>
        </div>
        <p class="panel-sub">{c.panelSub}</p>
        <div class="pmap">
          {c.panelNodes.map((node, i) => (
            <div class="pnode">
              <span class="ico">{i + 1}</span>
              <div class="pmeta">
                <div class="pt">{node.title}</div>
                <div class="ps">{node.body}</div>
              </div>
              <span class="pill">{node.kicker}</span>
            </div>
          ))}
        </div>
        <div class="panel-foot">
          <span class="panel-tag">{c.panelFootTag}</span>
          <span class="panel-txt">{c.panelFootText}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PROOF -->
  <div class="proof">
    <div class="container proof-inner">
      <span class="proof-q">{c.proofLabel}</span>
      {projects.map((p) => <span class="client">{p.name}</span>)}
    </div>
  </div>

  <!-- WHAT YOU GET -->
  <section class="section">
    <div class="container">
      <p class="label">{c.deliverLabel}</p>
      <h2>{c.deliverTitle}</h2>
      <p>{c.deliverIntro}</p>
      <div class="grid grid--3" style="margin-top: 2.5rem;">
        {c.deliverCards.map((card) => (
          <div class="card">
            <p class="card-num">{card.kicker}</p>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- THE READOUT, SHOWN -->
  <!-- The section above promises "a one-page written readout within 48 hours."
       This is that page, rendered. It exists because the readout is the only
       part of the offer a competitor can't copy by also offering a free call —
       and a promise nobody has seen is worth less than a document they have.

       Two hard constraints on anything edited here:

       1. NO SCORECARD, NO GRADES. Scoring, grading and the 90-day roadmap are
          the paid Digital Presence Plan's deliverables (see the header comment
          at the top of this file, and `pulse-check-questionnaire.md` §"What it
          must not become"). Show a graded scorecard here and the Plan has
          nothing left to sell. The free readout is exactly three observations
          and one recommendation — this facsimile must stay that shape.
       2. IT STAYS LABELLED AS A SAMPLE. Cedar & Stone is the fictional client
          used across `sample-audit-report.md`; keeping the same invented name
          means neither sample can be mistaken for a real client's document.
          Swap in a real anonymized readout only with that client's written
          say-so, and keep the "sample" chip either way.

       Rendered as markup rather than a screenshot on purpose: it stays legible
       on a phone, it's readable by screen readers and by search, and it costs
       nothing to revise when the readout format moves. -->
  <section class="section readout" id="readout" data-section="consultation_readout">
    <div class="container">
      <div class="readout__intro">
        <p class="label">What you walk away with</p>
        <h2>This is the page that arrives 48 hours later.</h2>
        <p>
          Three observations and the one thing we&rsquo;d do first — written after the call,
          in plain language, short enough to actually read. It&rsquo;s yours to keep, act on,
          or hand to whoever builds your site. No grades, no 40-page assessment, no invoice.
        </p>
      </div>

      <figure class="sheet">
        <figcaption class="sheet__chip">Sample readout · fictional client</figcaption>

        <div class="sheet__head">
          <div>
            <p class="sheet__kicker">Pulse Check — Readout</p>
            <p class="sheet__client">Cedar &amp; Stone Landscaping</p>
          </div>
          <p class="sheet__meta">Sent 2 days after the call<br />1 page · no attachments</p>
        </div>

        <p class="sheet__lede">
          Thanks for the half hour. Here&rsquo;s what I noticed, in the order I&rsquo;d worry
          about it. Nothing here needs an agency to fix — the first two you can do yourself
          this week.
        </p>

        <ol class="sheet__obs">
          <li>
            <span class="sheet__n">Observation 1</span>
            <p class="sheet__t">People find you. They just can&rsquo;t reach you.</p>
            <p class="sheet__b">
              You rank well locally and your Google profile is in good shape — the top of your
              funnel is working. But your contact form&rsquo;s submit button sits under the
              cookie banner on an iPhone, and roughly seven in ten of your visitors are on one.
              I couldn&rsquo;t send you a message from my own phone while we were talking.
            </p>
          </li>
          <li>
            <span class="sheet__n">Observation 2</span>
            <p class="sheet__t">Your homepage doesn&rsquo;t say what you do.</p>
            <p class="sheet__b">
              Before our call I read your homepage for five seconds and looked away. What I
              wrote down was &ldquo;a landscaping company, somewhere.&rdquo; Not the design-build
              work you described, not the neighborhoods you actually serve. The headline
              (&ldquo;Welcome to Cedar &amp; Stone&rdquo;) is spending your most valuable line
              of text on a greeting.
            </p>
          </li>
          <li>
            <span class="sheet__n">Observation 3</span>
            <p class="sheet__t">Your best proof is somewhere you can&rsquo;t see it.</p>
            <p class="sheet__b">
              Forty-seven reviews at 4.7 stars, and photographs of your work that are genuinely
              good — none of which appear on your website. Meanwhile there&rsquo;s an unclaimed
              Houzz profile carrying six photos a customer uploaded, and that&rsquo;s the version
              of you a high-budget homeowner is most likely to meet first.
            </p>
          </li>
        </ol>

        <div class="sheet__rec">
          <span class="sheet__n">What I&rsquo;d do first</span>
          <p class="sheet__t">Fix the mobile form. This week. Before anything else.</p>
          <p class="sheet__b">
            Everything else on this page is an improvement. This one is a leak — you are paying
            for visibility that arrives at a door that doesn&rsquo;t open. Your web person can
            likely fix it in an afternoon; the theme&rsquo;s native form block would sidestep it
            entirely. Do that, then the headline, then claim Houzz. The reviews and the
            photography are worth a real conversation, but they&rsquo;re worth more once
            somebody can contact you.
          </p>
        </div>

        <p class="sheet__sign">
          — Damon, Panta<br />
          <span class="sheet__ps">
            No obligation attached to any of this. If you want the full picture — every channel,
            scored, with a 90-day sequence — that&rsquo;s the Digital Presence Plan, and we can
            talk about it whenever you like.
          </span>
        </p>
      </figure>
    </div>
  </section>

  <!-- WHO IT'S FOR -->
  <!-- A qualifier, not a sales section. The point is that the wrong-fit visitor
       recognizes themselves and doesn't book — a no-show or a bad-fit call is
       more expensive than a bounce, and the "not a fit" column is doing the
       real work here. Keep it. Deleting it turns this into flattery. -->
  <section class="section fit" data-section="consultation_fit">
    <div class="container">
      <p class="label">Who books this</p>
      <h2 style="max-width: 24ch;">Two kinds of people get the most out of it.</h2>
      <div class="fit__grid">
        <div class="fit__card">
          <p class="fit__who">The owner who built it themselves</p>
          <p class="fit__body">
            You run a small business, the website came together over a few weekends some years
            ago, and you&rsquo;ve suspected for a while it isn&rsquo;t pulling its weight —
            without knowing which part is the problem. You don&rsquo;t need a lecture on digital
            marketing. You need someone to look at the actual thing and say the honest sentence
            out loud.
          </p>
        </div>
        <div class="fit__card">
          <p class="fit__who">The director wearing six hats</p>
          <p class="fit__body">
            You lead a nonprofit or a community organization. Communications is a third of
            somebody&rsquo;s job, the site was inherited from a volunteer who has since moved on,
            and a funder or a board member has started asking about it. You need a clear-eyed
            read you can forward to people who weren&rsquo;t on the call.
          </p>
        </div>
        <div class="fit__card fit__card--not">
          <p class="fit__who">Probably not a fit if&hellip;</p>
          <ul class="fit__list">
            <li>You already know exactly what you want built and just need a quote — <a href="/contact/">send us the brief instead</a>, it&rsquo;s faster.</li>
            <li>You&rsquo;re looking for someone to run ads or post to social for you on retainer. That isn&rsquo;t what we do.</li>
            <li>You want the full graded assessment now. That&rsquo;s the <a href="/digital-presence-plan/">Digital Presence Plan</a>, and it&rsquo;s paid work.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- MARKETING & ADS -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="ads-panel">
        <div>
          <p class="label">{c.adsLabel}</p>
          <h2 style="font-size: clamp(1.5rem, 3.2vw, 2.125rem);">{c.adsTitle}</h2>
          <p>{c.adsBody}</p>
          <p class="small ads-note">{c.adsNote}</p>
        </div>
        <ul class="checklist" style="margin: 0;">
          {c.adsChecklist.map((item) => (
            <li><strong>{item.title}</strong> {item.body}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- BOOKING -->
  <!-- Everything above this point answers "what is this?" — and until now a
       visitor arriving from any CTA on the site skipped all of it, because every
       button deep-linked to #book and landed them on a bare calendar. The links
       now point at the top of the page (Base.astro, index.astro), but this
       section still has to stand on its own for anyone who jumps here anyway:
       the steps below restate what the call is and what it leaves behind, and
       the chooser puts the no-calendar path in view at the moment the calendar
       is what makes someone hesitate.

       This copy is deliberately hardcoded rather than pulled from Sanity, same
       as the #ask section below — it will want iteration, and a Studio schema
       change plus a patch script per wording tweak is the wrong loop for that.
       Lift it into `consultationPage` once it settles. -->
  <section class="section booking" id="book">
    <div class="container" style="text-align: center;">
      <p class="label">{c.bookingLabel}</p>
      <h2 style="max-width: 20ch; margin-inline: auto;">{c.bookingTitle}</h2>
      <p style="max-width: 48ch; margin: 0 auto 1.5rem;">{c.bookingBody}</p>

      <!-- What actually happens, at the point where someone decides. Wording
           tracks the canonical promise at the top of this file and the timeboxed
           structure in pulse-check-questionnaire.md — if the call changes, this
           changes with it. -->
      <ol class="how">
        {[
          {
            when: 'Before',
            // Not "nothing to prepare" — c.bookingBody two lines above already
            // says exactly that, and the trust row below says it again.
            body: 'We look at what you have ahead of time, so the call opens with what we found rather than with questions you could have answered by email.',
          },
          {
            when: 'On the call',
            body: 'Thirty minutes on the three questions that decide whether a presence works: can they find you, trust you, choose you.',
          },
          {
            when: 'After',
            body: 'A one-page written readout within 48 hours — three observations and one recommendation. Yours to keep whether or not we ever work together.',
          },
        ].map((step) => (
          <li class="how__step">
            <span class="how__when">{step.when}</span>
            <span class="how__body">{step.body}</span>
          </li>
        ))}
      </ol>

      <!-- Two ways to make the same request. Both are real links rather than
           one link and one label: on mobile the calendar is off-screen from
           here, so "Pick a time" has somewhere useful to go. Cards, not
           buttons — check-launch.mjs rule 3d caps the page at two .btn--filled
           outside the header and the LeadForm submit spends one. -->
      <div class="choose">
        <a
          class="choose__card"
          href="#calendar"
          data-track="cta_click"
          data-track-cta="choose_calendar"
          data-track-location="consultation_choose"
        >
          <span class="choose__head">Pick a time <span aria-hidden="true">&darr;</span></span>
          <span class="choose__body">See open times and book in about a minute.</span>
        </a>
        <a
          class="choose__card"
          href="#ask"
          data-track="cta_click"
          data-track-cta="choose_note"
          data-track-location="consultation_choose"
        >
          <span class="choose__head">Send a note instead <span aria-hidden="true">&darr;</span></span>
          <span class="choose__body">Tell us what brings you to us. We reply within one business day.</span>
        </a>
      </div>

      {/* Rendered only when the setting parses. An iframe with src={undefined}
          resolves to the current page and embeds /consultation/ inside itself,
          which is a worse failure than no calendar at all — the fallback link
          below is always there. */}
      <div class="book-embed" id="calendar">
        {CAL_EMBED_URL && (
          <iframe
            src={CAL_EMBED_URL}
            title="Book your free consultation with Panta"
            loading="lazy"
            width="100%"
            height="800"></iframe>
        )}
      </div>
      <p class="small" style="margin: 0.9rem auto 0; max-width: none;">
        Calendar not loading?
        <a
          href={SCHEDULE_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-track="cta_click"
          data-track-cta="booking_new_tab"
          data-track-location="consultation_booking"
        >Open it in a new tab →</a>
      </p>
      <div class="trust-row">
        {c.trustRow.map((item) => (
          <span><span class="ck">✓</span> {item}</span>
        ))}
      </div>
      {c.escapeLabel && (
        <p class="small escape-hatch">
          {c.escapeLabel} <a href={c.escapeHref}>{c.escapeLinkLabel} →</a>
        </p>
      )}
    </div>
  </section>

  <!-- ASK WITHOUT THE CALENDAR -->
  <!-- Every CTA on the site converges on this page, where until now the only
       way to act was to pick a slot in the embed above. Someone who wants to
       talk but won't commit to a time had no way to say so — the one escape
       was a link to more reading. This catches them on the page they already
       reached, instead of asking them to go find /contact/.
       It also used to sit below the calendar with nothing pointing at it, which
       meant the visitor put off by the calendar had to scroll past the calendar
       to find the alternative. The chooser above now sends them here — and the
       label matches that card word for word, so landing here reads as arriving
       rather than as having overshot. -->
  <section class="section section--dark" id="ask" data-section="consultation_ask">
    <div class="container ask__grid">
      <div class="ask__copy">
        <p class="label">Send a note instead</p>
        <h2 class="ask__head">Rather just tell us what&rsquo;s going on?</h2>
        <p class="ask__body">
          Send a short note and we&rsquo;ll reply within one business day — with a time to talk
          if that makes sense, or an answer if it doesn&rsquo;t need a call at all.
        </p>
      </div>
      <LeadForm source="consultation_ask">
        <a
          slot="aside"
          class="ask__book"
          href="#book"
          data-track="cta_click"
          data-track-cta="pulse_check"
          data-track-location="consultation_ask"
        >or pick a time above <span aria-hidden="true">&uarr;</span></a>
      </LeadForm>
    </div>
  </section>
</Base>

<!-- This page carried data-section on #ask from the day that section was added,
     but never imported the component that reads it, so the attribute did
     nothing. It matters more now: the readout and the fit sections sit between
     the visitor and the calendar, and whether they reach them is the only way
     to tell a page that's too long from one that's doing its job. -->
<SectionViews />

<script>
  // Booking funnel. The scheduler is a cross-origin Koalendar embed, which
  // still exposes no completion event to the host page — but unlike the Google
  // Calendar embed it replaced, it can redirect the invitee on completion. So
  // the booking IS observable now, just not from this page: it is counted on
  // /thanks/, which Koalendar redirects to.
  //
  // That makes `booking_viewed` the step BEFORE the conversion rather than the
  // end of the funnel. Keep it — reaching the calendar and completing a booking
  // are different things, and the ratio between them is where a broken booking
  // flow shows up.
  //
  // Still don't add a "booking_completed" here. This page cannot see one, and
  // an event named for something it is guessing at is worse than no event.
  const track = (window as any).pantaTrack ?? (() => {});
  const embed = document.querySelector<HTMLElement>('.book-embed');

  if (embed) {
    // Reaching the calendar is the real intent signal on this page — it sits
    // below a long explainer, so most visitors never get here.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          track('booking_viewed');
          observer.disconnect();
        }
      },
      { threshold: 0.4 }
    );
    observer.observe(embed);
  }
</script>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  /* diagnostic panel — cream readout on the dark hero */
  .panel {
    background: var(--cream);
    color: var(--charcoal);
    border-radius: 10px;
    padding: 1.75rem;
    box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.55);
  }

  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.25rem;
  }

  .panel-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bamboo-deep);
  }

  .panel-url {
    font-size: 0.75rem;
    color: var(--stone-deep);
  }

  .panel-sub {
    font-size: 0.85rem;
    color: var(--stone-deep);
    margin-bottom: 1.25rem;
  }

  .pmap {
    display: grid;
    gap: 0.7rem;
  }

  .pnode {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.8rem 0.9rem;
    border-radius: 8px;
    background: #fffdf7;
    border: 1px solid var(--line);
  }

  .ico {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 600;
    flex-shrink: 0;
    background: var(--charcoal);
    color: var(--cream);
  }

  .pmeta { flex: 1; }

  .pt {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .ps {
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--stone-deep);
  }

  .pill {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
    background: #eef0e0;
    color: var(--bamboo-deep);
    border: 1px solid var(--sage);
  }

  .panel-foot {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
  }

  .panel-tag {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--stone-deep);
    flex-shrink: 0;
    padding-top: 2px;
    white-space: nowrap;
  }

  .panel-txt {
    font-size: 0.83rem;
    line-height: 1.45;
    color: var(--charcoal);
  }

  /* proof strip */
  .proof {
    border-bottom: 1px solid var(--line);
    background: var(--cream-soft);
  }

  .proof-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 4vw, 2.5rem);
    flex-wrap: wrap;
    padding-block: 1.25rem;
  }

  .proof-q {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--stone-deep);
  }

  .client {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.1rem;
    color: var(--charcoal);
    opacity: 0.85;
  }

  /* cards */
  .card-num {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--bamboo-deep);
    margin-bottom: 0.9rem;
  }

  /* ---------------------------------------------------- the readout, shown -- */

  .readout {
    background: var(--cream-soft);
    border-top: 1px solid var(--line);
  }

  .readout__intro {
    max-width: 46rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  /* The sheet reads as a document, not as another card on the page: paper-white
     against the section's cream, a serif body, and a hairline rule instead of
     the site's usual card border. If it looks like site furniture the visitor
     reads it as marketing copy rather than as the thing they'd receive. */
  .sheet {
    position: relative;
    margin: 0 auto;
    max-width: 44rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    background: #fffdf7;
    border: 1px solid var(--line);
    border-radius: 4px;
    box-shadow: 0 18px 46px -28px rgba(38, 37, 31, 0.4);
  }

  .sheet__chip {
    display: inline-block;
    margin-bottom: 1.5rem;
    padding: 4px 10px;
    border-radius: 999px;
    background: #eef0e0;
    border: 1px solid var(--sage);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bamboo-deep);
  }

  .sheet__head {
    display: flex;
    align-items: flex-start;
