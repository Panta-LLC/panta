---
import Base from '../layouts/Base.astro';
import { getDoc, getProjects } from '../lib/sanity.js';

const c = await getDoc('consultationPage');
const settings = await getDoc('siteSettings');
const projects = await getProjects();

// Booking URLs are managed in Sanity → Site Settings. The owner is updating
// the Google Calendar schedule to offer 30-minute slots to match this page.
const SCHEDULE_URL = settings.scheduleUrl;
const CAL_EMBED_URL = settings.calEmbedUrl;

const description =
  'A free 30-minute web presence audit for businesses at any stage — with or without a website. Walk away with an honest read on where you stand and a blueprint for what to do next.';

const consultSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Free Web Presence Audit',
    serviceType: 'Web strategy consultation',
    description,
    provider: { '@type': 'ProfessionalService', name: 'Panta LLC', url: 'https://panta.llc' },
    areaServed: 'Worldwide',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
  },
];
---
<Base
  title="Free Web Presence Audit — Panta"
  description={description}
  schema={consultSchema}
>
  <!-- HERO -->
  <section class="section section--dark" style="padding-block: clamp(3.5rem, 8vw, 6rem);">
    <div class="container hero-grid">
      <div>
        <p class="label">{c.heroLabel}</p>
        <h1 style="font-size: clamp(2.2rem, 4.5vw, 3.4rem);">{c.heroTitle}</h1>
        <p class="lede">{c.heroLede}</p>
        <div class="btn-row">
          <a
            class="btn btn--primary"
            href="#book"
            data-track="cta_click"
            data-track-cta="scroll_to_booking"
            data-track-location="consultation_hero"
          >{c.bookCtaLabel}</a>
          <span class="small"><strong>{c.bookNote}</strong></span>
        </div>
      </div>

      <!-- diagnostic panel: the whole picture we map together -->
      <div class="panel" aria-label="What the audit maps">
        <div class="panel-head">
          <span class="panel-label">{c.panelLabel}</span>
          <span class="panel-url">your web presence</span>
        </div>
        <p class="panel-sub">{c.panelSub}</p>
        <div class="pmap">
          {c.panelNodes.map((node, i) => (
            <div class="pnode">
              <span class="ico">{i + 1}</span>
              <div class="pmeta">
                <div class="pt">{node.title}</div>
                <div class="ps">{node.body}</div>
              </div>
              <span class="pill">{node.kicker}</span>
            </div>
          ))}
        </div>
        <div class="panel-foot">
          <span class="panel-tag">{c.panelFootTag}</span>
          <span class="panel-txt">{c.panelFootText}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PROOF -->
  <div class="proof">
    <div class="container proof-inner">
      <span class="proof-q">{c.proofLabel}</span>
      {projects.map((p) => <span class="client">{p.name}</span>)}
    </div>
  </div>

  <!-- WHAT YOU GET -->
  <section class="section">
    <div class="container">
      <p class="label">{c.deliverLabel}</p>
      <h2>{c.deliverTitle}</h2>
      <p>{c.deliverIntro}</p>
      <div class="grid grid--3" style="margin-top: 2.5rem;">
        {c.deliverCards.map((card) => (
          <div class="card">
            <p class="card-num">{card.kicker}</p>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MARKETING & ADS -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="ads-panel">
        <div>
          <p class="label">{c.adsLabel}</p>
          <h2 style="font-size: clamp(1.5rem, 3.2vw, 2.125rem);">{c.adsTitle}</h2>
          <p>{c.adsBody}</p>
          <p class="small ads-note">{c.adsNote}</p>
        </div>
        <ul class="checklist" style="margin: 0;">
          {c.adsChecklist.map((item) => (
            <li><strong>{item.title}</strong> {item.body}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- BOOKING -->
  <section class="section booking" id="book">
    <div class="container" style="text-align: center;">
      <p class="label">{c.bookingLabel}</p>
      <h2 style="max-width: 20ch; margin-inline: auto;">{c.bookingTitle}</h2>
      <p style="max-width: 48ch; margin: 0 auto 1.5rem;">{c.bookingBody}</p>
      <div class="book-embed">
        <iframe
          src={CAL_EMBED_URL}
          title="Book your free audit with Panta"
          loading="lazy"
          width="100%"
          height="640"></iframe>
      </div>
      <p class="small" style="margin: 0.9rem auto 0; max-width: none;">
        Calendar not loading?
        <a
          href={SCHEDULE_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-track="cta_click"
          data-track-cta="booking_new_tab"
          data-track-location="consultation_booking"
        >Open it in a new tab →</a>
      </p>
      <div class="trust-row">
        {c.trustRow.map((item) => (
          <span><span class="ck">✓</span> {item}</span>
        ))}
      </div>
      {c.escapeLabel && (
        <p class="small escape-hatch">
          {c.escapeLabel} <a href={c.escapeHref}>{c.escapeLinkLabel} →</a>
        </p>
      )}
    </div>
  </section>
</Base>

<script>
  // Booking funnel, such as it can be measured. The scheduler is a cross-origin
  // Google Calendar appointment embed: it exposes no completion event to the
  // host page, so a booking is NOT observable from here. The last thing we can
  // see is the visitor reaching the calendar; actual bookings are counted in
  // Google Calendar itself. Don't add a "booking_completed" event unless the
  // scheduler is swapped for one that genuinely reports back.
  const track = (window as any).pantaTrack ?? (() => {});
  const embed = document.querySelector<HTMLElement>('.book-embed');

  if (embed) {
    // Reaching the calendar is the real intent signal on this page — it sits
    // below a long explainer, so most visitors never get here.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          track('booking_viewed');
          observer.disconnect();
        }
      },
      { threshold: 0.4 }
    );
    observer.observe(embed);
  }
</script>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  /* diagnostic panel — cream readout on the dark hero */
  .panel {
    background: var(--cream);
    color: var(--charcoal);
    border-radius: 10px;
    padding: 1.75rem;
    box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.55);
  }

  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.25rem;
  }

  .panel-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bamboo-deep);
  }

  .panel-url {
    font-size: 0.75rem;
    color: var(--stone-deep);
  }

  .panel-sub {
    font-size: 0.85rem;
    color: var(--stone-deep);
    margin-bottom: 1.25rem;
  }

  .pmap {
    display: grid;
    gap: 0.7rem;
  }

  .pnode {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.8rem 0.9rem;
    border-radius: 8px;
    background: #fffdf7;
    border: 1px solid var(--line);
  }

  .ico {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 600;
    flex-shrink: 0;
    background: var(--charcoal);
    color: var(--cream);
  }

  .pmeta { flex: 1; }

  .pt {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .ps {
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--stone-deep);
  }

  .pill {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
    background: #eef0e0;
    color: var(--bamboo-deep);
    border: 1px solid var(--sage);
  }

  .panel-foot {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
  }

  .panel-tag {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--stone-deep);
    flex-shrink: 0;
    padding-top: 2px;
    white-space: nowrap;
  }

  .panel-txt {
    font-size: 0.83rem;
    line-height: 1.45;
    color: var(--charcoal);
  }

  /* proof strip */
  .proof {
    border-bottom: 1px solid var(--line);
    background: var(--cream-soft);
  }

  .proof-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 4vw, 2.5rem);
    flex-wrap: wrap;
    padding-block: 1.25rem;
  }

  .proof-q {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--stone-deep);
  }

  .client {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.1rem;
    color: var(--charcoal);
    opacity: 0.85;
  }

  /* cards */
  .card-num {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--bamboo-deep);
    margin-bottom: 0.9rem;
  }

  /* ads readiness */
  .ads-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    background: var(--cream-soft);
    border: 1px solid var(--line);
    border-radius: 10px;
  }

  .ads-note {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 860px) {
    .ads-panel {
      grid-template-columns: 1fr;
    }
  }

  /* booking */
  .booking {
    background: var(--cream-soft);
    border-top: 1px solid var(--line);
    scroll-margin-top: 2rem;
  }

  .booking p { margin-inline: auto; }

  .book-embed {
    margin: 1.5rem auto 0;
    max-width: 720px;
    background: #fffdf7;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }

  .book-embed iframe {
    display: block;
    width: 100%;
    min-height: 640px;
    border: 0;
  }

  .trust-row {
    display: flex;
    gap: clamp(1rem, 3vw, 1.75rem);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .trust-row span {
    font-size: 0.85rem;
    color: var(--stone-deep);
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .trust-row .ck {
    color: var(--bamboo-deep);
    font-weight: 700;
  }

  /* escape hatch for visitors who aren't ready to book */
  .escape-hatch {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--stone-deep);
  }
</style>
