---
import Base from '../layouts/Base.astro';

const faqs = [
  {
    q: 'What does the Blueprint cost?',
    a: 'The Digital Presence Blueprint is $750 flat. Founding clients get it for $600 in exchange for honest feedback, and nonprofits get 15% off published pricing.',
  },
  {
    q: 'I have literally nothing online. Is this still useful?',
    a: 'Especially then. You almost certainly exist online anyway — an auto-generated Google listing, a directory that scraped your registration, a review-site stub. The fragment scan finds those so you can take control of them, and the rest of the Blueprint makes sure the first dollar you spend building goes to the right place.',
  },
  {
    q: 'Do you build it too?',
    a: 'We can, but you decide. Every step in the launch sequence is tagged DIY — claiming profiles, setting up analytics, things you can genuinely do yourself with the guides we include — or Project, if it is worth hiring out. If you want us for the Project items, a website or full presence build is scoped from the Blueprint.',
  },
  {
    q: 'How is this different from hiring a web designer?',
    a: 'A website is one channel of seven or more. The Blueprint plans the whole arc — search, maps, directories, reviews, social, email, and the website — plus how they link together, what each needs to earn trust, and measurement from day one. Then whoever builds the site (us or anyone else) builds to a plan instead of a guess.',
  },
  {
    q: 'What if I have some presence — old, broken, or half-built?',
    a: 'That is a judgment call we make together on the discovery call. Rough rule: if what exists is real but broken, the Audit is usually the better door, because seeing what is wrong with your actual presence is more useful than a generic plan. If what exists is fragments you never made, the Blueprint fits. You never have to pick blind.',
  },
];

const blueprintSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Digital Presence Blueprint',
    serviceType: 'Digital presence launch plan',
    provider: { '@type': 'ProfessionalService', name: 'Panta LLC', url: 'https://panta.co' },
    description:
      'A complete, prioritized plan for a new digital presence — which channels matter for your audience, in what order to build them, and what done-right looks like for each — delivered in 10 business days.',
    offers: {
      '@type': 'Offer',
      price: '750',
      priceCurrency: 'USD',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  title="The Digital Presence Blueprint — Panta"
  description="Starting fresh? Get a complete build plan for your digital presence: the channels that matter, the order to build them, a 90-day launch sequence, and measurement from day one. $750 flat, 10 business days."
  schema={blueprintSchema}
>
  <section class="section section--dark hero" style="padding-block: clamp(3.5rem, 8vw, 6rem);">
    <div class="container">
      <p class="label">The Digital Presence Blueprint</p>
      <h1 style="font-size: clamp(2.2rem, 4.5vw, 3.4rem);">Build your presence right the first time.</h1>
      <p class="lede">
        For businesses and organizations starting fresh: a complete, prioritized
        plan for how the world will find, trust, and choose you — before you
        spend a dollar building the wrong thing.
      </p>
      <div class="btn-row">
        <a href="/consultation/" class="btn btn--primary">Book a free 30-minute audit</a>
        <span class="small">$750 flat · founding clients $600 · nonprofits 15% off</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label">"But I have nothing to audit"</p>
      <h2>You already exist online. You're just not in control of it yet.</h2>
      <p>
        Registered businesses accumulate an online presence whether they build
        one or not: an auto-generated Google Business Profile, a Yelp stub
        somebody seeded, directories that scraped your paperwork, a confusable
        competitor ranking for your name. The Blueprint starts with a
        <strong>fragment scan</strong> that finds all of it — so day one of your
        real presence starts with claiming what's already yours.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <p class="label">What you get</p>
      <h2>Six deliverables. A plan, not a pep talk.</h2>
      <div class="grid grid--3" style="margin-top: 2.5rem;">
        <div class="card">
          <h3>Presence Standard Checklist</h3>
          <p>
            The same 40 checks we grade established businesses against — handed
            to you as build targets, so every decision has a definition of
            "done right."
          </p>
        </div>
        <div class="card">
          <h3>Entry Point Plan</h3>
          <p>
            Which channels your audience actually uses, which to build now,
            which to deliberately skip, and how they all link back to your hub.
          </p>
        </div>
        <div class="card">
          <h3>Top 3 Launch Priorities</h3>
          <p>
            The three places a new presence leaks first — for your segment and
            audience — and what skipping each would cost you.
          </p>
        </div>
        <div class="card">
          <h3>90-Day Launch Sequence</h3>
          <p>
            Every step, in order, tagged <strong>DIY</strong> (you can do this —
            here's how) or <strong>Project</strong> (worth hiring out). About a
            third is typically DIY.
          </p>
        </div>
        <div class="card">
          <h3>Fragment Scan Report</h3>
          <p>
            Everything that already exists about you online, with a
            claim-it, correct-it, or suppress-it action for each.
          </p>
        </div>
        <div class="card">
          <h3>Blueprint Walkthrough</h3>
          <p>
            A 60-minute live presentation of the whole plan, in language you
            can act on. Bring whoever makes decisions.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <p class="label">The head start</p>
      <h2>Measured from your very first visitor.</h2>
      <p>
        Most established businesses have no idea which channels produce their
        customers — analytics was never set up, so they're guessing. The
        Blueprint wires measurement in <em>before</em> launch: analytics,
        search data, and conversion tracking from day one. It's the one
        structural advantage a brand-new presence has over every established
        competitor — and in 90 days, we re-score you against the standard for
        free, so progress is a number, not a feeling.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label">How it works</p>
      <h2>Ten business days, start to finish.</h2>
      <div class="table-wrap" style="margin-top: 2rem;">
        <table>
          <thead>
            <tr><th scope="col">Days</th><th scope="col">What happens</th></tr>
          </thead>
          <tbody>
            <tr><td>Day 0</td><td>Intake questionnaire sent — about 20 minutes on your goals, audience, and what exists so far.</td></tr>
            <tr><td>Days 1–2</td><td>45-minute discovery call. The plan is built around your goals and your audience, not a template.</td></tr>
            <tr><td>Days 3–6</td><td>Fragment scan, channel research, and conversion-path design for each audience you serve.</td></tr>
            <tr><td>Days 7–9</td><td>Blueprint assembly.</td></tr>
            <tr><td>Day 10</td><td>60-minute walkthrough. Written blueprint delivered — yours to execute with anyone.</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--bamboo">
    <div class="container">
      <p class="label">Pricing</p>
      <h2 style="margin-bottom: 1.5rem;">One flat price. Everything included.</h2>
      <div class="grid grid--3">
        <div class="card" style="background: var(--cream); border-color: transparent; color: var(--charcoal);">
          <p class="label">Digital Presence Blueprint</p>
          <p class="price-tag">$750</p>
          <p>All six deliverables, the 90-day launch sequence, and a free re-score at 90 days.</p>
        </div>
        <div class="card" style="background: var(--cream); border-color: transparent; color: var(--charcoal);">
          <p class="label">Founding clients</p>
          <p class="price-tag">$600</p>
          <p>Our first clients, in exchange for honest feedback and a testimonial if we earn it.</p>
        </div>
        <div class="card" style="background: var(--cream); border-color: transparent; color: var(--charcoal);">
          <p class="label">Nonprofits</p>
          <p class="price-tag">15% off</p>
          <p>On published pricing, always. Supporting community missions is why Panta exists.</p>
        </div>
      </div>
      <p class="small" style="margin-top: 1.5rem; color: var(--cream);">
        Ready to build afterward? Websites, profiles, and custom tools are
        scoped straight from the Blueprint — by us or by anyone you choose.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label">Questions</p>
      <h2>The things people ask first.</h2>
      <div style="margin-top: 2rem; max-width: 46rem;">
        {faqs.map(({ q, a }) => (
          <details style="border-bottom: 1px solid var(--line); padding-block: 1rem;">
            <summary style="font-family: var(--font-serif); font-size: 1.2rem; cursor: pointer;">{q}</summary>
            <p style="margin-top: 0.75rem;">{a}</p>
          </details>
        ))}
      </div>
      <div class="btn-row" style="margin-top: 2.5rem;">
        <a href="/consultation/" class="btn btn--primary">Book a free 30-minute audit</a>
        <span class="small">Already have a presence? <a href="/audit/">The Audit</a> is your door.</span>
      </div>
    </div>
  </section>
</Base>
