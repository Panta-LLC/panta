---
import Base from '../../layouts/Base.astro';

const faqs = [
  {
    q: 'What does the plan cost?',
    a: 'The Digital Presence Plan is $850 flat. Founding clients get it for $650 in exchange for honest feedback, and nonprofits get 15% off published pricing.',
  },
  {
    q: 'What happens on the free consultation?',
    a: 'Thirty minutes, nothing to prepare. We map your current situation — live site, fragments, or an idea on a napkin — and define what your plan needs to cover. You leave with an honest read and the single most important next move, whether or not you buy the plan.',
  },
  {
    q: 'I have little or nothing online. Is this still for me?',
    a: 'Yes — that is simply where the plan starts. You almost certainly exist online anyway: an auto-generated Google listing, a directory that scraped your registration, a review-site stub. We find those fragments, and the plan becomes your build sequence instead of a fix list.',
  },
  {
    q: 'I already have a website and profiles. What do I get?',
    a: 'A graded read on all of it. Every channel is scored against our 40-check standard — visibility, trust, conversion, systems — your biggest money leaks are costed in plain dollars, and the roadmap tells you what to fix first and why.',
  },
  {
    q: 'Do I have to hire you to execute the plan?',
    a: 'No. Every roadmap item is tagged either DIY — with a guide so you can do it yourself, free — or Project, if it is genuinely worth hiring out. Roughly a third of a typical roadmap is DIY. The plan and all findings are yours either way.',
  },
  {
    q: 'How long does it take?',
    a: 'Ten business days from intake to walkthrough, after the free consultation. You get the full written plan plus a 60-minute live walkthrough — and a free re-score at 90 days so progress is measured, not guessed.',
  },
];

const planSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Digital Presence Plan',
    serviceType: 'Digital presence strategy and audit',
    provider: { '@type': 'ProfessionalService', name: 'Panta LLC', url: 'https://panta.co' },
    description:
      'A complete, graded read on how the world finds, trusts, and chooses your organization — wherever you are starting — with a prioritized 90-day roadmap, delivered in 10 business days.',
    offers: {
      '@type': 'Offer',
      price: '850',
      priceCurrency: 'USD',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  title="The Digital Presence Plan — Panta"
  description="One plan, wherever you're starting: every channel graded against a 40-check standard, your biggest leaks costed, and a 90-day roadmap that separates free DIY fixes from projects worth hiring out. $850 flat, 10 business days."
  schema={planSchema}
>
  <section class="section section--dark hero" style="padding-block: clamp(3.5rem, 8vw, 6rem);">
    <div class="container">
      <p class="label">The Digital Presence Plan</p>
      <h1 style="font-size: clamp(2.2rem, 4.5vw, 3.4rem);">One plan, wherever you're starting.</h1>
      <p class="lede">
        We grade what exists, design what's missing, and hand you a
        prioritized 90-day roadmap for a presence that finds, earns, and keeps
        your community — honest about what you can do yourself.
      </p>
      <div class="btn-row">
        <a href="/consultation/" class="btn btn--primary">Start with the free consultation</a>
        <span class="small">$850 flat · founding clients $650 · nonprofits 15% off</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label">Step one is free</p>
      <h2>Every plan starts with a conversation.</h2>
      <p>
        The <a href="/consultation/">free 30-minute consultation</a> is where
        we map your current situation and define what your plan needs to cover
        — a live site, scattered fragments, or nothing yet, it all works. The
        plan engagement picks up exactly where that conversation ends, so
        nothing is asked twice.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <p class="label">Wherever you're starting</p>
      <h2>You already exist online. The plan puts you in control of it.</h2>
      <p>
        Organizations accumulate an online presence whether they build one or
        not: an auto-generated Google Business Profile, a Yelp stub somebody
        seeded, directories that scraped your paperwork, a confusable
        competitor ranking for your name. The plan begins with a
        <strong>fragment scan</strong> that finds all of it — then grades
        everything you actually control against the same 40-check standard we
        hold every presence to.
      </p>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <p class="label">What you get</p>
      <h2>Six deliverables. A plan, not a pep talk.</h2>
      <div class="grid grid--3" style="margin-top: 2.5rem;">
        <div class="card" style="background: transparent; border-color: #3c3a32; color: var(--cream);">
          <h3>Presence Scorecard</h3>
          <p>
            Forty checks across Visibility, Trust, Conversion, and Systems —
            graded where things exist, set as build targets where they don't.
            The headline is your bottleneck, not your average.
          </p>
        </div>
        <div class="card" style="background: transparent; border-color: #3c3a32; color: var(--cream);">
          <h3>Entry Point Map &amp; Plan</h3>
          <p>
            Every channel where you exist (or should), how they connect, which
            to build next, and which to deliberately skip.
          </p>
        </div>
        <div class="card" style="background: transparent; border-color: #3c3a32; color: var(--cream);">
          <h3>Top 3 Priorities</h3>
          <p>
            Your biggest money leaks — or launch priorities — in plain
            language, with a dollar estimate of what each costs you per month.
          </p>
        </div>
        <div class="card" style="background: transparent; border-color: #3c3a32; color: var(--cream);">
          <h3>90-Day Roadmap</h3>
          <p>
            Every move, in order, tagged <strong>DIY</strong> (you can do this
            — here's how) or <strong>Project</strong> (worth hiring out). About
            a third is typically DIY.
          </p>
        </div>
        <div class="card" style="background: transparent; border-color: #3c3a32; color: var(--cream);">
          <h3>Baseline &amp; Measurement</h3>
          <p>
            Your "before" picture, with analytics and conversion tracking set
            up or verified — so improvement gets measured, not guessed. Free
            re-score at 90 days.
          </p>
        </div>
        <div class="card" style="background: transparent; border-color: #3c3a32; color: var(--cream);">
          <h3>Plan Walkthrough</h3>
          <p>
            A 60-minute live presentation of everything, in language you can
            act on. Bring whoever makes decisions.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label">How it works</p>
      <h2>A free conversation, then ten business days.</h2>
      <div class="table-wrap" style="margin-top: 2rem;">
        <table>
          <thead>
            <tr><th scope="col">When</th><th scope="col">What happens</th></tr>
          </thead>
          <tbody>
            <tr><td>Before day 1</td><td><strong>Free 30-minute consultation</strong> — where every plan starts: we map your situation and scope what the plan needs to cover.</td></tr>
            <tr><td>Day 0</td><td>Intake questionnaire — about 20 minutes on your goals and audience, plus account-access guides.</td></tr>
            <tr><td>Days 1–6</td><td>Fragment scan, channel grading against the 40-check standard, and conversion-path work for each audience you serve.</td></tr>
            <tr><td>Days 7–9</td><td>Plan assembly.</td></tr>
            <tr><td>Day 10</td><td>60-minute walkthrough. Written plan delivered — yours to execute with anyone.</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <p class="label">Made to fit</p>
      <h2>The plan adapts to how your world actually works.</h2>
      <ul class="checklist" style="margin-top: 1.5rem;">
        <li>
          <strong>Nonprofits:</strong> donor, volunteer, and grantmaker paths
          planned separately; Candid/GuideStar presence; and a Google Ad Grant
          check — $10,000/month in free search ads most organizations leave
          unclaimed or misconfigured.
        </li>
        <li>
          <strong>Professional practices:</strong> directories like Psychology
          Today and Healthgrades often out-traffic your website. We plan them
          first — with review guidance built around what your ethics code
          allows.
        </li>
        <li>
          <strong>E-commerce:</strong> product feeds, marketplace presence,
          checkout friction, and abandonment recovery — the places where speed
          and follow-through are directly revenue-linked.
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--bamboo">
    <div class="container">
      <p class="label">Pricing</p>
      <h2 style="margin-bottom: 1.5rem;">One flat price. Everything included.</h2>
      <div class="grid grid--3">
        <div class="card" style="background: var(--cream); border-color: transparent; color: var(--charcoal);">
          <p class="label">Digital Presence Plan</p>
          <p class="price-tag">$850</p>
          <p>All six deliverables, the 90-day roadmap, and a free re-score at 90 days.</p>
        </div>
        <div class="card" style="background: var(--cream); border-color: transparent; color: var(--charcoal);">
          <p class="label">Founding clients</p>
          <p class="price-tag">$650</p>
          <p>Our first clients, in exchange for honest feedback and a testimonial if we earn it.</p>
        </div>
        <div class="card" style="background: var(--cream); border-color: transparent; color: var(--charcoal);">
          <p class="label">Nonprofits</p>
          <p class="price-tag">15% off</p>
          <p>On published pricing, always. Supporting community missions is why Panta exists.</p>
        </div>
      </div>
      <p class="small" style="margin-top: 1.5rem; color: var(--cream);">
        Ready to build afterward? Web channels, content, and brand work are
        scoped straight from your plan — by us or by anyone you choose.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label">Questions</p>
      <h2>The things people ask first.</h2>
      <div style="margin-top: 2rem; max-width: 46rem;">
        {faqs.map(({ q, a }) => (
          <details style="border-bottom: 1px solid var(--line); padding-block: 1rem;">
            <summary style="font-family: var(--font-serif); font-size: 1.2rem; cursor: pointer;">{q}</summary>
            <p style="margin-top: 0.75rem;">{a}</p>
          </details>
        ))}
      </div>
      <div class="btn-row" style="margin-top: 2.5rem;">
        <a href="/consultation/" class="btn btn--primary">Start with the free consultation</a>
        <span class="small">No pitch, no pressure. If the plan isn't the right move, we'll say so.</span>
      </div>
    </div>
  </section>
</Base>
