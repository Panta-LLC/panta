---
import Base from '../../layouts/Base.astro';

const dbcSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Digital Business Consulting',
    serviceType: 'Digital business consulting',
    provider: { '@type': 'ProfessionalService', name: 'Panta LLC', url: 'https://panta.co' },
    description:
      'Digital presence planning, web channel design and build, content creation and marketing, and brand development for small businesses, nonprofits, and independent practices.',
    areaServed: 'United States',
  },
];
---
<Base
  title="Digital Business Consulting — Panta"
  description="Panta's first practice: a Digital Presence Plan, web channel design and build, content creation and marketing, and brand development — for small businesses, nonprofits, and independent practices."
  schema={dbcSchema}
>
  <section class="section section--dark hero">
    <div class="container">
      <p class="label">Digital Business Consulting</p>
      <h1>Your customers need to find you, trust you, and choose you.</h1>
      <p class="lede">
        We help small businesses, nonprofits, and independent practices fix the
        places online where that path breaks — with strategy and engineering
        from the same hands.
      </p>
      <div class="btn-row">
        <a href="/consultation/" class="btn btn--primary">Start with the free consultation</a>
        <a href="#offerings" class="btn btn--ghost">See what we do</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label">The arc we work on</p>
      <h2>Every customer, client, and donor follows the same path.</h2>
      <p>
        Wherever someone meets you — Google, a directory, a friend's
        recommendation they go verify — three things have to go right. Most
        organizations are leaking at one of them and can't see which.
      </p>
      <div class="grid grid--3" style="margin-top: 2.5rem;">
        <div class="card">
          <p class="card__kicker">Find</p>
          <h3>Can they find you?</h3>
          <p>
            Search results, Google Business Profile, maps, directories, social.
            Gaps and inconsistencies here mean people who need you never know
            you exist.
          </p>
        </div>
        <div class="card">
          <p class="card__kicker">Trust</p>
          <h3>Do they believe you?</h3>
          <p>
            Reviews, consistent information, a recognizable brand, signs of
            life. People check — and quietly move on when what they find looks
            stale or contradictory.
          </p>
        </div>
        <div class="card">
          <p class="card__kicker">Choose</p>
          <h3>Can they choose you?</h3>
          <p>
            A clear next step, a form that works on a phone, a reply that comes
            fast. This is where most of the money leaks — and the cheapest
            place to fix it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark" id="offerings">
    <div class="container">
      <p class="label">The practice</p>
      <h2>Four offerings. One front door.</h2>
      <p class="lede" style="max-width: 56ch;">
        Everything starts with the plan; everything after it is scoped from the
        plan — built by us or by anyone you choose.
      </p>

      <div style="display: grid; gap: 1.25rem; margin-top: 2.5rem;">
        <div class="offer">
          <span class="offer__num">01</span>
          <div class="offer__body">
            <h3>Digital Presence Plan</h3>
            <p>
              A complete, graded read on how the world finds, trusts, and
              chooses you — wherever you're starting — and a prioritized 90-day
              roadmap forward. <strong>$850 flat.</strong>
            </p>
            <a href="/digital-business-consulting/digital-presence-plan/" class="btn btn--primary" style="margin-top: 0.5rem;">Explore the plan</a>
          </div>
        </div>

        <div class="offer">
          <span class="offer__num">02</span>
          <div class="offer__body">
            <h3>Design, build &amp; configure web channels</h3>
            <p>
              <strong>Website development</strong> — your home base, built to
              convert and built to last. <strong>Social &amp; directory
              setup</strong> — Facebook, Instagram, and LinkedIn configured
              right; your Google Business Profile claimed and complete; the
              industry directories that matter for your field. Every channel
              cross-linked so no door dead-ends.
            </p>
            <p class="small">Scoped from your plan.</p>
          </div>
        </div>

        <div class="offer">
          <span class="offer__num">03</span>
          <div class="offer__body">
            <h3>Content creation &amp; marketing</h3>
            <p>
              A publishing rhythm you can actually sustain, review and referral
              systems that turn happy customers into proof, and measurement
              that tells you what's working before you spend on reach.
            </p>
            <p class="small">Scoped from your plan.</p>
          </div>
        </div>

        <div class="offer">
          <span class="offer__num">04</span>
          <div class="offer__body">
            <h3>Brand development</h3>
            <p>
              Identity, voice, and visual consistency — so you're recognizable
              as the same trustworthy organization everywhere your audience
              meets you.
            </p>
            <p class="small">Scoped from your plan.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label">How it works</p>
      <h2>Three steps. No mystery.</h2>
      <div class="grid grid--3" style="margin-top: 2.5rem;">
        <div class="card">
          <p class="card__kicker">Step 1 · Free</p>
          <h3>The consultation</h3>
          <p>
            A free 30-minute conversation to understand your current situation
            and what your plan needs to cover. You leave with an honest read
            either way.
          </p>
        </div>
        <div class="card">
          <p class="card__kicker">Step 2 · $850</p>
          <h3>The Digital Presence Plan</h3>
          <p>
            The full graded read and a 90-day roadmap — every item tagged DIY
            (with a guide) or Project. About a third is typically free to do
            yourself.
          </p>
        </div>
        <div class="card">
          <p class="card__kicker">Step 3 · Scoped</p>
          <h3>Build &amp; create</h3>
          <p>
            Channels, content, and brand — scoped directly from your plan and
            built by us, or taken anywhere you like. The plan is yours either
            way.
          </p>
        </div>
      </div>
      <div class="btn-row" style="margin-top: 2.5rem;">
        <a href="/consultation/" class="btn btn--primary">Start with the free consultation</a>
        <span class="small">30 minutes. No prep, no pressure.</span>
      </div>
    </div>
  </section>
</Base>

<style>
  .offer {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    padding: 1.75rem;
    border: 1px solid #3c3a32;
    border-radius: 8px;
  }

  .offer__num {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--sage);
    padding-top: 0.4rem;
    flex-shrink: 0;
  }

  .offer__body h3 {
    margin-bottom: 0.4em;
  }

  .offer__body p {
    margin-bottom: 0.5em;
  }

  .offer__body p:last-child {
    margin-bottom: 0;
  }
</style>
