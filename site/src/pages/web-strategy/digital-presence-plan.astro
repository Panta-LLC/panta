---
import Base from '../../layouts/Base.astro';
import { getDoc } from '../../lib/sanity.js';

const c = await getDoc('planPage');

const planSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Digital Presence Plan',
    serviceType: 'Digital presence strategy and audit',
    provider: { '@type': 'ProfessionalService', name: 'Panta LLC', url: 'https://panta.llc' },
    description:
      'A complete, graded read on how the world finds, trusts, and chooses your organization — wherever you are starting — with a prioritized 90-day roadmap, delivered in 10 business days.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: c.faqs.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  title="The Digital Presence Plan — Panta"
  description="One plan, wherever you're starting: every channel graded against a 40-check standard, your biggest leaks costed, and a 90-day roadmap that separates free DIY fixes from projects worth hiring out. Delivered in 10 business days — quote available on request."
  schema={planSchema}
>
  <section class="section section--dark hero" style="padding-block: clamp(3.5rem, 8vw, 6rem);">
    <div class="container">
      <p class="label">{c.heroLabel}</p>
      <h1 style="font-size: clamp(2.2rem, 4.5vw, 3.4rem);">{c.heroTitle}</h1>
      <p class="lede">{c.heroLede}</p>
      <div class="btn-row">
        <a
          href="/consultation/"
          class="btn btn--primary"
          data-track="cta_click"
          data-track-cta="consultation"
          data-track-location="plan_hero"
        >Start with the free consultation</a>
        <a
          href="/contact/?quote=1"
          class="btn btn--ghost"
          data-track="cta_click"
          data-track-cta="quote"
          data-track-location="plan_hero"
        >Get a quote</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label">{c.stepOneLabel}</p>
      <h2>{c.stepOneTitle}</h2>
      <p>{c.stepOneBody}</p>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <p class="label">{c.fragmentsLabel}</p>
      <h2>{c.fragmentsTitle}</h2>
      <p>{c.fragmentsBody}</p>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <p class="label">{c.deliverablesLabel}</p>
      <h2>{c.deliverablesTitle}</h2>
      <div class="grid grid--3" style="margin-top: 2.5rem;">
        {c.deliverables.map((d) => (
          <div class="card" style="background: transparent; border-color: #3c3a32; color: var(--cream);">
            <h3>{d.title}</h3>
            <p>{d.body}</p>
          </div>
        ))}
      </div>
      {c.proofNote && (
        <p class="small" style="margin-top: 1.75rem; color: var(--stone);">
          {c.proofNote} <a href="/work/" style="color: var(--sage);">{c.proofLinkLabel} →</a>
        </p>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label">{c.timelineLabel}</p>
      <h2>{c.timelineTitle}</h2>
      <div class="table-wrap" style="margin-top: 2rem;">
        <table>
          <thead>
            <tr><th scope="col">When</th><th scope="col">What happens</th></tr>
          </thead>
          <tbody>
            {c.timeline.map((row) => (
              <tr><td>{row.when}</td><td>{row.what}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <p class="label">{c.fitLabel}</p>
      <h2>{c.fitTitle}</h2>
      <ul class="checklist" style="margin-top: 1.5rem;">
        {c.fits.map((fit) => (
          <li><strong>{fit.title}:</strong> {fit.body}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--bamboo">
    <div class="container">
      <p class="label">{c.pricingLabel}</p>
      <h2 style="margin-bottom: 1.5rem;">{c.pricingTitle}</h2>
      <div class="card" style="background: var(--cream); border-color: transparent; color: var(--charcoal); max-width: 44rem;">
        <p>{c.pricingBody}</p>
        <div class="btn-row" style="margin-top: 1rem;">
          <a
            href="/contact/?quote=1"
            class="btn btn--primary"
            data-track="cta_click"
            data-track-cta="quote"
            data-track-location="plan_pricing"
          >{c.pricingCtaLabel}</a>
          <span class="small">{c.pricingCtaNote}</span>
        </div>
      </div>
      <p class="small" style="margin-top: 1.5rem; color: var(--cream);">{c.pricingAfterNote}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label">{c.faqLabel}</p>
      <h2>{c.faqTitle}</h2>
      <div style="margin-top: 2rem; max-width: 46rem;">
        {c.faqs.map(({ q, a }) => (
          <details style="border-bottom: 1px solid var(--line); padding-block: 1rem;">
            <summary style="font-family: var(--font-serif); font-size: 1.2rem; cursor: pointer;">{q}</summary>
            <p style="margin-top: 0.75rem;">{a}</p>
          </details>
        ))}
      </div>
      <div class="btn-row" style="margin-top: 2.5rem;">
        <a
          href="/consultation/"
          class="btn btn--primary"
          data-track="cta_click"
          data-track-cta="consultation"
          data-track-location="plan_faq"
        >Start with the free consultation</a>
        <span class="small">{c.ctaNote}</span>
      </div>
    </div>
  </section>
</Base>
