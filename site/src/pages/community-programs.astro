---
import Base from '../layouts/Base.astro';
import { getDoc } from '../lib/sanity.js';

const c = await getDoc('communityProgramsPage');
---
<Base
  title="Community programs — Panta"
  description="Work Panta builds and runs, not a service you hire: programs that put advancement, enrichment, and connection within reach of the communities that need them."
>
  <section class="section section--dark hero" style="padding-block: clamp(3.5rem, 8vw, 6rem);">
    <div class="container">
      <p class="label">{c.heroLabel}</p>
      <h1 style="font-size: clamp(2.2rem, 4.5vw, 3.4rem);">{c.heroTitle}</h1>
      <p class="lede">{c.heroLede}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label">{c.gridLabel}</p>
      <h2>{c.gridTitle}</h2>
      <div class="grid grid--3" style="margin-top: 2.5rem;">
        {c.cards.map((card) => (
          <div class="card">
            <p class="card__kicker">{card.kicker}</p>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--bamboo">
    <div class="container">
      <p class="label">{c.ctaLabel}</p>
      <h2>{c.ctaTitle}</h2>
      <p class="lede" style="max-width: 54ch;">{c.ctaLede}</p>
      <div class="btn-row" style="margin-top: 1.5rem;">
        <a
          href="/contact/"
          class="btn btn--primary"
          data-track="cta_click"
          data-track-cta="contact"
          data-track-location="community_cta"
        >{c.ctaPrimaryLabel}</a>
        {/* The services overview — these pages are our own work, not services,
            so the escape hatch points at what clients can actually hire. */}
        <a
          href="/services/"
          class="btn btn--ghost"
          data-track="cta_click"
          data-track-cta="web_strategy"
          data-track-location="community_cta"
        >{c.ctaSecondaryLabel}</a>
      </div>
    </div>
  </section>
</Base>
