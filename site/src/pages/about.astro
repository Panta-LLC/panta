---
import Base from '../layouts/Base.astro';
import RippleMark from '../components/RippleMark.astro';
import { getDoc } from '../lib/sanity.js';

const c = await getDoc('aboutPage');
---
<Base
  title="About Panta — a friendly partner in the growth of your mission"
  description="Panta LLC supports community-based businesses and organizations with web and software development, business process improvement, and creative design — strategy and engineering from the same hands."
>
  <section class="section section--dark hero" style="padding-block: clamp(3.5rem, 8vw, 6rem);">
    <div class="container">
      <p class="label">{c.heroLabel}</p>
      <h1 style="font-size: clamp(2.2rem, 4.5vw, 3.2rem);">{c.heroTitle}</h1>
      <p class="lede">{c.heroLede}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--2" style="gap: 3rem; align-items: start;">
        <div>
          <p class="label">{c.believeLabel}</p>
          <h2>{c.believeTitle}</h2>
          <p>{c.believeBody1}</p>
          <p>{c.believeBody2}</p>
        </div>
        <div>
          <p class="label">{c.doLabel}</p>
          <ul class="checklist">
            {c.doItems.map((item) => (
              <li>
                {item.href ? (
                  <strong><a href={item.href}>{item.title}</a></strong>
                ) : (
                  <strong>{item.title}</strong>
                )}
                {' '}{item.body}
              </li>
            ))}
          </ul>
          <p class="small" style="margin-top: 1rem;">
            {c.doNote}
            {' '}<a href="/community-programs/">Community Program Development</a>
            {' · '}<a href="/product-development/">Product Development</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--bamboo">
    <div class="container" style="display: grid; gap: 2rem; justify-items: start;">
      <RippleMark size={56} />
      <div>
        <h2>{c.rippleTitle}</h2>
        <p class="lede" style="max-width: 54ch;">{c.rippleLede}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label">{c.auditLabel}</p>
      <h2>{c.auditTitle}</h2>
      <p>{c.auditBody}</p>
      <div class="btn-row" style="margin-top: 1.5rem;">
        <a
          href="/contact/"
          class="btn btn--primary"
          data-track="cta_click"
          data-track-cta="contact"
          data-track-location="about_cta"
        >{c.auditCtaLabel}</a>
      </div>
    </div>
  </section>
</Base>
