---
import Base from '../layouts/Base.astro';

const faqs = [
  {
    q: 'What does the audit cost?',
    a: 'The Digital Presence Audit is $950 flat. Our first three founding clients get it for $750 in exchange for honest feedback, and nonprofits get 15% off published pricing.',
  },
  {
    q: 'How long does it take?',
    a: 'Ten business days from intake to findings presentation. You get a 45-minute discovery call at the start and a 60-minute walkthrough of the findings at the end, plus the full written report.',
  },
  {
    q: 'Do I have to hire you to fix what you find?',
    a: 'No. Every roadmap item is tagged either DIY — with a guide so you can do it yourself, free — or Project, if it is genuinely worth hiring out. Roughly a third of a typical roadmap is DIY. The report and all findings are yours either way.',
  },
  {
    q: 'What do you need from me?',
    a: 'A 20-minute intake questionnaire and viewer-level access to accounts like Google Analytics and your Google Business Profile. We send guides for each — and if you are locked out of something, that itself is a finding worth knowing.',
  },
  {
    q: 'What if my situation is unusual?',
    a: 'The audit adapts to your segment. Nonprofits get donor, volunteer, and grantmaker paths audited separately plus a Google Ad Grant check. Licensed clinicians get review guidance that respects your ethics code. E-commerce gets checkout-flow and product-feed coverage.',
  },
];

const auditSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Digital Presence Audit',
    serviceType: 'Digital marketing audit',
    provider: { '@type': 'ProfessionalService', name: 'Panta LLC', url: 'https://panta.co' },
    description:
      'A fixed-scope, fixed-price diagnostic of how your organization shows up online — every channel graded, the biggest money leaks identified, and a prioritized 90-day roadmap delivered in 10 business days.',
    offers: {
      '@type': 'Offer',
      price: '950',
      priceCurrency: 'USD',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  title="The Digital Presence Audit — Panta"
  description="A 10-day, fixed-price diagnostic of your entire online presence: every channel graded, your top money leaks identified, and a 90-day roadmap that separates DIY fixes from projects worth hiring out. $950."
  schema={auditSchema}
>
  <section class="section section--dark hero" style="padding-block: clamp(3.5rem, 8vw, 6rem);">
    <div class="container">
      <p class="label">The Digital Presence Audit</p>
      <h1 style="font-size: clamp(2.2rem, 4.5vw, 3.4rem);">Know exactly where your online presence is leaking — and what to fix first.</h1>
      <p class="lede">
        A fixed-scope, fixed-price diagnostic. In 10 business days you'll see
        every place your organization exists online, what's working, what's
        quietly costing you customers or donors, and a prioritized plan —
        honest about what you can do yourself.
      </p>
      <div class="btn-row">
        <a href="/contact/" class="btn btn--primary">Book a free 20-minute call</a>
        <span class="small">$950 flat · founding clients $750 · nonprofits 15% off</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label">What you get</p>
      <h2>Six deliverables. No filler.</h2>
      <div class="grid grid--3" style="margin-top: 2.5rem;">
        <div class="card">
          <h3>Presence Scorecard</h3>
          <p>
            Forty checks graded across four categories — Visibility, Trust,
            Conversion, Systems. The headline isn't your average; it's your
            bottleneck.
          </p>
        </div>
        <div class="card">
          <h3>Entry Point Map</h3>
          <p>
            A visual map of every channel where you exist, how they connect,
            and where the gaps are. Most organizations are surprised by what's
            on it.
          </p>
        </div>
        <div class="card">
          <h3>Top 3 Money Leaks</h3>
          <p>
            The biggest problems in plain language, with a dollar estimate of
            what each one costs you per month.
          </p>
        </div>
        <div class="card">
          <h3>90-Day Roadmap</h3>
          <p>
            Every fix, prioritized. Each item tagged <strong>DIY</strong> (you
            can do this yourself — here's how) or <strong>Project</strong>
            (worth hiring out). About a third is typically DIY.
          </p>
        </div>
        <div class="card">
          <h3>Baseline Metrics</h3>
          <p>
            Your "before" picture — traffic, rankings, reviews, response times —
            so improvement gets measured, not guessed. We re-score free at 90
            days.
          </p>
        </div>
        <div class="card">
          <h3>Findings Presentation</h3>
          <p>
            A 60-minute live walkthrough of everything, in language you can act
            on. Bring whoever makes decisions.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <p class="label">How it works</p>
      <h2>Ten business days, start to finish.</h2>
      <div class="table-wrap" style="margin-top: 2rem;">
        <table>
          <thead>
            <tr><th scope="col">Days</th><th scope="col">What happens</th></tr>
          </thead>
          <tbody>
            <tr><td>Day 0</td><td>Intake questionnaire sent — about 20 minutes of your time, plus account access guides.</td></tr>
            <tr><td>Days 1–2</td><td>45-minute discovery call. We audit against <em>your</em> goals, not generic best practices.</td></tr>
            <tr><td>Days 3–7</td><td>Analysis: automated scans, manual channel review, and a real walkthrough of your conversion path — as a customer would experience it.</td></tr>
            <tr><td>Days 8–9</td><td>Report assembly.</td></tr>
            <tr><td>Day 10</td><td>60-minute findings presentation. Written report delivered — it's yours, whatever you decide next.</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label">Made to fit</p>
      <h2>The audit adapts to how your world actually works.</h2>
      <ul class="checklist" style="margin-top: 1.5rem;">
        <li>
          <strong>Nonprofits:</strong> donor, volunteer, and grantmaker paths
          audited separately; Candid/GuideStar presence; and a Google Ad Grant
          check — $10,000/month in free search ads most organizations leave
          unclaimed or misconfigured.
        </li>
        <li>
          <strong>Professional practices:</strong> directories like Psychology
          Today and Healthgrades often out-traffic your website. We audit them
          first — with review guidance built around what your ethics code
          allows.
        </li>
        <li>
          <strong>E-commerce:</strong> product feeds, marketplace presence,
          checkout friction, and abandonment recovery — the places where speed
          and follow-through are directly revenue-linked.
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--bamboo">
    <div class="container">
      <p class="label">Pricing</p>
      <h2 style="margin-bottom: 1.5rem;">One flat price. Everything included.</h2>
      <div class="grid grid--3">
        <div class="card" style="background: var(--cream); border-color: transparent; color: var(--charcoal);">
          <p class="label">Digital Presence Audit</p>
          <p class="price-tag">$950</p>
          <p>All six deliverables, the 90-day roadmap, and a free re-score at 90 days.</p>
        </div>
        <div class="card" style="background: var(--cream); border-color: transparent; color: var(--charcoal);">
          <p class="label">Founding clients</p>
          <p class="price-tag">$750</p>
          <p>Our first three clients, in exchange for honest feedback and a testimonial if we earn it.</p>
        </div>
        <div class="card" style="background: var(--cream); border-color: transparent; color: var(--charcoal);">
          <p class="label">Nonprofits</p>
          <p class="price-tag">15% off</p>
          <p>On published pricing, always. Supporting community missions is why Panta exists.</p>
        </div>
      </div>
      <p class="small" style="margin-top: 1.5rem; color: var(--cream);">
        Need things built afterward? Roadmap projects are scoped separately —
        brand foundations, web builds, custom tools, and ongoing growth support.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label">Questions</p>
      <h2>The things people ask first.</h2>
      <div style="margin-top: 2rem; max-width: 46rem;">
        {faqs.map(({ q, a }) => (
          <details style="border-bottom: 1px solid var(--line); padding-block: 1rem;">
            <summary style="font-family: var(--font-serif); font-size: 1.2rem; cursor: pointer;">{q}</summary>
            <p style="margin-top: 0.75rem;">{a}</p>
          </details>
        ))}
      </div>
      <div class="btn-row" style="margin-top: 2.5rem;">
        <a href="/contact/" class="btn btn--primary">Book a free 20-minute call</a>
        <span class="small">No pitch, no pressure. If the audit isn't the right move, we'll say so.</span>
      </div>
    </div>
  </section>
</Base>
