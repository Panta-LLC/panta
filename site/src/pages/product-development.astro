---
import Base from '../layouts/Base.astro';
import { getDoc } from '../lib/sanity.js';

const c = await getDoc('productDevelopmentPage');
---
<Base
  title="Product Development — Panta"
  description="Panta's product practice, taking root now: new ideas for old problems, built into products that serve community needs."
>
  <section class="section section--dark hero" style="padding-block: clamp(3.5rem, 8vw, 6rem);">
    <div class="container">
      <p class="label">{c.heroLabel}</p>
      <h1 style="font-size: clamp(2.2rem, 4.5vw, 3.4rem);">{c.heroTitle}</h1>
      <p class="lede">{c.heroLede}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label">{c.gridLabel}</p>
      <h2>{c.gridTitle}</h2>
      <div class="grid grid--3" style="margin-top: 2.5rem;">
        {c.cards.map((card) => (
          <div class="card">
            <p class="card__kicker">{card.kicker}</p>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--bamboo">
    <div class="container">
      <p class="label">{c.ctaLabel}</p>
      <h2>{c.ctaTitle}</h2>
      <p class="lede" style="max-width: 54ch;">{c.ctaLede}</p>
      <div class="btn-row" style="margin-top: 1.5rem;">
        <a
          href="/contact/"
          class="btn btn--primary"
          data-track="cta_click"
          data-track-cta="contact"
          data-track-location="product_cta"
        >{c.ctaPrimaryLabel}</a>
        {/* Was "/" — which dropped the visitor back at the top of the mission
            scroll. Points at the practice that's live instead. Paired Sanity
            edit: ctaSecondaryLabel must no longer say "read the mission". */}
        <a
          href="/web-strategy/"
          class="btn btn--ghost"
          data-track="cta_click"
          data-track-cta="web_strategy"
          data-track-location="product_cta"
        >{c.ctaSecondaryLabel}</a>
      </div>
    </div>
  </section>
</Base>
