  .hero__sub { animation-delay: 0.14s; }
  .hero__quiet { animation-delay: 0.22s; }
  .hero__svc .kicker { animation-delay: 0.18s; }
  .svc-index li:nth-child(1) { animation-delay: 0.26s; }
  .svc-index li:nth-child(2) { animation-delay: 0.31s; }
  .svc-index li:nth-child(3) { animation-delay: 0.36s; }
  .svc-index li:nth-child(4) { animation-delay: 0.41s; }
  .svc-index li:nth-child(5) { animation-delay: 0.46s; }
  .svc-index li:nth-child(6) { animation-delay: 0.51s; }
  .hero__act > * { animation-delay: 0.30s; }

  /* Mobile puts .hero__act first (order: -1), so the button must animate on an
     early beat or it visibly lags the copy it now sits above. */
  @media (max-width: 899px) {
    .hero__act > * { animation-delay: 0.20s; }
