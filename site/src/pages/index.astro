---
import '@fontsource/ibm-plex-mono/400.css';
import Base from '../layouts/Base.astro';
import RippleMark from '../components/RippleMark.astro';
import SectionViews from '../components/SectionViews.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import Placeholder from '../components/Placeholder.astro';
import PulseTerm from '../components/PulseTerm.astro';
import LeadForm from '../components/LeadForm.astro';
/* Package copy is rich text now. Rendered here rather than through a component
   because Astro scopes `.pkg-card__list li` to this file — an <li> emitted by a
   child component carries that component's scope id and none of these rules. */
import { listItems, paragraphs } from '../lib/portable.js';
import { getDoc, getFeaturedCaseStudy, getPackages, getPillars, getPosts, getProjects, getServices } from '../lib/sanity.js';
import { packageHref } from '../lib/packages.js';
import { serviceHref } from '../lib/pillars.js';
import { faqSchema } from '../lib/schema.js';

// Homepage per PULSE-HOME-BUILD.md §4 and panta-homepage-copy.md. Nine
// sections, every CTA routing to the Pulse Check except the editorial strip.
//
// Copy lives in this file rather than Sanity by design: the brief's schema (§6)
// puts only the DYNAMIC slots in the CMS — trust bar logos, featured case
// study, newsletter blurb, Pulse posts. Section prose is launch copy from the
// deck and is version-controlled with it.
//
// Two exceptions, both because the same copy appears on more than one page and
// drifted when it was duplicated: the hero (Home hero singleton) and the three
// pillars (`pillar` documents, also rendered on the services overview).
const settings = await getDoc('siteSettings');

// Hero copy is editable in the Studio (Home hero). Every field falls back to
// the launch copy from panta-homepage-copy.md §1, so an empty or missing
// document renders the shipped page rather than a blank hero — and the deck's
// alternate headlines can be tested without a deploy.
const hero = (await getDoc('homeHero')) ?? {};
const HERO = {
  // The mission, not the audience. `*asterisks*` mark the accented phrase; see
  // HEADLINE_WORDS. There is no eyebrow above this by design — the subhead now
  // names who the page is for, and a category label plus a mission line plus a
  // range line is three qualifications before the first ask.
  headline: hero.headline || 'Built to serve the people *who serve people.*',
  // Audience and range in one breath: who it's for, then the span of what is
  // on offer. The range named here must match the cards under the CTA — an
  // earlier draft promised marketing and custom software, neither of which has
  // a service page to land on, so the reader met the word and then a wall.
  // Widen this line the day those two services exist in the Studio, not before.
  subhead:
    hero.subhead ||
    'A full-service partner for private practices, community organizations, and local businesses — websites, brand, content, and operations, under one roof.',
  ctaLabel: hero.ctaLabel || 'Get a free website review',
  // The deliverable, in the line the button owns. The Pulse Check name stays
  // here because PulseTerm needs it to hang the definition on, and because the
  // button itself must pass the no-context test without it.
  ctaMicrocopy:
    hero.ctaMicrocopy || 'We call it the Pulse Check · 30 minutes + a written action plan in 48 hours',
  // Directly under the ask, where the objection is actually forming. Says the
  // same thing as PulseTerm's tooltip, out loud, for the reader who never
  // hovers anything.
  //
  // A fragment, not a sentence, and deliberately missing its subject: the line
  // directly above already named the action plan, and saying the noun twice in
  // twenty-four words made this read as a restatement of the spec rather than a
  // promise added to it. Without it, the two lines are one thought — what you
  // get, then what it costs you. PulseTerm's tooltip still carries the whole
  // sentence for anyone who wants it (PulseTerm.astro's `tip` default).
  riskReversal: hero.riskReversal || 'Yours to keep, whether we work together or not.',
  secondaryLabel: hero.secondaryLabel || 'See client work',
  // Names only, one line. The section carried a testimonial for exactly one
  // revision; it costs ~90px of fold and Arielle's words do more work beside
  // her own case study than floating above it.
  trustedByLabel: hero.trustedByLabel || 'Trusted by',
  trustedBy:
    hero.trustedBy ||
    'Delta Bay Impact · Arielle Rae Hastings Therapy · + small businesses across Northern California',
};
// The headline animates per word, so it has to be split here rather than in
// JS — splitting after paint would mean rewriting the LCP element's DOM.
//
// Text between *asterisks* is the accented phrase — the emotional anchor of the
// claim, set in sage against the cream. Marked inline in the string rather than
// in a second field so the whole headline stays one editable text area, and so
// a headline written without markers simply renders unaccented.
//
// Split on the marker rather than testing each word for one: the phrase is
// delimited at its ends, so a word in the MIDDLE of it carries no asterisk and
// a per-word test drops it out of the emphasis. Odd segments are the inside.
const HEADLINE_WORDS = HERO.headline
  .split('*')
  .flatMap((segment, i) =>
    segment
      .split(/\s+/)
      .filter(Boolean)
      .map((text) => ({ text, accent: i % 2 === 1 })),
  );
const TRUSTED_BY_LINES = HERO.trustedBy.split('\n').filter(Boolean);

// The service cards, inside the hero directly under the CTA. They replaced the
// scrolling services band that used to sit immediately below this section:
// same list, same source, same links — a band under a grid of the same six
// names is the list printed twice within one screen.
//
// Sanity like every other enumeration of the services (Base's nav,
// /services/); `indexLabel` is the short form written for exactly this kind of
// tight slot, title the fallback. The grid renders nothing at all if the list
// is empty rather than an empty rack.
//
// The count is data, not layout: whatever is `listed` in the Studio appears
// here, and CARD_COLUMNS below keeps the result a full rectangle. Adding the
// two services the subhead promises but the Studio does not yet hold —
// digital marketing, custom software — is a Studio job, not a code change.
const SERVICE_CARDS = ((await getServices()) ?? []).map((s) => ({
  label: s.indexLabel || s.title,
  href: serviceHref(s),
}));
// Three columns when the count divides by three, two otherwise — so four cards
// are 2x2 rather than a row of three with an orphan under it.
const CARD_COLUMNS = SERVICE_CARDS.length % 3 === 0 ? 3 : 2;

const caseStudy = await getFeaturedCaseStudy();
const posts = await getPosts(3);

// The Pulse Check page. Use this only where the label promises READING —
// "Learn more", the Pulse Check definition tooltip. It lands at the top of the
// page, ~3.3 screens above the scheduler.
const BOOK = '/consultation/';
// Deep link straight to the scheduler embed, for buttons whose label promises
// BOOKING. #book is the booking section on /consultation/, at 49% of that
// page — so a "Book…" button pointed at BOOK instead of this one costs the
// visitor an extra click and a three-screen scroll after they had already
// decided. html has scroll-padding-top so the anchor clears the sticky header.
const BOOK_FORM = '/consultation/#book';

const PILLARS = await getPillars();

// §1.5 — the packages grid, and now the page's first answer to "what does
// Panta sell". It replaced the hero's "What we do" service index rather than
// joining it: the index listed capabilities, this names what someone can buy,
// and the two a screen apart read as the same list written twice. Sanity-driven
// so the set is data — `listed` toggles a card off exactly as it does a
// service — and packageHref() owns where a card points, which is how a package
// still routes into its service page without anything here hardcoding a URL.
const PACKAGES = await getPackages();

// The strings around the cards — kicker, heading, the price band, and the label
// on each card's expander. Same fallback contract as the hero: the shipped copy
// is the default, so an absent or half-filled `homePackages` document renders
// the page as written rather than a blank kicker.
const pkgSection = (await getDoc('homePackages')) ?? {};
const PKGS = {
  kicker: pkgSection.kicker || 'Our Services',
  heading: pkgSection.heading || 'We offer distinct services to help you grow your business.',
  // The band, restating the FAQ's own numbers in the place they qualify people.
  // Rendered with set:html for the one <strong>; it is a fixed string in this
  // file or a plain line from the Studio, never visitor input.
  priceNote:
    pkgSection.priceNote ||
    'Most projects land between <strong>$2,000 and $10,000</strong>, depending on scope — quoted at a fixed price, in writing, before anything starts.',
  expandLabel: pkgSection.expandLabel || 'What’s included',
};


const STEPS = [
  {
    n: '1',
    title: 'Pulse Check.',
    // Deliberately does NOT restate the offer: §4.4 pitches it in full about a
    // screen above this, and the two ran word-for-word identical. A process
    // step should say what happens, not re-sell what was already sold.
    body: 'In 30 minutes, we discuss where things stand today and explore the best path forward. You tell us your top priorities and we share our recommendations on what the best first step might be. We follow up with a written summary, which you can use to make a decision or hand off to someone else.',
  },
  {
    n: '2',
    title: 'Plan together.',
    body: 'We follow up on the Pulse Check with a detailed plan of action, agree on a scope of work, set a timeline, and get started. The path forward is always in your hands.'
  },
  {
    n: '3',
    title: 'Build and support.',
    body: 'We execute on the plan, review progress on an agreed-upon cadence, and make adjustments as needed. We stay reachable and responsive to your feedback and questions. Upon delivery, we hand over the project, answer any final questions, and offer ongoing support as agreed upon.',
  },
];

// The §4.2 trust bar is gone: the case study now occupies that slot, and a row
// of two logos under "trusted by" was doing less work than the work itself.
// `siteSettings.trustBarClients` and getTrustBarLogos() are untouched — no
// other page reads them today, but the curation still exists in the Studio if
// a logo wall is ever wanted back.

// §4.6 — the case section showed one project while two exist. Both now render
// as full previews: the featured study first, then the rest of /work/. Nothing
// here is new content, and the two queries project the same fields the card
// needs (name, thumbnail, summary, outcome, slug, client.sector), so they
// compose into one list without a shape mismatch.
const otherProjects = ((await getProjects()) ?? [])
  .filter((p) => p.slug && p.slug !== caseStudy?.slug);
const CASES = [caseStudy, ...otherProjects].filter(Boolean).slice(0, 2);

// The objection set, placed immediately before the ask. Launch prose, so it
// lives here rather than in Sanity for the same reason STEPS does (see the
// header comment): these are claims about how Panta works, and the copy bans
// in check-launch.mjs are a build-time grep — copy that must clear a lint
// belongs where the lint runs. If these ever need editing without a deploy,
// `homeHero` is the right home; it already declares itself that exception.
//
// Note question 1: "fixed price, plain terms" is promised in STEPS[1] and no
// number appears anywhere on the site. This is where that gets an answer.
const FAQS = [
  {
    q: 'What does working together cost?',
    // The band is the point: this FAQ sits immediately before the ask, and its
    // job is to let a visitor decide whether to book WITHOUT having to book to
    // find out. The process detail follows the number rather than replacing it.
    a: 'Most projects land between $2,000 and $10,000, depending on scope. Everything is quoted at a fixed price in writing before anything starts — no hourly billing, no retainers you don’t understand. The review is free, and if your budget is smaller than that we’ll tell you honestly whether there’s a version worth doing.',
  },
  {
    q: 'How long does it take?',
    // Commits to the SHAPE (weeks, not quarters) plus the three milestones
    // already promised elsewhere on the site — 30 minutes, 48 hours, a date
    // agreed before work starts. No invented duration.
    a: 'Most projects are scoped to finish in weeks, not quarters — we deliberately keep them small enough to land. The review itself is 30 minutes and your written readout follows within 48 hours. If we go ahead, you get a scope and a timeline in writing before any work begins.',
  },
  {
    q: 'What if we decide not to work together?',
    a: 'We aim to provide you value each step of the way. Our goal is to be available for you and deliver the best possible results within our scope of work. When that work is complete, we hope you continue to use Panta as a partner and a resource, but you are under no obligation outside of our agreed-upon scope of work.',
  },
  {
    q: 'Are we locked in afterward?',
    a: 'No. Each project is delivered with your ownership and control. We are always available to answer questions and provide support, but you are not locked in to working with us. You can continue to use Panta as a partner and a resource, or you can choose to work with someone else.'
  },
];
---
{/* The title is deliberately NOT derived from HERO.headline: the headline is
    meant to be A/B tested from the Studio, and the title tag should not churn
    with it — nor inherit a headline longer than the ~60 characters search
    results display. */}
<Base
  title="Panta — Digital, strategic, and creative support"
  description="Panta helps small businesses and community organizations get found, run smoother, and tell their story — without the agency runaround."
  schema={[faqSchema(FAQS)].filter(Boolean)}
>
  {/* Parser-blocking on purpose. It runs before the hero is painted, which is
      the whole point: it stamps the pre-animation hidden state on <html> so
      there is no flash of final-position text before the timeline starts.
      Everything it does is conditional on motion being wanted, and the watchdog
      guarantees the copy appears even if the GSAP module below never loads. */}
  <script is:inline>
    (() => {
      const root = document.documentElement;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      root.dataset.heroIntro = 'pending';
      window.__heroIntroWatchdog = window.setTimeout(() => {
        root.dataset.heroIntro = 'done';
      }, 1500);
    })();
  </script>

  <!-- ===================== 1. hero ===================== -->
  <!-- Centred on a charcoal surface, with the mark run as a background graphic
       off the right edge. The claim, the one filled button, and a quiet route
       to the work — the right-hand "What we do" service index used to live
       here and came out when §1.5 landed, because the two said the same thing
       a screen apart and the index said it in weaker words. The services are
       now named directly under this section by the marquee, /services/ is one
       click away in the nav, and every package card routes into a service.
       The rule that survives from §3/§4.1 is the important half: nothing in
       this section may compete with the one filled button. -->
  <section class="hero" id="top" data-section="hero">
    {/* The mark as environment rather than as an element: off the right edge at
        ~30x its header size, roughly two thirds of it in frame.

        Inlined rather than <RippleMark /> because the component fixes what this
        needs to vary — a pixel size, and a currentColor that would inherit the
        hero's text colour at full strength. Same drawing either way: every
        value here is the component's own, normalised from its 48 box to this
        100 box. Radii 21/13.5/6 → 43.75/28.125/12.5, stroke weights 1.4/2.2/3.4
        → 2.917/4.583/7.083. Both must scale together — scaling the radii while
        leaving the strokes near-hairline flattens it, because the mark's whole
        character is that it thickens inward.

        aria-hidden with no title: it carries no information the copy does not,
        and the real mark is already announced in the header. */}
    <div class="hero__bg" data-hero="bg" aria-hidden="true">
      <svg class="hero__mark" viewBox="0 0 100 100" fill="none" focusable="false">
        <circle class="hero__ring" cx="50" cy="50" r="43.75" stroke-width="2.917" />
        <circle class="hero__ring" cx="50" cy="50" r="28.125" stroke-width="4.583" />
        <circle class="hero__ring hero__ring--accent" cx="50" cy="50" r="12.5" stroke-width="7.083" />
      </svg>
    </div>

    <div class="container hero__grid">
      <div class="hero__claim">
        {/* Each word is a mask (overflow:hidden) wrapping the glyphs, so the
            intro stagger reads as type rising out of the line rather than
            fading. Split server-side: doing it in JS would mean rewriting the
            LCP element's DOM after paint. */}
        <h1 class="hero__headline">
          {HEADLINE_WORDS.map((word) => (
            <span class="hero__word">
              <span class:list={['hero__word-in', word.accent && 'hero__word-in--accent']}>{word.text}</span>
            </span>
          ))}
        </h1>
        <p class="hero__sub" data-hero="sub">{HERO.subhead}</p>

        <div class="hero__act" data-hero="act">
          <div class="hero__buttons">
            <a
              class="btn btn--filled hero__cta"
              href={BOOK_FORM}
              data-track="cta_click"
              data-track-cta="pulse_check"
              data-track-location="home_hero"
            >{HERO.ctaLabel}</a>
            {/* Quiet by design: §7.3 allows one filled button in this section,
                and a second button here would split the click. */}
            <a
              class="hero__quiet"
              href="/work/"
              data-track="cta_click"
              data-track-cta="work"
              data-track-location="home_hero"
            >{/* Explicit {' '}: the compiler trims a literal space sitting
                  between an expression and an element, and the arrow ends up
                  welded to the last word. */}
              {HERO.secondaryLabel}{' '}<span aria-hidden="true">→</span></a>
          </div>
          <p class="hero__micro" data-hero="micro"><PulseTerm text={HERO.ctaMicrocopy} location="home_hero" /></p>
          <!-- {HERO.riskReversal && <p class="hero__risk">{HERO.riskReversal}</p>} -->
        </div>

        {/* The self-route. Someone who already knows what they need should not
            have to take the free review to find the page about it — these are
            the same services as the nav, one click closer, and they answer
            "what do you actually do" in the place the question gets asked.

            A labelled <nav>, not a decorative rack: it is a list of links to
            elsewhere on the site, which is what makes it navigation. Quiet
            enough not to compete with the one filled button above. */}
        {SERVICE_CARDS.length > 0 && (
          <nav
            class="hero__cards"
            data-hero="cards"
            aria-label="Services"
            style={`--hero-card-cols: ${CARD_COLUMNS}`}
          >
            {SERVICE_CARDS.map((item) => (
              <a
                class="hero__card"
                href={item.href}
                data-track="cta_click"
                data-track-cta="service_card"
                data-track-location="home_hero_services"
              >
                <span>{item.label}</span>
                <span class="hero__card-arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </nav>
        )}

        {/* Names only, under a hairline. Proof belongs in the first screen; a
            full testimonial does not fit in it alongside the cards, and the
            one we have reads better beside its own case study. */}
        {TRUSTED_BY_LINES.length > 0 && (
          <div class="hero__proof" data-hero="proof">
            <p class="hero__proof-clients">
              <strong>{HERO.trustedByLabel}</strong>
              {TRUSTED_BY_LINES.map((line, i) => (
                <Fragment>{i > 0 && <br />}{line}</Fragment>
              ))}
            </p>
          </div>
        )}
      </div>
    </div>
  </section>

  {/* §1.1, the scrolling services band, stood here. It is now the card grid
      inside the hero above — same services, same source, same links, one
      screen earlier and clickable without waiting for a loop to bring the
      label round. Keeping both would have printed the list twice inside a
      single screen. */}

  <!-- ===================== 2. featured case study ===================== -->
  <!-- Was §4.6, four screens down, behind the pillars and the process. It came
       up into the trust bar's slot so the claim is followed closely by the
       evidence for it, which is the move both reference sites make; §1.5 now
       sits between the two, naming the offer the evidence is proof of. The
       logo row that used to sit here is gone — two logos under "trusted by"
       read thinner than the work itself does.
       The sector line and the 48-hour promise survive as the closing strip,
       since they were the rest of what the trust bar was doing. -->
       {CASES.length > 0 && (
        <section class="section case" data-section="case">
          <div class="container">
            <p class="kicker">Recent work</p>
            <div class="case__grid">
              {CASES.map((c, i) => (
                <article class="case__item">
                  {/* Tracked like the text link below it: without this, clicks on
                      the image read as zero engagement while the identical link
                      underneath gets the credit. */}
                  <a
                    class="case__media"
                    href={`/work/${c.slug}/`}
                    tabindex="-1"
                    aria-hidden="true"
                    data-track="cta_click"
                    data-track-cta={i === 0 ? 'case_study_image' : 'case_study_secondary_image'}
                    data-track-location="home_case"
                  >
                    {c.thumbnail ? (
                      <img src={c.thumbnail.replace('-thumb', '')} alt="" loading="lazy" decoding="async" />
                    ) : (
                      <div class="case__media-empty"></div>
                    )}
                  </a>
                  {/* The quote moved up to the pillars close, so each preview leads
                      on the client's name — it says what the work was, which is
                      what a visitor is here for by this point. */}
                  <h2 class="case__head">{c.name}</h2>
                  <p class="case__meta">{c.client?.sector ?? c.clientType}</p>
                  <p class="case__body">{c.summary}</p>
    
                  {/* `project.contributions` — the scope of the engagement. It says
                      what Panta actually did, which the summary describes and the
                      outcome doesn't. Inline rather than stacked rows: three items
                      as hairline rows would be taller than the summary above it. */}
                  {(c.contributions ?? []).length > 0 && (
                    <div class="case__did">
                      <p class="kicker">What we did</p>
                      <p class="case__did-list">{c.contributions.join(' · ')}</p>
                    </div>
                  )}
    
                  {/* §7.4 still holds — nothing here may be invented. What changed
                      is that the slot no longer demands a NUMBER: `project.outcome`
                      is a real field ("Short outcome line shown on cards") the
                      query already selects, so a true sentence fills it. The
                      blocking placeholder is kept for the FEATURED case only:
                      making every card demand one would add launch blockers for
                      secondary work that was never promised an outcome line. */}
                  {c.outcome ? (
                    <p class="case__outcome">{c.outcome}</p>
                  ) : i === 0 ? (
                    <p class="case__outcome-ph">
                      <Placeholder note={`the outcome line for ${c.name} — a sentence, not a number`}>
                        [What changed for them — one sentence]
                      </Placeholder>
                    </p>
                  ) : null}
    
                  <a
                    class="case__link"
                    href={`/work/${c.slug}/`}
                    data-track="cta_click"
                    data-track-cta={i === 0 ? 'case_study' : 'case_study_secondary'}
                    data-track-location="home_case"
                  >Read the full story <span aria-hidden="true">→</span></a>
                </article>
              ))}
            </div>
          <div class="case__view-all" style="margin-top:4rem;">
            <a
              class="case__link case__link--all"
              href="/work/"
              data-track="cta_click"
              data-track-cta="view_all_work"
              data-track-location="home_case"
            >
              View all work <span aria-hidden="true">→</span>
            </a>
          </div>
 
 
          </div>
    
          {/* <div class="container case__trust">
            <p class="case__trust-claim">
              Nonprofits, independent practitioners, and small businesses across Northern California.
            </p>
            <p class="case__trust-promise">
              Free 30-minute review · written readout within 48 hours · yours to keep either way
            </p>
          </div> */}
        </section>
      )}

  <!-- ===================== 1.5 packages ===================== -->
  <!-- Fixed-scope offers, from Sanity. The kicker is "Where to start" rather
       than "What we do" on purpose: the hero owns that phrase and §4 owns
       "services", and three headings saying the same thing is how a page
       starts repeating itself. This one has a different job — it names what a
       visitor can actually buy.
       No .btn--filled anywhere here. The homepage already spends both (hero +
       closing form) and check-launch.mjs caps it at two; these are text links
       for the same reason the hero index is hairline rows. -->
  {PACKAGES.length > 0 && (
    <section class="section pkgs" id="packages" data-section="packages">
      <div class="container">
        <p class="kicker">{PKGS.kicker}</p>
        <h2 class="pkgs__head">{PKGS.heading}</h2>
        {PKGS.priceNote && (
          <p class="pkgs__price" set:html={PKGS.priceNote} />
        )}
        <div class="pkg-grid">
          {PACKAGES.map((p) => {
            /* A package with no page and no service reference has nowhere to
               send anyone. Its title renders as plain text rather than an
               anchor to '#' — a card that leads nowhere should not look
               clickable. */
            const href = packageHref(p);
            /* Both are HTML strings, one per paragraph / per bullet. Extracted
               rather than length-checked on the raw field: an empty editor is a
               one-block array holding an empty span — truthy, and worth nothing
               on the page. */
            const summary = paragraphs(p.summary);
            const bullets = listItems(p.bullets);
            return (
              /* A div, not an <a>: the card now contains a <details>, and
                 interactive content inside an anchor is invalid and swallows
                 the toggle's clicks. Whole-card clickability comes back via
                 .pkg-card__anchor::after, which covers the card — the same
                 hit area, with the expander lifted above it. */
              <div class:list={['pkg-card', { 'pkg-card--link': href }]}>
                <h3 class="pkg-card__name">
                  {href ? (
                    <a
                      class="pkg-card__anchor"
                      href={href}
                      data-track="cta_click"
                      data-track-cta={`package_${p.slug}`}
                      data-track-location="home_packages"
                    >{p.title}</a>
                  ) : p.title}
                </h3>
                {p.priceFrom && <p class="pkg-card__price">{p.priceFrom}</p>}
                {summary.map((html) => <p class="pkg-card__body" set:html={html} />)}
                {/* The card reads as heading + blurb; the inclusions are one
                    click away rather than three-of-N truncated on the face of
                    it. Native <details> for the same reason as the FAQ:
                    keyboard, screen readers and find-in-page all work with no
                    JS. All bullets show now — there is room for them here, so
                    the "first three" rule the card used to impose is gone. */}
                {/* A pill, not a full-width row: it used to be a hairline row
                    stacked directly above "Learn more", and the two read as two
                    items in one list when only one of them is a control of its
                    own — everything else on the card belongs to the card-wide
                    link. Shape carries that difference at a glance, before
                    anyone hovers anything. */}
                {bullets.length > 0 && (
                  <details class="pkg-card__details">
                    <summary class="pkg-card__toggle">
                      <span>{PKGS.expandLabel}</span>
                      <span class="pkg-card__mark" aria-hidden="true"></span>
                    </summary>
                    <ul class="pkg-card__list">
                      {bullets.map((html) => <li set:html={html} />)}
                    </ul>
                  </details>
                )}
                {/* The label for the stretched link, so it spans the card the
                    way the hit area does — arrow pushed to the far edge rather
                    than trailing the words, which is what made a card-wide
                    target look like a short inline one. */}
                {href && (
                  <span class="pkg-card__more">
                    <span class="pkg-card__more-label">Learn more</span>
                    <span class="pkg-card__arrow" aria-hidden="true">→</span>
                  </span>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ===================== 3. problem framing ===================== -->
  <!-- Voice surface: serif, centered, narrow measure. -->
  <!-- <section class="section problem" data-section="problem">
    <div class="container problem__inner">
      <p class="problem__lead">Your work matters to real people in a real place.</p>
      <p class="problem__body">
        But the website hasn’t kept up. The systems live in one person’s head. And the story
        that makes people show up, donate, or book isn’t reaching them.
      </p>
      <p class="problem__turn">You don’t need a digital transformation. You need a partner who gets it.</p>
    </div>
  </section> -->

  <!-- ===================== 4. service pillars ===================== -->
  <!-- Structure surface: sans. Green appears here as the pillar icons only. -->
  <section class="section section--dark" id="services" data-section="pillars">
    <div class="container">
      <h2 class="pillars__head">Three ways we help.</h2>
      {PILLARS.length === 0 && (
        <Placeholder note="the three pillar documents (Studio → Pillars)" />
      )}
      <div class="pillars">
        {/* The mark is chosen by pillar id, not position: pillars are content
            now, and reordering them in the Studio must not hand Creative the
            magnifying glass. The numeral IS positional — it counts columns. */}
        {PILLARS.map((p, i) => (
          <article class="pillar">
            <div class="pillar__rule">
              <span class="pillar__icon" aria-hidden="true">
                {p.id === 'digital' && (
                  <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="7" />
                    <path d="M16.5 16.5L21 21" />
                  </svg>
                )}
                {p.id === 'strategic' && (
                  <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 7h10M4 12h16M4 17h7" />
                    <circle cx="18" cy="7" r="2.2" />
                    <circle cx="14" cy="17" r="2.2" />
                  </svg>
                )}
                {p.id === 'creative' && (
                  <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3l2.4 5.4 5.6.6-4.2 3.9 1.2 5.6L12 15.8 6.9 18.5l1.2-5.6L4 9l5.6-.6z" />
                  </svg>
                )}
              </span>
              <span class="pillar__n" aria-hidden="true">{`0${i + 1}`}</span>
            </div>
            <p class="pillar__kicker">{p.kicker}</p>
            <h3 class="pillar__head">{p.head}</h3>
            <p class="pillar__lede">{p.lede}</p>
            <ul class="pillar__list">
              {(p.bullets ?? []).map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
      <div class="pillars__close">
        {/* The offer and its escape hatch are one column, the actions are the
            other. They were three loose children of a two-column grid, which
            put the button in column two and stranded the escape line back in
            column one under the paragraph, a row down and a long way from the
            thing it is an alternative to. */}
        <div class="pillars__offer">
          <p class="pillars__cta">
