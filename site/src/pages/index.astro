---
import '@fontsource/baloo-2/800.css';
import '@fontsource/ibm-plex-mono/400.css';
import Base from '../layouts/Base.astro';
import RippleMark from '../components/RippleMark.astro';
import SectionViews from '../components/SectionViews.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import Placeholder from '../components/Placeholder.astro';
import PulseTerm from '../components/PulseTerm.astro';
import LeadForm from '../components/LeadForm.astro';
import { getDoc, getFeaturedCaseStudy, getPillars, getPosts, getProjects, getServices } from '../lib/sanity.js';
import { serviceHref, orderServices } from '../lib/pillars.js';
import { faqSchema } from '../lib/schema.js';

// Homepage per PULSE-HOME-BUILD.md §4 and panta-homepage-copy.md. Nine
// sections, every CTA routing to the Pulse Check except the editorial strip.
//
// Copy lives in this file rather than Sanity by design: the brief's schema (§6)
// puts only the DYNAMIC slots in the CMS — trust bar logos, featured case
// study, newsletter blurb, Pulse posts. Section prose is launch copy from the
// deck and is version-controlled with it.
//
// Two exceptions, both because the same copy appears on more than one page and
// drifted when it was duplicated: the hero (Home hero singleton) and the three
// pillars (`pillar` documents, also rendered on the services overview).
const settings = await getDoc('siteSettings');

// Hero copy is editable in the Studio (Home hero). Every field falls back to
// the launch copy from panta-homepage-copy.md §1, so an empty or missing
// document renders the shipped page rather than a blank hero — and the deck's
// alternate headlines can be tested without a deploy.
const hero = (await getDoc('homeHero')) ?? {};
const HERO = {
  headline: hero.headline || 'For organizations that serve people, not algorithms.',
  subhead:
    hero.subhead ||
    'Panta helps small businesses and community organizations get found, run smoother, and tell their story — without the agency runaround.',
  ctaLabel: hero.ctaLabel || 'Book a free 30-minute review',
  ctaMicrocopy: hero.ctaMicrocopy || 'We call it the Pulse Check · written readout in 48 hours',
  secondaryLabel: hero.secondaryLabel || 'See our work',
};
const caseStudy = await getFeaturedCaseStudy();
const posts = await getPosts(3);

// Booking destination. /consultation/ is the Pulse Check page — the URL is
// unchanged so existing inbound links keep working.
const BOOK = '/consultation/';
// Deep link straight to the scheduler embed, for buttons whose label promises
// booking rather than reading. #book is the booking section on /consultation/.
const BOOK_FORM = '/consultation/#book';

// §4.1 — the hero's "What we do" index, from Sanity. Each service links to
// its own page once `pageReady` is set, and to its block on the overview
// before that — serviceHref() owns that decision so nothing here hardcodes
// either form. Every service page ends in its own review CTA, which is what
// makes these scenic routes rather than leaks.
const PILLARS = await getPillars();
const SERVICES = orderServices(PILLARS, await getServices()).map((s) => ({
  label: s.indexLabel ?? s.title,
  href: serviceHref(s),
}));


const STEPS = [
  {
    n: '1',
    title: 'Pulse Check.',
    // Deliberately does NOT restate the offer: §4.4 pitches it in full about a
    // screen above this, and the two ran word-for-word identical. A process
    // step should say what happens, not re-sell what was already sold.
    body: 'In 30 minutes, we discuss where things stand today and explore the best path forward. You tell us your top priorities and we share our recommendations on what the best first step might be. We follow up with a written summary, which you can use to make a decision or hand off to someone else.',
  },
  {
    n: '2',
    title: 'Plan together.',
    body: 'We follow up on the Pulse Check with a detailed plan of action, agree on a scope of work, set a timeline, and get started. The path forward is always in your hands.'
  },
  {
    n: '3',
    title: 'Build and support.',
    body: 'We execute on the plan, review progress on an agreed-upon cadence, and make adjustments as needed. We stay reachable and responsive to your feedback and questions. Upon delivery, we hand over the project, answer any final questions, and offer ongoing support as agreed upon.',
  },
];

// The §4.2 trust bar is gone: the case study now occupies that slot, and a row
// of two logos under "trusted by" was doing less work than the work itself.
// `siteSettings.trustBarClients` and getTrustBarLogos() are untouched — no
// other page reads them today, but the curation still exists in the Studio if
// a logo wall is ever wanted back.

// §4.6 — the case section showed one project while two exist. Both now render
// as full previews: the featured study first, then the rest of /work/. Nothing
// here is new content, and the two queries project the same fields the card
// needs (name, thumbnail, summary, outcome, slug, client.sector), so they
// compose into one list without a shape mismatch.
const otherProjects = ((await getProjects()) ?? [])
  .filter((p) => p.slug && p.slug !== caseStudy?.slug);
const CASES = [caseStudy, ...otherProjects].filter(Boolean).slice(0, 2);

// The objection set, placed immediately before the ask. Launch prose, so it
// lives here rather than in Sanity for the same reason STEPS does (see the
// header comment): these are claims about how Panta works, and the copy bans
// in check-launch.mjs are a build-time grep — copy that must clear a lint
// belongs where the lint runs. If these ever need editing without a deploy,
// `homeHero` is the right home; it already declares itself that exception.
//
// Note question 1: "fixed price, plain terms" is promised in STEPS[1] and no
// number appears anywhere on the site. This is where that gets an answer.
const FAQS = [
  {
    q: 'What does working together cost?',
    a: 'Projects are quoted at a fixed price before anything starts. We start with a free review of your current priorites and goals, and then we can discuss the best path forward. Once a project is scoped, we provide a detailed estimate and proposal, and work to finalize a scope of work within your budget.',
  },
  {
    q: 'How long does it take?',
    a: 'We start with a free 30 minute review of your current situation, then we discuss a scope and timeline that fits your budget and time constraints.',
  },
  {
    q: 'What if we decide not to work together?',
    a: 'We aim to provide you value each step of the way. Our goal is to be available for you and deliver the best possible results within our scope of work. When that work is complete, we hope you continue to use Panta as a partner and a resource, but you are under no obligation outside of our agreed-upon scope of work.',
  },
  {
    q: 'Are we locked in afterward?',
    a: 'No. each project is delivered with your ownership and control. We are always available to answer questions and provide support, but you are not locked in to working with us. You can continue to use Panta as a partner and a resource, or you can choose to work with someone else.'
  },
];
---
{/* The title is deliberately NOT derived from HERO.headline: the headline is
    meant to be A/B tested from the Studio, and the title tag should not churn
    with it — nor inherit a headline longer than the ~60 characters search
    results display. */}
<Base
  title="Panta — Digital, strategic, and creative support"
  description="Panta helps small businesses and community organizations get found, run smoother, and tell their story — without the agency runaround."
  schema={[faqSchema(FAQS)].filter(Boolean)}
>
  <!-- ===================== 1. hero ===================== -->
  <!-- Two columns: the claim on the left, what we actually do on the right.
       The service index is hairline rows with arrows, NOT cards or buttons —
       nothing may compete with the one filled button (§3, §4.1). -->
  <section class="hero" id="top" data-section="hero">
    <div class="container hero__grid">
      <div class="hero__claim">
        <h1 class="hero__headline">{HERO.headline}</h1>
        <p class="hero__sub">{HERO.subhead}</p>
        <a
          class="hero__quiet"
          href="/work/"
          data-track="cta_click"
          data-track-cta="work"
          data-track-location="home_hero"
        >{HERO.secondaryLabel} <span aria-hidden="true">→</span></a>
      </div>

      {/* The index and the button are wrapped separately so mobile can put the
          button first — see .hero__index in the stylesheet. */}
      <div class="hero__index">
        <div class="hero__svc">
          <p class="kicker">What we do</p>
          <ul class="svc-index">
            {SERVICES.map((s) => (
              <li>
                <a
                  href={s.href}
                  data-track="cta_click"
                  data-track-cta="service_index"
                  data-track-location="home_hero"
                >
                  <span>{s.label}</span>
                  <span class="svc-index__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="hero__act">
          <a
            class="btn btn--filled hero__cta"
            href={BOOK}
            data-track="cta_click"
            data-track-cta="pulse_check"
            data-track-location="home_hero"
          >{HERO.ctaLabel}</a>
          <p class="hero__micro"><PulseTerm text={HERO.ctaMicrocopy} location="home_hero" /></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== 2. featured case study ===================== -->
  <!-- Was §4.6, four screens down, behind the pillars and the process. It now
       occupies the trust bar's slot: the claim is followed immediately by the
       evidence for it, which is the move both reference sites make. The logo
       row that used to sit here is gone — two logos under "trusted by" read
       thinner than the work itself does.
       The sector line and the 48-hour promise survive as the closing strip,
       since they were the rest of what the trust bar was doing. -->
  {CASES.length > 0 && (
    <section class="section case" data-section="case">
      <div class="container">
        <p class="kicker">Recent work</p>
        <div class="case__grid">
          {CASES.map((c, i) => (
            <article class="case__item">
              <a class="case__media" href={`/work/${c.slug}/`} tabindex="-1" aria-hidden="true">
                {c.thumbnail ? (
                  <img src={c.thumbnail.replace('-thumb', '')} alt="" loading="lazy" decoding="async" />
                ) : (
                  <div class="case__media-empty"></div>
                )}
              </a>
              {/* The quote moved up to the pillars close, so each preview leads
                  on the client's name — it says what the work was, which is
                  what a visitor is here for by this point. */}
              <h2 class="case__head">{c.name}</h2>
              <p class="case__meta">{c.client?.sector ?? c.clientType}</p>
              <p class="case__body">{c.summary}</p>

              {/* `project.contributions` — the scope of the engagement. It says
                  what Panta actually did, which the summary describes and the
                  outcome doesn't. Inline rather than stacked rows: three items
                  as hairline rows would be taller than the summary above it. */}
              {(c.contributions ?? []).length > 0 && (
                <div class="case__did">
                  <p class="kicker">What we did</p>
                  <p class="case__did-list">{c.contributions.join(' · ')}</p>
                </div>
              )}

              {/* §7.4 still holds — nothing here may be invented. What changed
                  is that the slot no longer demands a NUMBER: `project.outcome`
                  is a real field ("Short outcome line shown on cards") the
                  query already selects, so a true sentence fills it. The
                  blocking placeholder is kept for the FEATURED case only:
                  making every card demand one would add launch blockers for
                  secondary work that was never promised an outcome line. */}
              {c.outcome ? (
                <p class="case__outcome">{c.outcome}</p>
              ) : i === 0 ? (
                <p class="case__outcome-ph">
                  <Placeholder note={`the outcome line for ${c.name} — a sentence, not a number`}>
                    [What changed for them — one sentence]
                  </Placeholder>
                </p>
              ) : null}

              <a
                class="case__link"
                href={`/work/${c.slug}/`}
                data-track="cta_click"
                data-track-cta={i === 0 ? 'case_study' : 'case_study_secondary'}
                data-track-location="home_case"
              >Read the full story <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </div>

      <div class="container case__trust">
        <p class="case__trust-claim">
          Nonprofits, independent practitioners, and small businesses across Northern California.
        </p>
        <p class="case__trust-promise">
          Free 30-minute review · written readout within 48 hours · yours to keep either way
        </p>
      </div>
    </section>
  )}

  <!-- ===================== 3. problem framing ===================== -->
  <!-- Voice surface: serif, centered, narrow measure. -->
  <!-- <section class="section problem" data-section="problem">
    <div class="container problem__inner">
      <p class="problem__lead">Your work matters to real people in a real place.</p>
      <p class="problem__body">
        But the website hasn’t kept up. The systems live in one person’s head. And the story
        that makes people show up, donate, or book isn’t reaching them.
      </p>
      <p class="problem__turn">You don’t need a digital transformation. You need a partner who gets it.</p>
    </div>
  </section> -->

  <!-- ===================== 4. service pillars ===================== -->
  <!-- Structure surface: sans. Green appears here as the pillar icons only. -->
  <section class="section section--dark" id="services" data-section="pillars">
    <div class="container">
      <h2 class="pillars__head">Three ways we help.</h2>
      {PILLARS.length === 0 && (
        <Placeholder note="the three pillar documents (Studio → Pillars)" />
      )}
      <div class="pillars">
        {/* The mark is chosen by pillar id, not position: pillars are content
            now, and reordering them in the Studio must not hand Creative the
            magnifying glass. The numeral IS positional — it counts columns. */}
        {PILLARS.map((p, i) => (
          <article class="pillar">
            <div class="pillar__rule">
              <span class="pillar__icon" aria-hidden="true">
                {p.id === 'digital' && (
                  <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="7" />
                    <path d="M16.5 16.5L21 21" />
                  </svg>
                )}
                {p.id === 'strategic' && (
                  <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 7h10M4 12h16M4 17h7" />
                    <circle cx="18" cy="7" r="2.2" />
                    <circle cx="14" cy="17" r="2.2" />
                  </svg>
                )}
                {p.id === 'creative' && (
                  <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3l2.4 5.4 5.6.6-4.2 3.9 1.2 5.6L12 15.8 6.9 18.5l1.2-5.6L4 9l5.6-.6z" />
                  </svg>
                )}
              </span>
              <span class="pillar__n" aria-hidden="true">{`0${i + 1}`}</span>
            </div>
            <p class="pillar__kicker">{p.kicker}</p>
            <h3 class="pillar__head">{p.head}</h3>
            <p class="pillar__lede">{p.lede}</p>
            <ul class="pillar__list">
              {(p.bullets ?? []).map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
      <div class="pillars__close">
        <div>
          <p class="pillars__cta">
            Not sure where to start? Our Pulse Check is a free 30-minute conversation about where things stand. You’ll get a one-page readout within 48 hours — three observations and one recommendation, yours to keep either way.
          </p>
          <div class="pillars__actions">
            {/* Ghost, not filled. §7.3 caps the page at two filled buttons and
                they are now spent on the hero (first ask) and the form in the
                close (the on-page conversion). On charcoal a cream-outlined
                button is still unmistakably a button — and this is the third
                ask inside two screens, sitting beside two text links and a
                testimonial, so it was the one competing rather than earning. */}
            <a
              href={BOOK_FORM}
              class="btn btn--ghost"
              data-track="cta_click"
              data-track-cta="pulse_check"
              data-track-location="home_pillars"
            >Book a free 30-minute review</a>
            <a href={BOOK} class="pillars__learn-more" data-track="cta_click" data-track-cta="learn_more_pulse_check" data-track-location="home_pillars_more">
              Learn more <span aria-hidden="true">→</span>
            </a>
          </div>
          {/* Escape hatch: a calendar is a commitment, and some visitors want to
              ask a question first. Kept quiet and text-only so it never competes
              with the booking button — it catches the people who'd otherwise
              leave, not the ones already reaching for a time slot.
              Now points at the form in the close rather than off to /contact/:
              the same escape, without leaving the page. */}
          <!-- <p class="pillars__escape">
            Not ready to put a time on the calendar?
            <a href="#start" data-track="cta_click" data-track-cta="message_instead" data-track-location="home_pillars">
              Tell us what&rsquo;s going on instead <span aria-hidden="true">→</span>
            </a>
          </p> -->
        </div>

        {/* The featured quote is testimony about the Pulse Check itself — "found
            in 30 minutes what two other people missed for months" — so it earns
            the booking button, not the case study four screens down where it
            used to sit describing a website rebuild it isn't about. Same
            `caseStudy` document; §4.6 keeps the image, summary and story link. */}
        {caseStudy?.quote && (
          <figure class="pillars__proof">
            <blockquote>“{caseStudy.quote}”</blockquote>
            {caseStudy.quoteAuthor && (
              <figcaption>
                — {caseStudy.quoteAuthor}{caseStudy.quoteRole ? `, ${caseStudy.quoteRole}` : ''}
              </figcaption>
            )}
          </figure>
        )}
      </div>
    </div>
  </section>

  <!-- ===================== 5. how it works ===================== -->
  <section class="section" data-section="process">
    <div class="container">
      <h2 class="steps__head">A clear path to growth and impact.</h2>
      <ol class="steps">
        {STEPS.map((s) => (
          <li class="step">
            <span class="step__n" aria-hidden="true">{s.n}</span>
            <div>
              <h3 class="step__title">{s.title}</h3>
              <p class="step__body">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===================== 7. Pulse strip ===================== -->
  <!-- The one section that does NOT route to the Pulse Check (§7.2): it routes
       to Pulse and to subscribe. -->
  <section class="section section--dark pulse-strip" data-section="pulse">
    <div class="container">
      <div class="pulse-strip__top">
        <div>
          <h2 class="pulse-strip__masthead">Pulse</h2>
          <p class="pulse-strip__tagline">
            We're always busy finding new ways to support our communities and the  businesses and organizations that serve them. This is where we share our latest insights, ideas, and resources.
          </p>
        </div>
        <a
          class="pulse-strip__all"
          href="/pulse/"
          data-track="cta_click"
          data-track-cta="pulse_index"
          data-track-location="home_pulse"
        >Read all of Pulse <span aria-hidden="true">→</span></a>
      </div>

      {posts.length > 0 ? (
        <ul class="pulse-cards">
          {posts.map((p) => (
            <li class="pulse-card">
              <a href={`/pulse/${p.slug}/`} data-track="cta_click" data-track-cta="post" data-track-location="home_pulse">
                <h3 class="pulse-card__title">{p.title}</h3>
                <p class="kicker pulse-card__meta">
                  {p.category?.name}
                  {p.contentType === 'guide' ? ' · Guide' : ''}
                  {p.readTime ? ` · ${p.readTime} min read` : ''}
                </p>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        /* §9 launch blocker: the strip cannot ship empty. Visible and
           machine-detectable rather than silently absent. */
        <p class="pulse-empty">
          <Placeholder note="three published Pulse pieces (one per category preferred)">
            [Pulse strip has no posts — homepage cannot ship in this state]
          </Placeholder>
        </p>
      )}

      <NewsletterForm
        source="home_pulse"
        variant="quiet"
        body={settings?.newsletterBlurb ?? 'One useful idea every other week. No fluff, no funnels.'}
        class="pulse-strip__nl"
      />
    </div>
  </section>

  <!-- ===================== 8. founder note ===================== -->
  <section class="section founder" data-section="founder">
    <div class="container founder__grid">
      <div class="founder__photo">
        <Placeholder note="founder photo in a natural setting — not a headshot against a wall">
          [Photo: Damon]
        </Placeholder>
      </div>
      <div class="founder__copy">
        <!-- <p>
          I started Panta because the organizations doing the most important work are usually
          the ones with the least support. Big agencies don’t want the account. DIY tools eat
          your weekends. So the work that holds communities together stays invisible.
        </p> -->
        <p>
          I started Panta because I believe the small businesses and organizations that serve our communities deserve the capabilities and support that larger companies take for granted. Our mission is to help them build and grow in a way that is sustainable and impactful.
        </p>
        <p>
          I’ve spent over 15 years building for companies of every size. Now I bring that experience to the
          people that serve people. If that’s you, We’d love to talk.
        </p>
        <p class="founder__sign">
          — Damon<br />
          <span>Founder, Panta</span>
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== 8.5 FAQ ===================== -->
  <!-- Objections sit adjacent to the ask, so the answers are still on screen
       while the visitor decides. Sans (structure surface) — it also breaks the
       page's only three-serif run: case → pulse → founder → FAQ → final. -->
  <section class="section faq" data-section="faq">
    <div class="container faq__inner">
      <p class="kicker">Questions we get</p>
      <h2 class="faq__head">Before you book, the honest answers.</h2>
      <p class="faq__lede">If yours isn’t here, ask it on the call — or send it below.</p>
      <div class="faq__list">
        {/* Native <details>: keyboard, screen readers and find-in-page all work
            with no JS, which a hand-rolled aria-expanded accordion does not.
            Deliberately NOT name="home-faq" — exclusive accordions collapse the
            answer you were comparing against and jump the scroll position. */}
        {FAQS.map((f) => (
          <details class="faq__item">
            <summary class="faq__q">
              <span>{f.q}</span>
              <span class="faq__mark" aria-hidden="true"></span>
            </summary>
            <div class="faq__panel"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== 9. final CTA ===================== -->
  <!-- The close is now the conversion, not a signpost to one. Two ways to make
       the same request (§7.2 is one conversion BEHAVIOR per surface, not one
       mechanism): the form for people who won't open a calendar, the link for
       people who will. -->
  <section class="section section--bamboo final" id="start" data-section="final">
    <div class="container final__grid">
      <div class="final__inner">
        <RippleMark size={48} class="ripple-mark" />
        <h2 class="final__head">Start with a Pulse Check — a free 30-minute review.</h2>
        <p class="final__body">
          A short conversation about where things stand. We'll discuss your current priorities and goals, and explore options to serve your most important needs. We'll follow up with a written summary, recommendations for next steps, and an invitation to continue the conversation. No strings attached, whether we work together or not.
        </p>
      </div>

      <div class="final__act">
        <LeadForm source="home_final">
          <a
            slot="aside"
            class="final__book"
            href={BOOK}
            data-track="cta_click"
            data-track-cta="pulse_check"
            data-track-location="home_final"
          >or pick a time now <span aria-hidden="true">→</span></a>
        </LeadForm>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------------------------------------------------------------- hero -- */

  .hero {
    margin-top: calc(var(--header-h) * -1);
    padding-block: calc(var(--header-h) + clamp(2.5rem, 7vw, 3rem)) clamp(3rem, 7vw, 5rem);
    background: var(--cream);
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  /* 60/40 per §4.1. Mobile stacks headline → subhead → index → CTA, which is
     source order, so no reordering is needed. */
  @media (min-width: 900px) {
    .hero__grid { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); }
  }

  /* Baloo carries the hero — Panta's display face stays the loudest voice on
     the page. The brief's other "voice" surfaces (problem framing, quotes,
     Pulse masthead, founder note, final CTA) use Spectral, so the serif/sans
     alternation below the fold is preserved. */
  .hero__headline {
    font-family: 'Baloo 2', var(--font-sans);
    font-weight: 800;
    font-size: clamp(2.1rem, 4.2vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: 0.005em;
    max-width: 16ch;
    margin: 0 0 1.35rem;
  }

  .hero__sub {
    font-size: clamp(1rem, 1.25vw, 1.1rem);
    line-height: 1.65;
    color: var(--stone-deep);
    max-width: 46ch;
    margin: 0 0 1.5rem;
  }

  .hero__quiet {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--charcoal);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
  }

  .hero__quiet:hover { border-bottom-color: var(--charcoal); }

  /* Stacked, the five-row service index used to push the one filled button to
     839px on a 375px phone — a full screen below the fold, on the one breakpoint
     where the header's CTA is also hidden behind the hamburger. So below 900px
     the button leads and the index becomes the scenic route under it; desktop
     keeps the brief's order (§4.1), index then button. */
  .hero__index {
    display: grid;
    row-gap: 2.25rem;
  }

  .hero__act { order: -1; }

  @media (min-width: 900px) {
    .hero__act { order: 0; }
  }

  .svc-index {
    list-style: none;
    padding: 0;
    /* Bottom spacing is .hero__index's row-gap now — a margin here would apply
       in whichever order the two blocks happen to be in, and trail off the
       bottom of the hero on mobile. */
    margin: 0.9rem 0 0;
    border-top: 1px solid var(--line);
  }

  .svc-index li { border-bottom: 1px solid var(--line); }

  .svc-index a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
    font-size: 0.95rem;
