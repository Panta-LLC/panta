  /* ------------------------------------------------------ hero motion -- */
  /* The hero animates in CSS, not GSAP, unlike every section below it.
     `gsap.from` sets its start state when the tween is CREATED, and Astro
     ships module scripts deferred — so the browser can paint the hero at its
     final position, then GSAP yanks it back to opacity 0 and replays. Below
     the fold nobody sees that hand-off; here it is a visible flash on the LCP
     element. Keyframes start at first paint and need no JS. */
  @keyframes rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }

  .hero__headline,
  .hero__sub,
  .hero__quiet,
  .hero__svc .kicker,
  .svc-index li,
  .hero__act > * {
