  <!-- ===================== 9. final CTA ===================== -->
  <!-- The close is now the conversion, not a signpost to one. Two ways to make
       the same request (§7.2 is one conversion BEHAVIOR per surface, not one
       mechanism): the form for people who won't open a calendar, the link for
       people who will. -->
  <section class="section section--bamboo final" id="start" data-section="final">
    <div class="container final__grid">
      <div class="final__inner">
        <RippleMark size={48} class="ripple-mark" />
        <h2 class="final__head">Start with a Pulse Check — a free 30-minute review.</h2>
        <p class="final__body">
          A short conversation about where things stand. We'll discuss your current priorities and goals, and explore options to serve your most important needs. We'll follow up with a written summary, recommendations for next steps, and an invitation to continue the conversation. No strings attached, whether we work together or not.
        </p>
      </div>

      <div class="final__act">
        <LeadForm source="home_final">
          <a
            slot="aside"
            class="final__book"
            href={BOOK_FORM}
            data-track="cta_click"
            data-track-cta="pulse_check"
            data-track-location="home_final"
          >or pick a time now <span aria-hidden="true">→</span></a>
        </LeadForm>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------------------------------------------------------------- hero -- */

  /* The hero is a charcoal surface. Every colour it uses is a token rather than
     a palette name, so the same markup renders on cream by overriding six
     values — the light variant is not dead code, it is one block away.
     --hero-wash is a bare triple because it is consumed inside rgba(); a hex
     custom property cannot be given an alpha. */
  .hero {
    --hero-surface: var(--charcoal);
    --hero-type: var(--cream);
    --hero-quiet: var(--sage); /* sage on charcoal = 7.9:1 */
    --hero-rule: rgba(245, 241, 231, 0.28);
    --hero-wash: 38, 37, 31;
    /* The cards. A raised sliver of the surface rather than a border alone —
       on cream the same two values become a tint and a hairline, which is what
       keeps the light variant one override away. */
    --hero-card-bg: rgba(245, 241, 231, 0.05);
    --hero-card-line: rgba(245, 241, 231, 0.16);
    /* The mark's own colouring, not a decorative palette: RippleMark draws its
       two outer rings in currentColor and only the innermost one in bamboo. So
       the rings follow the surface's ink and the accent is bamboo either way,
       exactly as the logo behaves in the header. */
    --hero-ring: var(--cream);
    --hero-ring-alpha: 0.16;
    --hero-ring-accent: var(--bamboo);
    --hero-ring-accent-alpha: 0.7;
    /* PulseTerm's own hook. Its default, bamboo-deep, is 2.2:1 on charcoal —
       the term in the microcopy would read as a smudge without it. */
    --pulse-term-accent: var(--sage);
    /* And the tip itself inverts. Its default is a charcoal panel, which is
       correct everywhere else it appears (cream sections, the bamboo closing
       CTA) and invisible here — a charcoal box on a charcoal hero, so the
       sentence read as loose text lying across the service cards it opens
       over. Cream on charcoal is the relationship the filled button in this
       same section already uses, so the tip reads as raised rather than as a
       second thing to click. */
    --pulse-tip-surface: var(--cream);
    --pulse-tip-ink: var(--charcoal);
    --pulse-tip-cue: var(--bamboo-deep); /* 4.6:1 on cream */
  }

  .hero {
    position: relative;
    margin-top: calc(var(--header-h) * -1);
    /* Tighter top and bottom than the slogan version carried: the section now
       holds an eyebrow, a risk-reversal line and a proof strip, and the whole
       arrangement is only worth anything if it lands on one screen. */
    padding-block: calc(var(--header-h) + clamp(1.75rem, 5vw, 3rem)) clamp(1.75rem, 4vw, 2.5rem);
    background: var(--hero-surface);
    color: var(--hero-type);
    /* Two jobs: the word masks clip to the line box, so nothing may bleed
       sideways while a word is travelling — and the mark is deliberately wider
       than the section, so it is cropped by the hero's own edges rather than
       shrinking to fit inside them. */
    overflow: hidden;
  }

  /* Single column, centred. The 60/40 split this used to carry went with the
     service index — a lone CTA floating in a 40% column reads as a layout
     waiting for content that never arrives — and centring it gives the mark
     the whole right side to occupy. */
  .hero__grid {
    position: relative; /* above the mark */
    z-index: 1;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  /* Full width rather than shrink-to-fit, which is what `justify-items: center`
     would otherwise give a lone grid item. Every block inside carries its own
     measure and centres on it — and the two that don't want one (the eyebrow,
     the proof strip) were being sized by whichever sibling happened to be
     widest, which is not a layout rule, it is a coincidence. */
  .hero__claim { width: 100%; }

  /* Faded into the section's top edge. The mark is deliberately cropped by the
     hero's own edges, but the top-right corner cut a ring off mid-arc against
     the header, which read as a graphic that had been trimmed to fit rather
     than one running past the frame. The right and bottom crops stay hard —
     that is the "off the edge" the composition is built on. */
  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 20%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 20%);
  }

  /* Anchored by its CENTRE at 96% across, not by an edge offset: the fraction
     of the mark left in frame then stays constant as the graphic resizes, where
     `right: -Xrem` re-crops it at every breakpoint. Vertically centred, so it
     reads as a horizon behind the column rather than a shape sitting under one
     corner of it.

     Sized off the larger axis so it stays a circle filling the frame at any
     ratio — a vw-only size leaves a small medallion on a tall phone. The cap
     stops it becoming an arc with no visible centre on a wide monitor. */
  .hero__mark {
    position: absolute;
    top: 50%;
    left: 96%;
    transform: translate(-50%, -50%);
    width: min(112vh, 92vw, 60rem);
    aspect-ratio: 1;
    /* The outer ring's stroke straddles the viewBox edge; without this it would
       be shaved flat on all four sides by the SVG viewport. */
    overflow: visible;
  }

  .hero__ring {
    stroke: var(--hero-ring);
    opacity: var(--hero-ring-alpha);
  }

  .hero__ring--accent {
    stroke: var(--hero-ring-accent);
    opacity: var(--hero-ring-accent-alpha);
  }

  /* Spectral, not Baloo. The rounded display face read playful — fine for a
     snack brand, wrong for a headline whose whole claim is that Panta makes a
     therapist or a nonprofit look credible. The serif is also what the rest of
     the system already speaks in: the problem framing, the quotes, the Pulse
     masthead, the founder note and the final CTA are all Spectral, so the
     headline now opens in the same voice the page continues in.
     400, not a heavy weight: Spectral's authority is in its shapes, and
     bolding it to match Baloo's mass would just make it shout in a lower
     register. Centred type wants a wider measure than the left-aligned
     original (16ch), or the ragged edges fight the axis. */
  /* A slightly lower ceiling than the 3.6rem this carried when the hero held
     only a claim and a button. The section now runs claim → CTA → six cards →
     proof, and every rem the headline takes is a rem the cards spend below the
     fold. */
  .hero__headline {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.15rem, 4.4vw, 3.25rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    /* 24ch and `pretty`, not 21ch and `balance`. Balancing evens the line
       lengths, which on this headline breaks after "the" and hangs an article
       off the end of line one; filling to the measure breaks after "people"
       and drops the accented phrase onto a line of its own. 24ch is the middle
       of the 22–25ch band that produces that break, so a font-metric shift of
       a character either way does not flip it. */
    max-width: 24ch;
    margin: 0 auto 0.9rem;
    text-wrap: pretty;
  }

  /* The emotional anchor of the claim: colour plus italic, which is the pair
     the mockup uses and which survives on its own if either one is missed —
     sage on charcoal is 7.9:1, so the colour is never carrying meaning alone
     for a reader who cannot see it. */
  .hero__word-in--accent {
    color: var(--sage);
    font-style: italic;
  }

  /* ------------------------------------------------------- hero cards -- */
  /* Column count comes from the markup as --hero-card-cols, because it is a
     function of how many services exist and that is data (see CARD_COLUMNS).
     Narrower viewports override it here — a two-word card in a 3-up grid on a
     phone is four wrapped lines. */
  .hero__cards {
    display: grid;
    grid-template-columns: repeat(var(--hero-card-cols, 3), minmax(0, 1fr));
    gap: 0.6rem;
    max-width: 46rem;
    margin: 0 auto 1.25rem;
  }

  .hero__card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    text-align: left;
    background: var(--hero-card-bg);
    border: 1px solid var(--hero-card-line);
    border-radius: 10px;
    padding: 0.75rem 0.95rem;
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--hero-type);
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .hero__card:hover,
  .hero__card:focus-visible {
    border-color: var(--sage);
    background: rgba(245, 241, 231, 0.09);
    color: var(--hero-type);
  }

  .hero__card-arrow {
    color: var(--hero-quiet);
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .hero__card:hover .hero__card-arrow { transform: translateX(2px); }

  @media (max-width: 640px) {
    .hero__cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* The mask. Descenders would be clipped by overflow:hidden at the exact line
     box, and Spectral's italic leans past its glyph box on the right — so the
     box is padded on those two sides and the padding pulled straight back out,
     leaving the word spacing to margin-right alone. */
  .hero__word {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    padding: 0 0.06em 0.16em;
    margin: 0 -0.06em -0.16em;
    margin-right: 0.2em;
  }

  .hero__word-in { display: inline-block; }

  .hero__sub {
    font-size: clamp(1rem, 1.3vw, 1.12rem);
    line-height: 1.65;
    color: var(--hero-quiet);
    max-width: 52ch;
    margin: 0 auto 1.15rem;
    padding: 0.5rem 1.25rem;
  }

  /* A wash in the surface colour under the two small-text blocks, and only
     those. A ring crossing small type costs it contrast, and no ring opacity
     low enough to fix that leaves a visible graphic — on cream the accent ring
     takes stone-deep from 4.78:1 to 2.91:1, and even at 0.18 it only recovers
     3.97:1. Dimming the mark is therefore the wrong lever. A local wash at 0.9
     restores the worst case while leaving the mark at full strength everywhere
     else: the headline needs no help (it clears 8:1 over any ring) and the CTA
     is an opaque fill. */
  .hero__sub,
  .hero__micro,
  .hero__risk,
  .hero__proof {
    background: radial-gradient(
      ellipse 118% 128% at 50% 50%,
      rgba(var(--hero-wash), 0.93) 0%,
      rgba(var(--hero-wash), 0.9) 52%,
      rgba(var(--hero-wash), 0) 100%
    );
  }

  /* Its own rule colour rather than --hero-rule: at 0.28 the underline read
     heavier than a secondary link earns, and --hero-rule is also the hairline
     over the proof strip, which does want that weight. */
  .hero__quiet {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--hero-type);
    text-decoration: none;
    border-bottom: 1px solid rgba(245, 241, 231, 0.18);
    padding-bottom: 2px;
  }

  .hero__quiet:hover { border-bottom-color: var(--hero-type); }

  /* The button follows the subhead directly in source order, so the ordering
     fight this block used to arbitrate — index-then-button on desktop,
     button-first on mobile so the CTA cleared the fold on a 375px phone — no
     longer exists. It leads at every width. */
  .hero__act { margin-block: 1.5rem 1.5rem; }

  .hero__buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  /* The hero is not a .section--dark, so global.css's inversion for filled
     buttons (a charcoal fill on charcoal reads as a hole) does not reach it.
     Restated against the same values rather than adding .section--dark to the
     markup, which would also pull in that class's padding and background. */
  .hero__cta {
    background: var(--cream);
    color: var(--charcoal);
    border-color: var(--cream);
  }

  .hero__cta:hover {
    background: var(--charcoal);
    border-color: var(--cream);
    color: var(--cream);
  }

  /* `fit-content`, and it is doing real work. Both this and .hero__risk are
     single display lines, but each was being measured as a paragraph — this one
     by global.css's `p { max-width: var(--measure) }` (62ch → 405px), the one
     below by a 46ch of its own (389px). Two blocks capped within 16px of each
     other, each wrapping to two lines, stopped reading as a spec and a promise
     and started reading as one four-line lump of small print.
     Not `none`: both are in the radial-wash group below, and the wash is a
     LOCAL darkening that keeps sage legible where it crosses the mark. A
     full-width block stretches that gradient into a smear across the hero;
     fit-content keeps it hugging the line it exists for. It also degrades on
     its own — fit-content is min(max-content, available), so a phone wraps
     these exactly as before. */
  .hero__micro {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--hero-quiet);
    max-width: fit-content;
    margin: 0.4rem auto 0;
    padding: 0.5rem 1.25rem;
  }

  /* Sans, not mono: the line above it is a spec and this is something someone
     says. Dimmer than the subhead so it reads as a footnote to the button
     rather than a second subhead — and shorter than the spec above it, so the
     two taper instead of stacking as two bars of the same width. */
  .hero__risk {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--hero-quiet);
    max-width: fit-content;
    margin: 0.3rem auto 0;
    padding: 0.35rem 1.25rem;
  }

  /* -------------------------------------------------------- hero proof -- */
  /* A hairline and one line of names. The rule is what makes it read as
     evidence appended to the claim rather than as another paragraph of it. */
  .hero__proof {
    max-width: 46rem;
    margin: 0 auto;
    padding: 0.95rem 1.25rem 0;
    border-top: 1px solid var(--hero-rule);
  }

  /* The line breaks here are the editor's, entered in the Studio — so no
     --measure cap, which would add breaks they did not ask for. */
  .hero__proof-clients {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.9;
    letter-spacing: 0.03em;
    color: var(--hero-quiet);
    max-width: none;
    margin: 0;
  }

  .hero__proof-clients strong {
    display: block;
    font-weight: 500;
    color: var(--hero-type);
    margin-bottom: 0.15rem;
  }

  /* ------------------------------------------------------ hero motion -- */
  /* The intro is a GSAP timeline, and the pre-state below is what makes that
     safe. `gsap.from` sets its start state when the tween is CREATED, and Astro
     ships module scripts deferred — so the browser can paint the hero at its
     final position, then GSAP yanks it back to opacity 0 and replays. Below the
     fold nobody sees that hand-off; here it would be a visible flash on the LCP
     element. So: an inline parser-blocking script stamps html[data-hero-intro]
     before first paint, these rules hide what is about to animate, every tween
     is a fromTo() landing on explicit visible values rather than inheriting the
     hidden ones, and a 1.5s watchdog un-hides everything if the module never
     runs. The remaining cost is real and deliberate — the LCP element is gated
     on JS, where the previous CSS-keyframe hero painted without it. */
  html[data-hero-intro='pending'] .hero__word-in {
    transform: translateY(105%);
  }

  html[data-hero-intro='pending'] .hero__bg,
  html[data-hero-intro='pending'] [data-hero='sub'],
  html[data-hero-intro='pending'] [data-hero='act'],
  html[data-hero-intro='pending'] [data-hero='micro'],
  html[data-hero-intro='pending'] [data-hero='cards'],
  html[data-hero-intro='pending'] [data-hero='proof'] {
    opacity: 0;
  }

  /* ----------------------------------------------------------- problem -- */

  .problem__inner {
    max-width: 34rem;
    margin-inline: auto;
    text-align: center;
  }

  .problem__lead {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    line-height: 1.35;
    margin: 0 0 1.25rem;
  }

  .problem__body,
  .problem__turn {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--stone-deep);
    margin: 0 0 1rem;
  }

  .problem__turn {
    color: var(--charcoal);
    font-weight: 500;
  }

  /* ----------------------------------------------------------- pillars -- */

  .pillars__head {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 2.9rem);
    letter-spacing: -0.02em;
    margin-bottom: clamp(2.25rem, 4vw, 3rem);
  }

  .pillars {
    display: grid;
    gap: clamp(2.25rem, 3vw, 3rem);
  }

  @media (min-width: 820px) {
    .pillars { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .pillar {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(245, 241, 231, 0.28);
    transition: border-top-color 0.25s ease;
  }

  /* The rule row: the green mark on the left, its index on the right. Reads as
     a masthead line for the column rather than a card header. */
  .pillar__rule {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }

  /* One of the four places green is allowed (§3). */
  .pillar__icon {
    color: var(--sage);
    display: block;
    transition: transform 0.25s ease;
  }

  .pillar__n {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: rgba(245, 241, 231, 0.4);
    transition: color 0.25s ease;
  }

  .pillar:hover { border-top-color: var(--sage); }
  .pillar:hover .pillar__icon { transform: translateY(-2px); }
  .pillar:hover .pillar__n { color: var(--cream); }

  .pillar__kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sage);
    margin: 0;
  }

  .pillar__head {
    font-size: clamp(1.45rem, 2.2vw, 1.75rem);
    margin: 0;
    color: var(--cream);
  }

  .pillar__lede {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--cream);
    margin: 0;
  }

  /* Hairline rows, matching the hero's service index — the dotted list read as
     three loose fragments; ruled rows give the column a spine. */
  .pillar__list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    border-top: 1px solid rgba(245, 241, 231, 0.14);
  }

  .pillar__list li {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--sage);
    padding: 0.7rem 0;
    border-bottom: 1px solid rgba(245, 241, 231, 0.14);
  }

  /* A cream panel on the dark section: the copy asks, the actions answer, and
     the two sit on one line rather than in a 2×2 grid.
     The second column is `auto`, not a fraction — sized to the button it holds.
     As a fraction it reserved half the panel for a button a third that wide and
     left the rest of the row empty. */
  .pillars__close {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--cream);
    border-radius: 10px;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .pillars__close { grid-template-columns: minmax(0, 1fr) auto; }
  }

  .pillars__cta {
    margin: 0;
    max-width: 54ch;
    font-size: 1.05rem;
    color: var(--stone-deep);
  }
  .pillars__actions .btn--primary {
    background: var(--charcoal);
    color: var(--cream);
  }

  .pillars__actions .btn--primary:hover {
    background: var(--sage);
    color: var(--cream);
  }
  /* Sage rule rather than a card: the pillar columns above already read as
     ruled text, and a box here would be the only one on the page. */
  .pillars__proof {
    margin: 0;
    padding-left: clamp(1rem, 2vw, 1.5rem);
    border-left: 2px solid var(--sage);
  }

  .pillars__proof blockquote {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 1.9vw, 1.45rem);
    line-height: 1.4;
    color: var(--cream);
    margin: 0 0 0.7rem;
  }

  .pillars__proof figcaption {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--sage);
  }

  /* Sage everywhere below was written when this block sat straight on the dark
     section. It has been a cream panel since, which left the escape link cream
     on cream — invisible — and the rest of it barely legible. These are the
     same roles the packages cards use on the same surface. */
  .pillars__cta a { color: var(--bamboo-deep); }

  .pillars__offer {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }

  .pillars__actions {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2rem);
    flex-wrap: wrap;
  }

  .pillars__learn-more {
    color: var(--bamboo-deep);
    font-size: 0.95rem;
  }

  .pillars__learn-more:hover {
    color: var(--charcoal);
  }

  .pillars__escape {
    margin: 0;
    max-width: none;
    font-size: 0.9rem;
    color: var(--stone-deep);
  }

  /* The question wraps before the answer does, rather than the link breaking
     across two lines with its arrow orphaned on the second. */
  .pillars__escape a {
    color: var(--bamboo-deep);
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .pillar,
    .pillar__icon,
    .pillar__n { transition: none; }
    .pillar:hover .pillar__icon { transform: none; }

    /* The global backstop (global.css:1121-1124) kills `transition` site-wide
       but says nothing about `animation` — every keyframe on this page has to
       be switched off here by hand, or reduced-motion users get exactly the
       motion they asked not to have. GSAP is handled separately: its tweens
       live inside a matchMedia('no-preference') block and never run, and the
       hero's pre-state is never stamped because the inline script checks the
       same query — so the hero renders static and fully visible. */
    .faq__item[open] .faq__panel { animation: none !important; }

    /* :hover transforms are a state, not a transition, so the backstop misses
       these too. */
    .hero__card:hover .hero__card-arrow,
    .step:hover .step__n,
    .case__media:hover img { transform: none; }
  }

  /* ------------------------------------------------------------- steps -- */

  .steps__head {
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.5rem);
  }

  @media (min-width: 820px) {
    .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .step {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  /* Green step numerals — no boxes; the trust copy is the payload (§4.5). */
  .step__n {
    font-family: var(--font-serif);
    font-size: 2rem;
    line-height: 1;
    color: var(--bamboo-deep);
    transition: transform 0.25s ease;
  }

  /* Mirrors .pillar:hover .pillar__icon — same gesture, same distance. */
  .step:hover .step__n { transform: translateY(-2px); }

  .step__title {
    font-size: 1.05rem;
    margin: 0 0 0.4rem;
  }

  .step__body {
    font-size: 0.93rem;
    line-height: 1.65;
    color: var(--stone-deep);
    margin: 0;
  }

  /* ----------------------------------------------------- mid-page ask -- */
  /* cream-soft with hairlines, the treatment the old trust bar used: it reads
     as a strip between two full sections rather than a section of its own,
     which is what keeps it from competing with the close. */
  .mid-ask {
    background: var(--cream-soft);
    border-block: 1px solid var(--line);
    padding-block: clamp(2rem, 4vw, 2.75rem);
  }

  .mid-ask__grid {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
  }

  @media (min-width: 960px) {
    .mid-ask__grid { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); }
  }

  .mid-ask__head {
    font-family: var(--font-sans);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.3;
    margin: 0 0 0.35rem;
  }

  .mid-ask__body {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--stone-deep);
    margin: 0;
  }

  /* ---------------------------------------------------------- packages -- */

  /* cream-soft, not cream: the hero above and the case study below are both
     cream, and three flat cream bands in a row lose their edges. The cards
     invert to plain cream so they still read as raised on it — which is why
     they don't use the global .card class, whose surface is the other way up.
     scroll-margin-top so the sticky header doesn't sit on the heading when
     someone lands on /#packages. */
  .pkgs {
    background: var(--cream-soft);
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .pkgs__head {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.8vw, 2.1rem);
    line-height: 1.25;
    margin: 0.25rem 0 0;
    max-width: 22ch;
  }

  /* The price band, next to the things it prices. The same number is answered
     in full in the FAQ, but the FAQ is at ~90% scroll — which means it only
     ever reached people who had already decided. Here it does the work a price
     is supposed to do: it qualifies, and it disqualifies, at the moment
     someone is reading what they might buy. */
  .pkgs__price {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--stone-deep);
    max-width: 48ch;
    margin: 0.9rem 0 0;
  }

  .pkgs__price strong {
    font-weight: 600;
    color: var(--charcoal);
  }

  /* Explicit breakpoints rather than auto-fit: the number of cards is data —
     an editor toggling `listed` changes it — and auto-fit would silently
     re-flow five cards into four uneven columns on a wide screen. Three
     columns max keeps five reading as 3+2 and six as 3+3. */
  /* align-items: start is the whole fix for "expanding one card stretches its
     neighbours": a grid item defaults to stretching to its row's height, so an
     open <details> in one card grew every card beside it. With start, each card
     is exactly as tall as its own content and nothing else in the row moves. */
  /* minmax(0, 1fr) on the single-column case too, not just at the breakpoints
     below. A grid item's default `min-width: auto` refuses to shrink past its
     min-content, so an implicit `auto` track grows to fit whatever the widest
     child wants to be — which is how one expanded card dragged the whole track
     past the viewport on a phone. The zero floor makes that structurally
     impossible at every width rather than only at the two where the template
     happened to be declared. */
  .pkg-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin-top: 2rem;
    align-items: start;
  }

  @media (min-width: 720px) {
    .pkg-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1040px) {
    .pkg-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* Masonry, switched on by the script at the foot of this file. Cards keep
     their assigned column and span as many 1px rows as their content needs, so
     the card below one that just expanded slides down and the rest of the grid
     stays where it was — a plain grid instead leaves a band of dead space under
     every short card in a row.
     row-gap is 0 because the gap is folded into each span; the negative margin
     cancels the trailing one under the tallest column. Without JS the attribute
     is never set and the rule above stands on its own. */
  .pkg-grid[data-masonry] {
    grid-auto-flow: row dense;
    grid-auto-rows: 1px;
    row-gap: 0;
    margin-bottom: -1.25rem;
  }

  /* The global .card surface, as a flex column. */
  .pkg-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.75rem;
  }

  /* `translate`, not `transform`. The reveal below animates these cards with
     GSAP, which leaves an inline `transform` on every one of them when it
     finishes — an inline declaration outranks this rule, so the lift silently
     never happened. The standalone translate property composes with that
     transform instead of losing to it. */
  .pkg-card--link {
    transition: translate 0.25s ease, box-shadow 0.25s ease;
  }

  /* "Pointing at the card, and not at the pill inside it" — the state in which
     a click navigates. All three of the link's hover signals hang off it, so
     reaching for the one control that ISN'T the link never dresses the card up
     as one. :where() keeps the guard from inflating specificity. */
  .pkg-card--link:hover:not(:where(:has(.pkg-card__toggle:is(:hover, :focus-visible)))) {
    translate: 0 -3px;
    box-shadow: 0 20px 40px -28px rgba(0, 0, 0, 0.45);
  }

  .pkg-card--link:hover:not(:where(:has(.pkg-card__toggle:is(:hover, :focus-visible)))) .pkg-card__more-label,
  .pkg-card:has(.pkg-card__anchor:focus-visible) .pkg-card__more-label {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pkg-card--link:hover:not(:where(:has(.pkg-card__toggle:is(:hover, :focus-visible)))) .pkg-card__arrow {
    transform: translateX(4px);
  }

  .pkg-card__name {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    line-height: 1.3;
    margin: 0;
  }

  /* Stretched link: the anchor is only the title in the markup, but its ::after
     covers the whole card, so the card stays clickable end to end without
     wrapping the <details> in an anchor. */
  .pkg-card__anchor {
    text-decoration: none;
    color: inherit;
  }

  .pkg-card__anchor::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  /* The overlay swallows the focus ring the title alone would show, so the
     outline is drawn on the card instead — otherwise keyboard users get a
     highlight around three words in the corner of a clickable card. */
  .pkg-card:has(.pkg-card__anchor:focus-visible) {
    outline: 2px solid var(--bamboo);
    outline-offset: 2px;
  }

  .pkg-card__price {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--bamboo-deep);
    margin: 0.4rem 0 0;
  }

  .pkg-card__body {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--stone-deep);
    margin: 0.75rem 0 0;
  }

  /* Lifted above .pkg-card__anchor::after — without the stacking context the
     stretched link sits on top of the summary and the card navigates away
     instead of expanding. width: max-content so only the pill is lifted: a
     full-width block here would take the rest of the line out of the card's
     hit area for no visible reason. */
  /* No `width: max-content` here. It was meant to make the closed pill hug its
     label, which .pkg-card__toggle already does on its own — it is inline-flex.
     Open, though, max-content becomes the widest UNWRAPPED bullet, and
     `max-width: 100%` cannot claw that back: it resolves against the card,
     whose width is the grid track, which was itself being sized to fit this
     element. On a 375px phone that expanded the card from 335px to 612px and
     put 257px of the page off-screen. */
  .pkg-card__details {
    position: relative;
    z-index: 1;
    margin-top: 1.15rem;
  }

  /* The one control on the card that is not the card. It gets a border and a
     hit area that stops at its own edges; everything else — title, blurb, the
     "Learn more" row — belongs to the link underneath. */
  .pkg-card__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--stone-deep);
    background: transparent;
    cursor: pointer;
    list-style: none;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .pkg-card__toggle::-webkit-details-marker { display: none; }

  .pkg-card__toggle:hover,
  .pkg-card__details[open] .pkg-card__toggle {
    border-color: var(--bamboo);
    color: var(--charcoal);
    background: var(--cream-soft);
  }

  .pkg-card__toggle:focus-visible {
    outline: 2px solid var(--bamboo);
    outline-offset: 2px;
  }


  /* Same two-rule "+" as the FAQ, at card scale: generated content can't be
     transformed into an "×", a real element can. */
  .pkg-card__mark {
    position: relative;
    flex: none;
    width: 10px;
    height: 10px;
    transition: transform 0.25s ease;
  }

  .pkg-card__mark::before,
  .pkg-card__mark::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1px;
    background: currentColor;
  }

  .pkg-card__mark::after { transform: rotate(90deg); }
  .pkg-card__details[open] .pkg-card__mark { transform: rotate(135deg); }

  /* The global .checklist marker rather than the hairline rows it had: rows
     with rules read as more tappable things, and there is already one control
     and one link on this card. */
  .pkg-card__list {
    list-style: none;
    display: grid;
    gap: 0.5rem;
    padding: 0;
    margin: 0.85rem 0 0.15rem;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .pkg-card__list li {
    position: relative;
    padding-left: 1.15rem;
    color: var(--stone-deep);
  }

  .pkg-card__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.46em;
    width: 0.5em;
    height: 0.5em;
    border: 1.5px solid var(--bamboo);
    border-radius: 50%;
  }

  /* Panel-only keyframe, for the reason spelled out at .faq__panel: a closed
     <details> is display:none, so open animates and close is instant. */
  @keyframes pkg-open {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: none; }
  }

  .pkg-card__details[open] .pkg-card__list {
    animation: pkg-open 0.28s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  /* No margin-top: auto any more. It existed to push the link to the bottom of
     a stretched card; cards are content-height now, so it would only pin the
     link to the bottom of a box it already ends.
     Full width with the arrow at the far edge — the row is the label for a hit
     area that IS the whole card, and a short inline "Learn more →" claimed a
     much smaller one than the pointer actually gets. */
  .pkg-card__more {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.3rem;
