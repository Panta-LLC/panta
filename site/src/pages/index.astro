      />
    </div>
  </section>

  <!-- ===================== 8. founder note ===================== -->
  <section class="section founder" data-section="founder">
    <div class="container founder__grid">
      {/* Width/height are the intrinsic 3:4 of the source, so the browser
          reserves the box before the file arrives and the founder note doesn't
          jump. Not lazy-loaded on purpose — GSAP reveals this section, and a
          lazy image that decodes mid-tween flashes. */}
      <div class="founder__photo">
        <img
          src="/founder/damon-2026.webp"
          width="900"
          height="1200"
          alt="Damon Hastings, founder of Panta"
          decoding="async"
        />
      </div>
      <div class="founder__copy">
        {/* This paragraph and its abstract replacement swapped places. The
            replacement said the organizations deserve "the capabilities and
            support that larger companies take for granted" — true, and true of
            every agency's About page. This one names who is failing them and
            how, which is what makes the mission land as an observation rather
            than a sentiment. */}
        <p>
          I started Panta because the organizations doing the most important work are usually
          the ones with the least support. I understand the challenges of working with limited resources while trying to make a big impact in the community.
        </p>
        <p>
          I’ve spent over 15 years building for companies of every size. Now I bring that experience to the
          people that serve people. If that’s you, we’d love to talk.
        </p>
        <p class="founder__sign">
          — Damon<br />
          <span>Founder, Panta</span>
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== 8.5 FAQ ===================== -->
  <!-- Objections sit adjacent to the ask, so the answers are still on screen
       while the visitor decides. Sans (structure surface) — it also breaks the
       page's only three-serif run: case → pulse → founder → FAQ → final. -->
  <section class="section faq" data-section="faq">
    <div class="container faq__inner">
      <p class="kicker">Questions we get</p>
      <h2 class="faq__head">Before you book, the honest answers.</h2>
      <p class="faq__lede">If yours isn’t here, ask it on the call — or send it below.</p>
      <div class="faq__list">
        {/* Native <details>: keyboard, screen readers and find-in-page all work
            with no JS, which a hand-rolled aria-expanded accordion does not.
            Deliberately NOT name="home-faq" — exclusive accordions collapse the
            answer you were comparing against and jump the scroll position. */}
        {FAQS.map((f) => (
          <details class="faq__item">
            <summary class="faq__q">
              <span>{f.q}</span>
              <span class="faq__mark" aria-hidden="true"></span>
            </summary>
            <div class="faq__panel"><p>{f.a}</p></div>
          </details>
        ))}
