  /* -------------------------------------------------------- case study -- */

  /* Two equal previews rather than one feature plus a text row: with exactly
     two projects, a hero-and-footnote layout made the second look like an
     afterthought. Equal columns say both are the work. */
  .case__grid {
    display: grid;
    gap: clamp(2.25rem, 5vw, 3.5rem);
    /* stretch, not start: with .case__item a column flex and .case__link on
       margin-top:auto, equal card heights put both "Read the full story" links
       on the same baseline. */
    align-items: stretch;
    margin-top: 1.25rem;
