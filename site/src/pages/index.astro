  /* The hover rules for both of these live with the card's own hover state at
     the top of this block — the link's feedback is one behaviour, and splitting
     it across the file is how half of it fell out of sync. */
  .pkg-card__arrow { transition: transform 0.25s ease; }

  @media (prefers-reduced-motion: reduce) {
