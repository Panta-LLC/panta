<script>
  /* The hero is a charcoal surface running under the sticky header, so the
     header needs to know both that it is floating on it AND what colour to be:
     charcoal nav links on a charcoal hero disappear. global.css keys off
     data-hero-theme + data-header, and 'connect' is its charcoal-surface theme
     — every header token follows it. Reusing that rather than restyling the
     header here keeps the two in agreement if either changes. */
  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero) {
    document.documentElement.dataset.heroTheme = 'connect';
    const setHeaderState = (over: boolean) => {
      document.documentElement.dataset.header = over ? 'over-hero' : 'stuck';
    };
    setHeaderState(window.scrollY < hero.offsetHeight - 72);
    new IntersectionObserver(([e]) => setHeaderState(e.isIntersecting), {
      rootMargin: '-72px 0px 0px 0px',
      threshold: 0,
    }).observe(hero);
  }
</script>

<script>
  /* Masonry for the packages grid (§1.5).

     Chrome, Safari and Firefox all still ship CSS masonry behind a flag, so
     `grid-template-rows: masonry` cannot be the layout — but the ingredients
     for it are stable everywhere: every card is given a COLUMN and a row SPAN
     measured off its own height, and `dense` placement drops each one into the
     first free slot in its column. No element is moved in the DOM, which is
     what keeps the GSAP reveals below and the <details> open state intact.

     The column is `i % columns`, not the shortest-column packing a masonry
     library would do. Shortest-column re-sorts on every expand — click "What's
     included" and a card two positions away jumps to another column, which
     reads as a bug. Round-robin keeps the first row in reading order (1, 2, 3)
     and, because a card's column never changes, expanding one only ever moves
     the cards under it.

     Everything here is enhancement: with the script absent or failed, no
     data-masonry attribute is set and the CSS above renders a plain grid whose
     cards are already independent of one another. */
  const grid = document.querySelector<HTMLElement>('.pkg-grid');

  if (grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.pkg-card'));
    /* Must match the grid's own gap. A 1px row unit makes the spans exact —
       a coarser unit rounds every card up and the gaps stop matching the
       column gap, which is the misalignment this is meant to remove. */
    const GAP = 20;

    const columnCount = () =>
      window.matchMedia('(min-width: 1040px)').matches ? 3 :
      window.matchMedia('(min-width: 720px)').matches ? 2 : 1;

    const layout = () => {
      const n = columnCount();

      /* One column is a plain stack — spans and dense placement would only
         re-derive what the grid already does, and the trailing-gap correction
         would cut into the section's padding. */
      if (n === 1) {
        grid.removeAttribute('data-masonry');
        for (const card of cards) {
          card.style.gridColumn = '';
          card.style.gridRowEnd = '';
        }
        return;
      }

      grid.dataset.masonry = '';
      cards.forEach((card, i) => {
        card.style.gridColumn = String((i % n) + 1);
        /* offsetHeight, not the row area: align-items: start means the card is
           its content height whatever span it currently has, so measuring can
           never feed back into what it measures. */
        card.style.gridRowEnd = `span ${card.offsetHeight + GAP}`;
      });
    };

    /* Cards change height for reasons a resize listener never sees: a
       <details> opening, a late webfont rewrapping a heading, an image
       settling. Observing the cards themselves catches all of it, and the
       window listener is only here for the breakpoint crossings, which change
       the column count rather than any card's height. */
    const observer = new ResizeObserver(() => layout());
    for (const card of cards) observer.observe(card);

    /* Synchronous inside the observer, deliberately. Its callbacks run after
       layout and before paint, so re-spanning there lands in the same frame the
       card grew in; deferring to rAF would paint one frame of the open card
       overlapping the one below it. It cannot recurse — a span changes a card's
       grid AREA, and align-items: start means the area never feeds back into
       the card's height.
       The window listener is coalesced because resize fires per pixel and only
       the breakpoint crossings in it matter. */
    let frame = 0;
    window.addEventListener('resize', () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        layout();
      });
    });

    layout();
  }
</script>

<script>
  /* Scroll reveals for everything below the fold. Deliberately a SEPARATE
     script from the header observer above: that observer is functional and has
     to run for everyone, and burying it inside a matchMedia('no-preference')
     block would switch the header's colour handling off for reduced-motion
     users.

     Same contract as about.astro:248-285 — `from` + autoAlpha means the no-JS
     and reduced-motion states are the fully-visible ones, so nothing can get
     stranded at opacity 0. The hero is the exception and is handled first,
     below: it is above the fold, so it runs on load rather than on scroll, and
     it is fromTo() rather than from() because the CSS pre-state means its
     current values ARE the hidden ones (see the hero motion block above). */
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  mm.add('(prefers-reduced-motion: no-preference)', () => {
    /* §1 — the hero, on load. Ordered so the mark settles first and the type
       lands on it: it is the ground, not a competitor. */
    if (document.documentElement.dataset.heroIntro === 'pending') {
      clearTimeout((window as any).__heroIntroWatchdog);

      const intro = gsap.timeline({
        defaults: { ease: 'power3.out' },
        // Dropping the attribute at the end takes the CSS pre-state rules out
        // of play, so a later reflow cannot re-hide anything GSAP has finished.
        onComplete: () => { document.documentElement.dataset.heroIntro = 'done'; },
      });

      intro
        // Scaling from 0.88 rather than fading alone means the whole mark
        // expands into place — one ripple outward, which is the gesture the
        // logo is a drawing of.
        .fromTo('.hero__bg',
          { opacity: 0, scale: 0.88 },
          { opacity: 1, scale: 1, duration: 1.1, ease: 'power2.out' }
        )
        // The audience line arrives just before the claim it qualifies.
        .fromTo('[data-hero="eyebrow"]',
          { opacity: 0, y: 8 },
          { opacity: 1, y: 0, duration: 0.45 },
          '-=0.55'
        )
        // Each word rises out of its own mask, 0.055s apart — close enough to
        // read as one gesture on a ten-word line rather than as ten.
        //
        // `y: 0` in both halves is load-bearing. GSAP parses whatever transform
        // it finds when the tween is created, and the pre-state is
        // translateY(105%) — which computes to a matrix, so GSAP records it as
        // y ≈ 38px, a SEPARATE component from yPercent. Tweening yPercent
        // 105 → 0 alone leaves that 38px in place and every word ends the
        // timeline still sitting below its mask, invisible.
        .fromTo('.hero__word-in',
          { yPercent: 105, y: 0 },
          { yPercent: 0, y: 0, duration: 0.75, stagger: 0.055 },
          '-=0.2'
        )
        .fromTo('[data-hero="sub"]',
          { opacity: 0, y: 14 },
          { opacity: 1, y: 0, duration: 0.55 },
          '-=0.45'
        )
        .fromTo('[data-hero="act"]',
          { opacity: 0, y: 14 },
          { opacity: 1, y: 0, duration: 0.5 },
          '-=0.35'
        )
        .fromTo('[data-hero="micro"]',
          { opacity: 0 },
          { opacity: 1, duration: 0.4 },
          '-=0.3'
        )
        // The cards arrive as one block rather than staggered card by card:
        // they are the alternative to the ask above them, and a six-step
        // ripple across them would read as a second, competing event.
        .fromTo('[data-hero="cards"]',
          { opacity: 0, y: 16 },
          { opacity: 1, y: 0, duration: 0.5 },
          '-=0.25'
        )
        // Proof last: it is the thing you read after you have already read the
        // ask and seen the range.
        .fromTo('[data-hero="proof"]',
          { opacity: 0, y: 12 },
          { opacity: 1, y: 0, duration: 0.5 },
          '-=0.3'
        );
    }

    /* One call per visual GROUP, never per section: a single stagger spanning
       a whole section puts a ~1.2s ramp on one screen, which reads as the page
       withholding rather than arriving. */
    const reveal = (target: string, trigger: string, vars: gsap.TweenVars = {}) => {
      const { start = 'top 80%', ...tween } = vars as any;
      return gsap.from(target, {
        autoAlpha: 0,
        y: 24,
        duration: 0.6,
        ease: 'power2.out',
        ...tween,
        scrollTrigger: { trigger, start },
      });
    };

    // 1.5 packages — two calls, not one: a single stagger across a kicker, a
    //     head and five cards would put a ~1.2s ramp on one screen. This is the
    //     section directly under the hero now, so it takes the early start the
    //     case study used to need — at `top 80%` the first row is already on
    //     screen at first paint on a tall viewport and never visibly runs.
    reveal('.pkgs .kicker, .pkgs__head', '.pkgs', { y: 16, stagger: 0.08, start: 'top 88%' });
    reveal('.pkg-card', '.pkg-grid', { y: 20, duration: 0.5, stagger: 0.08, start: 'top 88%' });

    // 2. case — kept at the early start: the packages grid above it is short
    //    enough that on a tall viewport the first card is still near the fold.
    reveal('.case__item', '.case__grid', { y: 22, stagger: 0.12, start: 'top 88%' });
    reveal('.case__trust > *', '.case__trust', { y: 12, duration: 0.45, stagger: 0.08 });

    // 4. pillars — three reading beats, three calls
    reveal('.pillar', '.pillars', { y: 26, stagger: 0.12 });
    reveal('.pillars__cta, .pillars__actions, .pillars__escape', '.pillars__close', {
      y: 18, stagger: 0.1,
    });
    reveal('.pillars__proof', '.pillars__close', { x: 18, y: 0, duration: 0.7 });

    // 5. process
    reveal('.step', '.steps', { stagger: 0.12 });
    gsap.from('.step__n', {
      scrollTrigger: { trigger: '.steps', start: 'top 80%' },
      autoAlpha: 0, scale: 0.7, transformOrigin: '0% 100%',
      duration: 0.5, stagger: 0.12, ease: 'back.out(1.6)',
    });

    // 6. mid-page catch
    reveal('.mid-ask__grid > *', '.mid-ask', { y: 16, duration: 0.5, stagger: 0.1, start: 'top 88%' });

    // 7. Pulse strip
    reveal('.pulse-card', '.pulse-cards', { stagger: 0.1 });

    // 8. founder
    reveal('.founder__photo', '.founder__grid', { x: -18, y: 0, duration: 0.7 });
    reveal('.founder__copy > *', '.founder__grid', { y: 18, stagger: 0.1 });

    // 8.5 FAQ — faster and tighter; a list of questions should not feel staged
    reveal('.faq__head, .faq__lede', '.faq', { y: 16, stagger: 0.08 });
    reveal('.faq__item', '.faq__list', { y: 14, duration: 0.45, stagger: 0.07 });

    // 9. final — the rings settle inward, then the ask, then the form
    gsap.from('.final .ripple-mark circle', {
      scrollTrigger: { trigger: '.final', start: 'top 78%' },
      autoAlpha: 0, scale: 0.15, transformOrigin: '50% 50%',
      duration: 0.7, stagger: { each: 0.14, from: 'end' }, ease: 'power1.out',
    });
    reveal('.final__head, .final__body, .final__micro', '.final__inner', {
      y: 20, stagger: 0.1,
    });
    reveal('.final__act', '.final__grid', { y: 24, duration: 0.7, start: 'top 72%' });
  });
</script>
