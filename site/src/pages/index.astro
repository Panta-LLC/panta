---
import Base from '../layouts/Base.astro';
import RippleMark from '../components/RippleMark.astro';
---
<Base
  title="Panta — Build, Connect, Create for community growth"
  description="Panta builds, connects, and creates for community growth and development — starting with Digital Business Consulting for small businesses, nonprofits, and independent practices."
>
  <section class="section section--dark hero">
    <div class="container">
      <p class="label">Panta</p>
      <h1>We build, connect, and create — for community growth.</h1>
      <p class="lede">
        Panta exists to help community-based businesses and organizations grow
        their reach and their mission — with big-company capability, delivered
        at the scale and warmth a small team can trust.
      </p>
      <div class="btn-row">
        <a href="/digital-business-consulting/" class="btn btn--primary">Explore Digital Business Consulting</a>
        <a href="/consultation/" class="btn btn--ghost">Book a free 30-minute audit</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label">What we do</p>
      <h2>Three verbs, one mission.</h2>
      <div class="grid grid--3" style="margin-top: 2.5rem;">
        <div class="card">
          <p class="card__kicker">Build</p>
          <h3>The things that work</h3>
          <p>
            Websites, software, and systems — engineered to what your
            organization actually needs, and built to be maintained, not
            admired.
          </p>
        </div>
        <div class="card">
          <p class="card__kicker">Connect</p>
          <h3>The places that matter</h3>
          <p>
            The channels, networks, and directories where your community
            already looks — connected to each other so every door leads
            somewhere.
          </p>
        </div>
        <div class="card">
          <p class="card__kicker">Create</p>
          <h3>The story that carries</h3>
          <p>
            Brand, content, and design that make you recognizable everywhere
            you show up — and give people a reason to come back.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--bamboo">
    <div class="container">
      <p class="label">The first of many branches</p>
      <h2>Digital Business Consulting</h2>
      <p class="lede" style="max-width: 56ch;">
        Our first practice: helping small businesses, nonprofits, and
        independent practices build a digital presence that actually works —
        strategy and engineering from the same hands.
      </p>
      <div class="card" style="background: var(--cream); border-color: transparent; color: var(--charcoal); margin-top: 2rem; max-width: 44rem;">
        <ul class="checklist" style="margin-bottom: 1.25rem;">
          <li><strong>Digital Presence Plan</strong> — a graded read on where you stand and a 90-day roadmap forward</li>
          <li><strong>Design, build &amp; configure web channels</strong> — website, social, Google Business Profile, directories</li>
          <li><strong>Content creation &amp; marketing</strong> — a rhythm you can sustain, measured honestly</li>
          <li><strong>Brand development</strong> — one recognizable identity across every channel</li>
        </ul>
        <a href="/digital-business-consulting/" class="btn btn--primary">See the practice</a>
      </div>
      <p class="small" style="margin-top: 1.5rem; color: var(--cream);">
        More branches are growing. That's the point of the ripple.
      </p>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container" style="display: grid; gap: 2rem; justify-items: start;">
      <RippleMark size={56} />
      <div>
        <h2>One good move, felt everywhere.</h2>
        <p class="lede" style="max-width: 54ch;">
          Our mark is a planted seed sending ripples outward — one clear act at
          the core, its effect widening into the world. Every branch of Panta
          starts the same way: with one good move for a community we care
          about.
        </p>
        <div class="btn-row" style="margin-top: 1rem;">
          <a href="/consultation/" class="btn btn--primary">Start with a free conversation</a>
        </div>
      </div>
    </div>
  </section>
</Base>
