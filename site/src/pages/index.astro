  .faq__q::-webkit-details-marker { display: none; }
  .faq__item:hover .faq__q { color: var(--bamboo-deep); }

  /* A "+" drawn from two rules so it can rotate into an "×" — generated
     content can't be transformed, a real element can. Stone rather than
     bamboo: §3 allows green in exactly four places and this is not one. */
  .faq__mark {
    position: relative;
    flex: none;
    width: 12px;
    height: 12px;
    transition: transform 0.25s ease;
