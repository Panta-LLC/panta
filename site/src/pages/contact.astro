---
import Base from '../layouts/Base.astro';
import { getDoc } from '../lib/sanity.js';

const c = await getDoc('contactPage');
const settings = await getDoc('siteSettings');
---
<Base
  title="Contact Panta — book a free 30-minute audit"
  description="Tell us what's not working about your online presence. We reply within one business day — because response speed is one of the things we audit."
>
  <section class="section section--dark" style="padding-block: clamp(3rem, 7vw, 5rem);">
    <div class="container">
      <p class="label" data-default={c.heroLabel} data-quote={c.quoteHeroLabel}>{c.heroLabel}</p>
      <h1 style="font-size: clamp(2.2rem, 4.5vw, 3.2rem);" data-default={c.heroTitle} data-quote={c.quoteHeroTitle}>{c.heroTitle}</h1>
      <p class="lede" data-default={c.heroLede} data-quote={c.quoteHeroLede}>{c.heroLede}</p>
      <div class="btn-row">
        <a
          href="/consultation/"
          class="btn btn--primary"
          data-track="cta_click"
          data-track-cta="consultation"
          data-track-location="contact_hero"
        >{c.heroCtaLabel}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--2" style="gap: 3rem; align-items: start;">
        <div>
          <p class="form-status form-status--ok" id="status-sent" hidden>
            Sent — thank you. We'll reply within one business day.
          </p>
          <p class="form-status form-status--err" id="status-error" hidden>
            Something went wrong sending that. Email us directly instead —
            <a href="mailto:hello@panta.llc">hello@panta.llc</a>.
          </p>
          <form class="form-grid" method="post" action="/api/contact">
            <div class="hp-field" aria-hidden="true">
              <label for="website">Leave this field empty</label>
              <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <div>
              <label for="name">Your name</label>
              <input type="text" id="name" name="name" autocomplete="name" required />
            </div>
            <div>
              <label for="org">Organization</label>
              <input type="text" id="org" name="org" autocomplete="organization" />
            </div>
            <div>
              <label for="email">Email</label>
              <input type="email" id="email" name="email" autocomplete="email" required />
            </div>
            <div>
              <label for="message">What made you reach out now?</label>
              <textarea id="message" name="message" rows="5" placeholder="The itch. A form nobody fills out, a listing with the wrong hours, a hunch you're invisible on Google…"></textarea>
            </div>
            <div>
              <button type="submit" class="btn btn--primary">Send it over</button>
            </div>
          </form>
        </div>
        <div>
          <p class="label">{c.emailLabel}</p>
          <p style="font-family: var(--font-serif); font-size: 1.5rem;">
            <a href={`mailto:${settings.email}`}>{settings.email}</a>
          </p>
          <hr class="divider" />
          <p class="label">{c.nextLabel}</p>
          <ul class="checklist">
            {c.nextItems.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const track = (window as any).pantaTrack ?? (() => {});

  // /api/contact redirects to a bare ?sent=1, so ?quote=1 is gone by the time
  // we report the lead. Stash the intent on the way in and read it back after.
  const INTENT_KEY = 'panta:contact-intent';
  const readIntent = () => {
    try {
      return sessionStorage.getItem(INTENT_KEY) ?? 'general';
    } catch (_) {
      return 'general';
    }
  };

  const params = new URLSearchParams(window.location.search);
  if (params.has('sent')) {
    document.getElementById('status-sent')?.removeAttribute('hidden');
    // Fired on the post-redirect landing rather than on submit: /api/contact
    // only sends us here once the mail actually went out, so this counts real
    // leads instead of clicks that failed validation or SMTP.
    track('contact_submitted', { intent: readIntent() });
    try {
      sessionStorage.removeItem(INTENT_KEY);
    } catch (_) {
      /* swallow */
    }
  } else if (params.has('error')) {
    document.getElementById('status-error')?.removeAttribute('hidden');
    track('contact_failed', { intent: readIntent() });
  }

  // Quote mode: arriving from a "Get a quote" CTA swaps the hero copy so the
  // intent carries through instead of landing on a generic contact page.
  if (params.has('quote')) {
    try {
      sessionStorage.setItem(INTENT_KEY, 'quote');
    } catch (_) {
      /* swallow */
    }
    document.querySelectorAll<HTMLElement>('[data-quote]').forEach((el) => {
      const quoteCopy = el.dataset.quote;
      if (quoteCopy) el.textContent = quoteCopy;
    });
    const message = document.getElementById('message') as HTMLTextAreaElement | null;
    if (message) {
      message.placeholder =
        'What you have now, what you need built, and roughly when you need it.';
    }
  }
</script>

<style>
  .form-status {
    padding: 0.9rem 1.1rem;
    border-radius: 8px;
    margin-bottom: 1.25rem;
    font-size: 0.95rem;
  }

  .form-status--ok {
    background: #eef0e0;
    border: 1px solid var(--sage);
    color: var(--bamboo-deep);
  }

  .form-status--err {
    background: #f7e9e4;
    border: 1px solid #d9a08c;
    color: #8a4a2f;
  }

  /* honeypot: hidden from people, present for bots */
  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
