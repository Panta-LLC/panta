---
import Base from '../layouts/Base.astro';
---
<Base
  title="The Client Journey — Panta"
  description="Every path a client can take from discovering you to choosing you — and where each one can leak."
  noindex
>
  <section class="section section--dark" style="padding-block: clamp(3rem, 7vw, 5rem);">
    <div class="container">
      <p class="label">The client journey</p>
      <h1 style="font-size: clamp(2.2rem, 4.5vw, 3.2rem);">Many doors. One destination.</h1>
      <p class="lede">
        Every client arrives by a different path — a search, a map, a feed, a
        friend. Scroll to move through the journey stage by stage, from
        <em>find</em> to <em>trust</em> to <em>choose</em> — including the two
        places most businesses quietly lose them.
      </p>
      <div class="btn-row" style="margin-top: 1.25rem;">
        <button id="journey-play" class="btn btn--primary" type="button" style="display: none; cursor: pointer;">
          ▶&nbsp; Play the journey
        </button>
        <p class="small" style="margin: 0;">↓ or scroll at your own pace</p>
      </div>
    </div>
  </section>

  <section id="journey-stage" class="journey-stage">
    <div class="journey-layout">
      <div class="journey-captions" aria-live="polite">
        <div class="jcap jcap--find">
          <p class="label">Stage one</p>
          <h2>Find</h2>
          <p>
            The journey starts in many places at once. A Google search, a maps
            result, a scroll past your post, a directory, a review site, a
            friend's recommendation — every one is a front door.
          </p>
        </div>
        <div class="jcap jcap--trust">
          <p class="label">Stage two</p>
          <h2>Trust</h2>
          <p>
            Before anyone acts, they verify: reviews, consistent info, signs of
            life. Most paths route through your website — the hub. Stale or
            conflicting info leaks people here, silently.
          </p>
        </div>
        <div class="jcap jcap--choose">
          <p class="label">Stage three</p>
          <h2>Choose</h2>
          <p>
            Every channel needs a working next step — call, book, message. Some
            paths never touch your website at all. Friction here is the most
            expensive leak, and the cheapest to fix.
          </p>
        </div>
        <div class="jcap jcap--convert">
          <p class="label">Arrival</p>
          <h2>Convert</h2>
          <p>
            Every surviving path lands in the same place: a new client, donor,
            or booking. Then the ripple starts — reviews and referrals feed the
            journey's front doors all over again.
          </p>
        </div>
      </div>

      <div class="journey-canvas">
        <svg
          viewBox="0 0 840 1080"
          role="img"
          aria-label="Diagram of every client path from finding a business, through trust checks, to conversion — including leak points"
          class="journey-svg"
        >
          <!-- stage band labels (revealed with their stage) -->
          <text class="band-label band-label--find" x="32" y="66">Find</text>
          <text class="band-label band-label--trust" x="32" y="428">Trust</text>
          <text class="band-label band-label--choose" x="32" y="784">Choose</text>

          <!-- ============ paths: find → trust ============ -->
          <g class="segs segs--trust">
            <path class="seg" pathLength="1" d="M90 164 C 90 300 210 480 322 572" />
            <path class="seg" pathLength="1" d="M222 164 C 214 260 186 380 172 464" />
            <path class="seg" pathLength="1" d="M354 164 C 360 280 380 440 398 560" />
            <path class="seg" pathLength="1" d="M486 164 C 480 280 462 440 450 560" />
            <path class="seg" pathLength="1" d="M618 164 C 600 300 522 486 478 564" />
            <path class="seg" pathLength="1" d="M750 164 C 745 260 700 380 678 464" />
            <!-- trust internals → hub -->
            <path class="seg" pathLength="1" d="M172 508 C 182 558 240 594 300 599" />
            <path class="seg" pathLength="1" d="M420 484 C 420 510 420 536 420 560" />
            <path class="seg" pathLength="1" d="M672 508 C 660 558 600 596 540 599" />
            <!-- leak 1: stale info -->
            <path class="seg seg--leak" pathLength="1" d="M517 462 C 620 470 722 510 782 552" />
          </g>

          <!-- ============ paths: trust → choose ============ -->
          <g class="segs segs--choose">
            <path class="seg" pathLength="1" d="M338 637 C 260 700 202 760 184 820" />
            <path class="seg" pathLength="1" d="M420 637 C 420 700 420 760 420 820" />
            <!-- reviews check → call (maps path skips the website) -->
            <path class="seg" pathLength="1" d="M168 508 C 148 620 158 730 176 818" />
            <!-- freshness → dm/visit (social proof path skips the website) -->
            <path class="seg" pathLength="1" d="M674 508 C 682 620 668 730 654 818" />
            <path class="seg" pathLength="1" d="M502 637 C 560 700 620 758 644 818" />
          </g>

          <!-- ============ paths: choose → convert ============ -->
          <g class="segs segs--convert">
            <path class="seg" pathLength="1" d="M184 872 C 220 940 322 986 398 998" />
            <path class="seg" pathLength="1" d="M420 874 C 420 902 420 930 420 958" />
            <path class="seg" pathLength="1" d="M648 872 C 612 940 502 992 444 1000" />
            <!-- leak 2: no reply -->
            <path class="seg seg--leak" pathLength="1" d="M458 880 C 502 914 540 944 556 964" />
            <!-- the ripple loop: converts become referrers -->
            <path class="seg seg--loop" pathLength="1" d="M456 982 C 762 900 806 420 760 172" />
          </g>

          <!-- ============ FIND: entry nodes ============ -->
          <g class="nodes nodes--find">
            <g class="node">
              <rect x="34" y="120" width="112" height="44" rx="22" />
              <text class="node-label" x="90" y="147">Search</text>
              <text class="node-sub" x="90" y="182">Google</text>
            </g>
            <g class="node">
              <rect x="166" y="120" width="112" height="44" rx="22" />
              <text class="node-label" x="222" y="147">Maps</text>
              <text class="node-sub" x="222" y="182">Business Profile</text>
            </g>
            <g class="node">
              <rect x="298" y="120" width="112" height="44" rx="22" />
              <text class="node-label" x="354" y="147">Social</text>
              <text class="node-sub" x="354" y="182">feeds &amp; posts</text>
            </g>
            <g class="node">
              <rect x="430" y="120" width="112" height="44" rx="22" />
              <text class="node-label" x="486" y="147">Directories</text>
              <text class="node-sub" x="486" y="182">industry lists</text>
            </g>
            <g class="node">
              <rect x="562" y="120" width="112" height="44" rx="22" />
              <text class="node-label" x="618" y="147">Reviews</text>
              <text class="node-sub" x="618" y="182">Yelp &amp; friends</text>
            </g>
            <g class="node">
              <rect x="694" y="120" width="112" height="44" rx="22" />
              <text class="node-label" x="750" y="147">Referral</text>
              <text class="node-sub" x="750" y="182">word of mouth</text>
            </g>
          </g>

          <!-- ============ TRUST: checkpoints + hub ============ -->
          <g class="nodes nodes--trust">
            <g class="node node--check">
              <rect x="104" y="444" width="136" height="42" rx="21" />
              <text class="node-label" x="172" y="470">4.8★ reviews</text>
            </g>
            <g class="node node--check">
              <rect x="322" y="442" width="196" height="42" rx="21" />
              <text class="node-label" x="420" y="468">same info everywhere</text>
            </g>
            <g class="node node--check">
              <rect x="602" y="444" width="140" height="42" rx="21" />
              <text class="node-label" x="672" y="470">signs of life</text>
            </g>
            <g class="node node--hub">
              <rect x="298" y="562" width="244" height="74" rx="14" />
              <text class="hub-label" x="420" y="594">Your website</text>
              <text class="hub-sub" x="420" y="620">the hub most paths check</text>
            </g>
            <g class="leak-mark leak-mark--1">
              <text class="leak-x" x="793" y="562">✕</text>
              <text class="leak-label" x="656" y="524">stale info — lost</text>
            </g>
          </g>

          <!-- ============ CHOOSE: actions ============ -->
          <g class="nodes nodes--choose">
            <g class="node node--action">
              <rect x="118" y="822" width="128" height="48" rx="24" />
              <text class="action-label" x="182" y="851">Call</text>
            </g>
            <g class="node node--action">
              <rect x="352" y="822" width="136" height="48" rx="24" />
              <text class="action-label" x="420" y="851">Book / form</text>
            </g>
            <g class="node node--action">
              <rect x="586" y="822" width="128" height="48" rx="24" />
              <text class="action-label" x="650" y="851">DM / visit</text>
            </g>
            <g class="leak-mark leak-mark--2">
              <text class="leak-x" x="565" y="984">✕</text>
              <text class="leak-label" x="590" y="948">no reply — lost</text>
            </g>
          </g>

          <!-- ============ CONVERT: the ripple ============ -->
          <g class="nodes nodes--convert">
            <g class="ripple">
              <circle cx="420" cy="1002" r="38" class="ring ring--outer" />
              <circle cx="420" cy="1002" r="25" class="ring ring--mid" />
              <circle cx="420" cy="1002" r="12" class="ring ring--core" />
            </g>
            <text class="convert-label" x="420" y="1068">a new client, donor, or booking</text>
            <text class="loop-label" x="712" y="600">reviews &amp; referrals</text>
          </g>
        </svg>
      </div>
    </div>

    <!-- vertical journey timeline, right side -->
    <div class="journey-rail">
      <div class="journey-rail__line" aria-hidden="true"></div>
      <button type="button" class="journey-rail__node" data-rail="0" style="top: 2%;" aria-label="Go to stage: Find"><span>Find</span></button>
      <button type="button" class="journey-rail__node" data-rail="1" style="top: 34%;" aria-label="Go to stage: Trust"><span>Trust</span></button>
      <button type="button" class="journey-rail__node" data-rail="2" style="top: 66%;" aria-label="Go to stage: Choose"><span>Choose</span></button>
      <button type="button" class="journey-rail__node" data-rail="3" style="top: 94%;" aria-label="Go to stage: Convert"><span>Convert</span></button>
      <div class="journey-rail__marker">
        <svg viewBox="0 0 48 48" width="18" height="18" fill="none" aria-hidden="true">
          <circle cx="24" cy="24" r="21" stroke="#26251F" stroke-width="2.2" />
          <circle cx="24" cy="24" r="13.5" stroke="#26251F" stroke-width="3.2" />
          <circle cx="24" cy="24" r="6" stroke="#6F8B3C" stroke-width="4.8" />
        </svg>
      </div>
    </div>

    <div class="scroll-hint" aria-hidden="true">
      <span>Scroll</span><span class="scroll-hint__arrow">↓</span>
    </div>
    <div class="journey-progress" aria-hidden="true">
      <div class="journey-progress__bar"></div>
    </div>
  </section>

  <button id="journey-toggle" class="journey-toggle" type="button" aria-label="Play the journey">▶</button>

  <section class="section">
    <div class="container">
      <p class="label">What the picture says</p>
      <h2>Four things every business should notice.</h2>
      <ul class="checklist" style="margin-top: 1.5rem;">
        <li><strong>There is no single front door.</strong> Six channels feed the same journey — a gap in any one of them is invisible to you and obvious to the client who walked through it.</li>
        <li><strong>Trust is a checkpoint, not a feeling.</strong> Reviews, consistency, and freshness get verified on every path — usually before your website ever loads.</li>
        <li><strong>Some paths skip your website entirely.</strong> Maps-to-call and social-to-DM convert on the channel itself — which is why every channel needs a working next step.</li>
        <li><strong>The journey is a loop.</strong> Converted clients become the reviews and referrals that feed the front doors. That's the ripple.</li>
      </ul>
      <div class="btn-row" style="margin-top: 2rem;">
        <a href="/services/" class="btn btn--primary">Find where your journey leaks</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .journey-stage {
    position: relative;
    background: var(--cream);
    min-height: 100svh;
  }

  .journey-layout {
    display: grid;
    grid-template-columns: minmax(260px, 340px) 1fr;
    gap: 1.5rem;
    align-items: center;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 2.5rem);
    height: 100svh;
  }

  .journey-captions {
    position: relative;
    min-height: 16rem;
  }

  .jcap {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
  }

  /* Static / no-JS / reduced-motion fallback: first caption visible, full diagram drawn */
  .jcap--find {
    opacity: 1;
    visibility: visible;
  }

  .jcap h2 {
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    margin-bottom: 0.4em;
  }

  .journey-canvas {
    height: min(92svh, 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .journey-svg {
    height: 100%;
    max-width: 100%;
    display: block;
  }

  @media (max-width: 719px) {
    .journey-layout {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      align-items: start;
      padding-top: 1rem;
      gap: 0.5rem;
    }
    .journey-captions {
      min-height: 11.5rem;
    }
    .jcap p:not(.label) {
      font-size: 0.95rem;
      line-height: 1.5;
    }
    .journey-canvas {
      height: auto;
      min-height: 0;
    }
    .journey-svg {
      height: auto;
      width: 100%;
      max-height: calc(100svh - 14rem);
    }
  }

  /* --- SVG styling ------------------------------------------------------- */
  /* NOTE: keep type selectors out of text rules — `.journey-svg text` would
     out-rank the per-class fills/anchors and break them. */

  .journey-svg {
    font-family: var(--font-sans);
  }

  .journey-svg text.band-label {
    text-anchor: start;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    fill: var(--stone);
  }

  .seg {
    fill: none;
    stroke: var(--charcoal);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.55;
    stroke-dasharray: 1;
    stroke-dashoffset: 0; /* fully drawn by default; JS rewinds then animates */
  }

  .seg--leak {
    stroke: var(--stone);
    stroke-width: 1.8;
    stroke-dasharray: 0.04 0.02; /* dashed, in pathLength units */
    opacity: 0.75;
  }

  .seg--loop {
    stroke: var(--bamboo);
    stroke-width: 2;
    stroke-dasharray: 0.018 0.014;
    opacity: 0.9;
  }

  .node rect {
    fill: #fffdf7;
    stroke: var(--charcoal);
    stroke-width: 1.6;
  }

  .node-label {
    font-size: 17px;
    font-weight: 500;
    fill: var(--charcoal);
    text-anchor: middle;
  }

  .node-sub {
    font-size: 12.5px;
    fill: var(--stone-deep);
    text-anchor: middle;
  }

  .node--check rect {
    fill: #eef0e0;
    stroke: var(--bamboo-deep);
    stroke-width: 1.5;
  }

  .node--check .node-label {
    font-size: 15.5px;
    fill: var(--bamboo-deep);
    font-weight: 500;
  }

  .node--hub rect {
    fill: var(--cream);
    stroke: var(--charcoal);
    stroke-width: 2.4;
  }

  .hub-label {
    font-family: var(--font-serif);
    font-size: 23px;
    fill: var(--charcoal);
    text-anchor: middle;
  }

  .hub-sub {
    font-size: 12.5px;
    fill: var(--stone-deep);
    text-anchor: middle;
  }

  .node--action rect {
    fill: var(--charcoal);
    stroke: none;
  }

  .action-label {
    font-size: 16.5px;
    font-weight: 500;
    fill: var(--cream);
    text-anchor: middle;
  }

  .leak-x {
    font-size: 20px;
    fill: var(--stone);
    font-weight: 600;
    text-anchor: middle;
  }

  .leak-label {
    font-size: 13px;
    fill: var(--stone-deep);
    font-style: italic;
    text-anchor: middle;
  }

  .ring {
    fill: none;
    stroke: var(--charcoal);
  }

  .ring--outer { stroke-width: 1.4; }
  .ring--mid { stroke-width: 2.4; }
  .ring--core {
    stroke: var(--bamboo);
    stroke-width: 4;
  }

  .convert-label {
    font-size: 15px;
    fill: var(--stone-deep);
    text-anchor: middle;
  }

  .loop-label {
    font-size: 13px;
    fill: var(--bamboo-deep);
    font-style: italic;
    text-anchor: middle;
  }

  /* --- timeline rail ------------------------------------------------------ */

  .journey-rail {
    position: absolute;
    right: clamp(0.9rem, 2.5vw, 2.25rem);
    top: 50%;
    transform: translateY(-50%);
    height: 68svh;
    width: 30px;
    opacity: 0; /* shown by JS only when the scroll experience is active */
    pointer-events: none;
  }

  .journey-rail__line {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    transform: translateX(-50%);
    background: var(--line);
  }

  .journey-rail__node {
    position: absolute;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 11px;
    height: 11px;
    padding: 0;
    border-radius: 50%;
    background: var(--cream);
    border: 2px solid var(--stone);
    transition: background 0.3s ease, border-color 0.3s ease;
    pointer-events: auto;
    cursor: pointer;
  }

  /* generous click target around each small dot */
  .journey-rail__node::after {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 50%;
  }

  .journey-rail__node:hover {
    border-color: var(--bamboo);
  }

  .journey-rail__node.is-active {
    background: var(--bamboo);
    border-color: var(--bamboo);
  }

  .journey-rail__node span {
    position: absolute;
    right: 1.3rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--stone-deep);
    white-space: nowrap;
    transition: color 0.3s ease;
  }

  .journey-rail__node.is-active span {
    color: var(--bamboo-deep);
  }

  .journey-rail__marker {
    position: absolute;
    left: 50%;
    top: 0%;
    transform: translate(-50%, -50%);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--cream);
    border: 1px solid var(--line);
    box-shadow: 0 2px 8px rgba(38, 37, 31, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  @media (max-width: 719px) {
    .journey-rail { right: 0.5rem; }
    .journey-rail__node span { display: none; }
  }

  /* --- play/pause, scroll hint & progress --------------------------------- */

  .journey-toggle {
    position: fixed;
    left: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    border: none;
    background: var(--charcoal);
    color: var(--cream);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    display: none; /* shown by JS only when the scroll experience is active */
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(38, 37, 31, 0.3);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .journey-toggle:hover {
    background: var(--bamboo);
    color: var(--charcoal);
    transform: scale(1.05);
  }

  .scroll-hint {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.05rem;
    border-radius: 999px;
    background: var(--charcoal);
    color: var(--cream);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    opacity: 0; /* shown by JS only when the scroll experience is active */
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .scroll-hint__arrow {
    display: inline-block;
    animation: hint-bob 1.4s ease-in-out infinite;
  }

  @keyframes hint-bob {
    0%, 100% { transform: translateY(-1px); }
    50% { transform: translateY(3px); }
  }

  .journey-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--line);
    opacity: 0; /* shown by JS only when the scroll experience is active */
  }

  .journey-progress__bar {
    height: 100%;
    background: var(--bamboo);
    transform: scaleX(0);
    transform-origin: left center;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint__arrow { animation: none; }
  }
</style>

<style is:global>
  /* CSS smooth-scrolling fights the JS-driven autoplay on this page */
  html { scroll-behavior: auto; }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { ScrollToPlugin } from 'gsap/ScrollToPlugin';

  gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

  const mm = gsap.matchMedia();

  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const stageEl = document.querySelector('#journey-stage');
    if (!stageEl) return;

    // Rewind everything (CSS default is the fully-drawn static fallback)
    gsap.set('.segs .seg', { strokeDashoffset: 1 });
    gsap.set('.seg--leak', { strokeDashoffset: 0, autoAlpha: 0 });
    gsap.set('.seg--loop', { strokeDashoffset: 0, autoAlpha: 0 });
    gsap.set('.nodes--find .node, .nodes--trust .node, .nodes--choose .node', { autoAlpha: 0, y: 14 });
    gsap.set('.band-label', { autoAlpha: 0 });
    gsap.set('.leak-mark', { autoAlpha: 0 });
    gsap.set('.nodes--convert .ripple .ring', { autoAlpha: 0, scale: 0.4, transformOrigin: '420px 1002px' });
    gsap.set('.convert-label, .loop-label', { autoAlpha: 0 });
    gsap.set('.jcap', { autoAlpha: 0 });

    const hint = document.querySelector('.scroll-hint') as HTMLElement | null;
    const bar = document.querySelector('.journey-progress__bar') as HTMLElement | null;
    const marker = document.querySelector('.journey-rail__marker') as HTMLElement | null;
    const railNodes = Array.from(document.querySelectorAll('.journey-rail__node'));
    const toggle = document.getElementById('journey-toggle') as HTMLButtonElement | null;
    const heroPlay = document.getElementById('journey-play') as HTMLButtonElement | null;

    gsap.set('.scroll-hint, .journey-progress, .journey-rail', { autoAlpha: 1 });
    if (toggle) toggle.style.display = 'flex';
    if (heroPlay) heroPlay.style.display = 'inline-flex';

    // Rail node fractions double as the stage-transition thresholds:
    // when the marker reaches a node, that stage's slide plays.
    const THRESHOLDS = [0.02, 0.34, 0.66, 0.94];
    const CAPS = ['.jcap--find', '.jcap--trust', '.jcap--choose', '.jcap--convert'];
    const BANDS = ['.band-label--find', '.band-label--trust', '.band-label--choose'];

    let stage = -1;
    let transTl: gsap.core.Timeline | null = null;

    function applyStage(next: number) {
      if (next === stage) return;
      const entering = next > stage;
      stage = next;
      transTl?.kill();
      const tl = gsap.timeline({ defaults: { ease: 'power2.out' } });
      transTl = tl;

      // caption swap
      tl.to('.jcap', { autoAlpha: 0, duration: 0.25 }, 0);
      tl.to(CAPS[next], { autoAlpha: 1, duration: 0.5 }, 0.2);

      // band labels accumulate with the stages
      BANDS.forEach((b, i) => tl.to(b, { autoAlpha: next >= i ? 1 : 0, duration: 0.3 }, 0));

      const settle = (sel: string, vars: gsap.TweenVars) =>
        tl.to(sel, { ...vars, duration: 0.3, overwrite: 'auto' }, 0);

      // --- stage 0: entry nodes (always on once the journey starts) -------
      if (next === 0 && entering) {
        tl.to('.nodes--find .node', { autoAlpha: 1, y: 0, duration: 0.7, stagger: 0.08 }, 0.1);
      } else {
        settle('.nodes--find .node', { autoAlpha: 1, y: 0 });
      }

      // --- stage 1: trust ---------------------------------------------------
      if (next >= 1) {
        if (next === 1 && entering) {
          tl.to('.segs--trust .seg:not(.seg--leak)', { strokeDashoffset: 0, duration: 0.9, stagger: 0.06, ease: 'power1.inOut' }, 0.1);
          tl.to('.nodes--trust .node', { autoAlpha: 1, y: 0, duration: 0.6, stagger: 0.08 }, 0.5);
          tl.to('.segs--trust .seg--leak', { autoAlpha: 1, duration: 0.5 }, 0.95);
          tl.to('.leak-mark--1', { autoAlpha: 1, duration: 0.5 }, 1.1);
        } else {
          settle('.segs--trust .seg:not(.seg--leak)', { strokeDashoffset: 0 });
          settle('.nodes--trust .node', { autoAlpha: 1, y: 0 });
          settle('.segs--trust .seg--leak', { autoAlpha: 1 });
          settle('.leak-mark--1', { autoAlpha: 1 });
        }
      } else {
        settle('.segs--trust .seg:not(.seg--leak)', { strokeDashoffset: 1 });
        settle('.nodes--trust .node', { autoAlpha: 0, y: 14 });
        settle('.segs--trust .seg--leak', { autoAlpha: 0 });
        settle('.leak-mark--1', { autoAlpha: 0 });
      }

      // --- stage 2: choose --------------------------------------------------
      if (next >= 2) {
        if (next === 2 && entering) {
          tl.to('.segs--choose .seg', { strokeDashoffset: 0, duration: 0.9, stagger: 0.07, ease: 'power1.inOut' }, 0.1);
          tl.to('.nodes--choose .node', { autoAlpha: 1, y: 0, duration: 0.6, stagger: 0.1 }, 0.55);
        } else {
          settle('.segs--choose .seg', { strokeDashoffset: 0 });
          settle('.nodes--choose .node', { autoAlpha: 1, y: 0 });
        }
      } else {
        settle('.segs--choose .seg', { strokeDashoffset: 1 });
        settle('.nodes--choose .node', { autoAlpha: 0, y: 14 });
      }

      // --- stage 3: convert -------------------------------------------------
      if (next >= 3) {
        if (next === 3 && entering) {
          tl.to('.segs--convert .seg:not(.seg--leak):not(.seg--loop)', { strokeDashoffset: 0, duration: 0.8, stagger: 0.08, ease: 'power1.inOut' }, 0.1);
          tl.to('.segs--convert .seg--leak', { autoAlpha: 1, duration: 0.45 }, 0.6);
          tl.to('.leak-mark--2', { autoAlpha: 1, duration: 0.45 }, 0.75);
          tl.to('.nodes--convert .ripple .ring', { autoAlpha: 1, scale: 1, duration: 0.7, stagger: 0.12, ease: 'back.out(1.4)' }, 0.7);
          tl.to('.convert-label', { autoAlpha: 1, duration: 0.5 }, 1.1);
          tl.to('.segs--convert .seg--loop', { autoAlpha: 1, duration: 0.8 }, 1.2);
          tl.to('.loop-label', { autoAlpha: 1, duration: 0.5 }, 1.5);
        } else {
          settle('.segs--convert .seg:not(.seg--leak):not(.seg--loop)', { strokeDashoffset: 0 });
          settle('.segs--convert .seg--leak', { autoAlpha: 1 });
          settle('.leak-mark--2', { autoAlpha: 1 });
          settle('.nodes--convert .ripple .ring', { autoAlpha: 1, scale: 1 });
          settle('.convert-label', { autoAlpha: 1 });
          settle('.segs--convert .seg--loop', { autoAlpha: 1 });
          settle('.loop-label', { autoAlpha: 1 });
        }
      } else {
        settle('.segs--convert .seg:not(.seg--leak):not(.seg--loop)', { strokeDashoffset: 1 });
        settle('.segs--convert .seg--leak', { autoAlpha: 0 });
        settle('.leak-mark--2', { autoAlpha: 0 });
        settle('.nodes--convert .ripple .ring', { autoAlpha: 0, scale: 0.4 });
        settle('.convert-label', { autoAlpha: 0 });
        settle('.segs--convert .seg--loop', { autoAlpha: 0 });
        settle('.loop-label', { autoAlpha: 0 });
      }

      railNodes.forEach((n, i) => n.classList.toggle('is-active', i <= next));
    }

    const st = ScrollTrigger.create({
      trigger: stageEl,
      start: 'top top',
      end: '+=4200',
      pin: true,
      onEnter: () => applyStage(0),
      onUpdate: (self) => {
        const p = self.progress;
        if (bar) bar.style.transform = `scaleX(${p})`;
        if (hint) hint.style.opacity = p > 0.03 ? '0' : '1';
        if (marker) marker.style.top = `${Math.min(98, Math.max(2, p * 100))}%`;
        let target = 0;
        THRESHOLDS.forEach((t, i) => { if (p >= t) target = i; });
        applyStage(target);
      },
    });

    // --- play / pause -----------------------------------------------------
    const SPEED = 150; // px of scroll per second while auto-playing
    let drive: gsap.core.Timeline | null = null;

    const setToggleUI = (playing: boolean) => {
      if (!toggle) return;
      toggle.textContent = playing ? '❚❚' : '▶';
      toggle.setAttribute('aria-label', playing ? 'Pause the journey' : 'Play the journey');
    };

    const stopDrive = () => {
      drive?.kill();
      drive = null;
      setToggleUI(false);
    };

    const startDrive = () => {
      stopDrive();
      const atEnd = window.scrollY >= st.end - 20;
      const from = window.scrollY < st.start || atEnd ? st.start : window.scrollY;
      const tlDrive = gsap.timeline({ onComplete: stopDrive });
      if (Math.abs(from - window.scrollY) > 4) {
        tlDrive.to(window, { scrollTo: { y: from, autoKill: false }, duration: 0.6, ease: 'power1.inOut' });
      }
      // autoKill hands control back the moment the user scrolls themselves
      tlDrive.to(window, {
        scrollTo: { y: st.end, autoKill: true, onAutoKill: stopDrive },
        duration: Math.max(1, (st.end - from) / SPEED),
        ease: 'none',
      });
      drive = tlDrive;
      setToggleUI(true);
    };

    toggle?.addEventListener('click', () => (drive ? stopDrive() : startDrive()));
    heroPlay?.addEventListener('click', startDrive);

    // clicking a rail node jumps to that stage's scroll position
    railNodes.forEach((node, i) => {
      node.addEventListener('click', () => {
        stopDrive();
        const y = st.start + THRESHOLDS[i] * (st.end - st.start) + 10;
        gsap.to(window, { scrollTo: { y, autoKill: true }, duration: 0.8, ease: 'power2.inOut' });
      });
    });

    if (location.hostname === 'localhost') {
      // Dev-only hook so the stages can be driven from the console
      (window as any).__journey = { gsap, ScrollTrigger, applyStage, st, startDrive, stopDrive };
    }

    return () => {
      stopDrive();
      transTl?.kill();
      st.kill();
    };
  });
</script>
