---
import '../styles/global.css';
import RippleMark from '../components/RippleMark.astro';
import Analytics from '../components/Analytics.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getDoc, getServices } from '../lib/sanity.js';
import { normalizeSocialProfiles } from '../lib/social.js';
import { serviceHref } from '../lib/pillars.js';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD blocks to append after the org schema. */
  schema?: object[];
  /** Keep prototype pages out of search until they're incorporated. */
  noindex?: boolean;
  /**
   * Which service line this page belongs to, if any. Declared once here and
   * attached to every analytics event fired from the page — see the `enrich`
   * helper in Analytics.astro. Use the service slug, so the property joins
   * cleanly against the `/services/:slug/` pageview report.
   *
   * Pages that sell nothing in particular (home, about, Pulse index, privacy)
   * leave it unset and report as `(none)`, which is the honest answer: their
   * traffic belongs to no line.
   *
   * Emitted as `data-service-line` on <html> rather than on <body> because
   * Analytics.astro renders inside <head>, and at the moment its inline script
   * parses there is no <body> yet. Nothing may precede the <html> tag below,
   * not even a comment — the compiler stops treating the file as a document
   * and silently drops the html/head/body wrappers from every page.
   */
  serviceLine?: string;
}

const { title, description, schema = [], noindex = false, serviceLine } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();

const settings = await getDoc('siteSettings');
// Memoised in lib/sanity.js — Base renders on every page, so an unmemoised
// fetch here would multiply across the whole build. Order is Sanity
// `service.order` (site-wide), already applied in the GROQ query.
const services = await getServices();

// `sameAs` is the whole reason the URL field is validated so hard in the
// Studio: it is the claim that these accounts and this site are one entity,
// which is what lets Google consolidate them. Omitted rather than emitted
// empty — a bare `sameAs: []` asserts "no other profiles exist".
const socialUrls = normalizeSocialProfiles(settings.socialProfiles).map((s) => s.url);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Panta LLC',
  alternateName: 'panta',
  url: Astro.site?.toString(),
  logo: new URL('/favicon.svg', Astro.site).toString(),
  email: 'hello@panta.llc',
  description:
    `Digital, strategic, and creative support for organizations that serve people — ${services.map((s) => s.title.toLowerCase()).join(', ')}.`,
  slogan: 'One good move, felt everywhere.',
  areaServed: 'United States',
  knowsAbout: [...services.map((s) => s.title.toLowerCase()), 'nonprofit digital strategy'],
  ...(socialUrls.length > 0 && { sameAs: socialUrls }),
};

// `desktop: false` keeps an item out of the header but still in the mobile
// panel, where a list row costs nothing. Contact is desktop-false on purpose:
// it and "Get started" are the same intent, and two adjacent header entries
// meaning "talk to Panta" split the click away from the bookable one.
const flatNavItems = [
  { href: '/work/', label: 'Work', cta: 'work', desktop: true },
  { href: '/pulse/', label: 'Pulse', cta: 'pulse', desktop: true },
  { href: '/about/', label: 'About', cta: 'about', desktop: true },
  { href: '/contact/', label: 'Contact', cta: 'contact', desktop: false },
];

// The `websitesNav` shortcut that used to lead the mobile panel is gone: with
// the services enumerated in both navs, "Websites" was the third link to
// /services/web-design-development/ in the same panel (the other two being the
// enumeration and the "Start here" quick link, which is also removed below).

// Practices are framed by the brand verbs (see practice-taxonomy.md): the verb
// is the eyebrow, the plain-English name is the link, because prospects search
// for the thing and not for the verb. The verbs also encode the split that made
// the old three-practice structure incoherent — BUILD is client services,
// CONNECT is community work with no buyer, CREATE is our own products.

// BUILD: the one practice with an offer. It used to be a single full-size card
// reading "Digital, Strategic & Creative" and pointing at /services/ — the same
// destination the intro column's "All services" already offers. The menu now
// enumerates the services themselves instead.
//
// The reason is that the homepage hero's "What we do" index came out when the
// packages grid landed, and the mega menu was the only other place a visitor
// could see the full list. A menu that names one abstraction and links to a
// page listing four things is a click of indirection for no information; the
// list is short enough to just show.
//
// `services` is already fetched above for the org JSON-LD, and getServices() is
// memoised, so enumerating here costs no extra query across the build.
// serviceHref() owns the pageReady decision, exactly as the hero index did.

// Roadmap practices: still linked, still indexed, visually subordinate.
const megaNext = [
  { href: '/community-programs/', label: 'Community programs', cta: 'community_programs' },
  { href: '/product-development/', label: 'Products we release', cta: 'product_development' },
];

const megaQuickLinks = [
  // The page top, not #book. This label names the offer; it does not promise a
  // calendar. Deep-linking it to the scheduler dropped the visitor onto a bare
  // booking embed with the entire explanation of what the review is —
  // and what they walk away with — scrolled off above them. See the rule in
  // index.astro. Buttons that do promise a slot ("or pick a time now") still
  // deep-link.
  { href: '/consultation/', label: 'Get a free review', cta: 'consultation' },
  // Web design & development was here; it is now in the enumerated list above,
  // and a "Start here" row repeating a link one row up is not a shortcut.
  { href: '/digital-presence-plan/', label: 'The Digital Presence Plan', cta: 'plan' },
  { href: '/work/', label: 'Client work', cta: 'work' },
  { href: '/contact/', label: 'Contact', cta: 'contact' },
];

const footerLinks = [
  // The page top, not #book — same reason as megaQuickLinks above.
  { href: '/consultation/', label: 'Get a free review', cta: 'consultation' },
  { href: '/services/web-design-development/', label: 'Web design & development', cta: 'websites' },
  { href: '/digital-presence-plan/', label: 'The Digital Presence Plan', cta: 'plan' },
  { href: '/work/', label: 'Client work', cta: 'work' },
  { href: '/services/', label: 'Services', cta: 'services' },
  { href: '/about/', label: 'About Panta', cta: 'about' },
  { href: '/contact/', label: 'Contact', cta: 'contact' },
];

const footerNextLinks = [
  { href: '/community-programs/', label: 'Community programs', cta: 'community_programs' },
  { href: '/product-development/', label: 'Products we release', cta: 'product_development' },
];

/**
 * The "Start here" shortcuts, minus anything the mobile panel already reaches.
 *
 * On desktop the full set is fine: it sits in its own labelled strip at the
 * foot of the mega panel, visually separate from everything above it. The
 * mobile panel has no such separation, so the same four links ran straight on
 * from the enumerated services and read as more services — and three of them
 * were already on screen. "Client work" and "Contact" repeat the Panta group
 * below, and "Get a free review" is the same URL as BOTH the
 * persistent header button and the button closing this panel, so it was the
 * third copy of one link.
 *
 * Filtering by href rather than deleting entries keeps the desktop strip whole
 * and means a genuinely new shortcut added later shows up on mobile by itself.
 */
const mobileReachable = new Set([
  '/services/',
  '/consultation/',
  ...services.map((s) => serviceHref(s)),
  ...megaNext.map((p) => p.href),
  ...flatNavItems.map((i) => i.href),
]);
const mobileQuickLinks = megaQuickLinks.filter((l) => !mobileReachable.has(l.href));

const currentPath = Astro.url.pathname.replace(/\/?$/, '/');

/**
 * Where the persistent header CTA goes.
 *
 * Off /consultation/ it is a plain link to the page, so the visitor meets the
 * explanation before the calendar. On /consultation/ itself that link would be
 * a no-op — the button is on every page, including the one it points at — so it
 * falls back to #book, which is now the chooser (what the call is, then pick a
 * time / send a note) rather than the bare scheduler it used to be.
 */
const reviewHref = currentPath === '/consultation/' ? '#book' : '/consultation/';

// Every /services/* page lights the "What we do" branch. Web design used to be
// excluded because it was its own top-level header item; it stopped being one,
// and the exclusion outlived the reason — so the trigger sat unhighlighted on
// the one service page most likely to be landed on. Now that the menu
// enumerates that service, an unlit trigger above a highlighted row in the
// panel it opens would be plainly wrong.
const workActive =
  ['/services/', '/work/', '/community-programs/', '/product-development/'].includes(currentPath) ||
  currentPath.startsWith('/services/') ||
  currentPath === '/digital-presence-plan/';
---
<!doctype html>
<html lang="en" data-service-line={serviceLine}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Panta" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <meta name="theme-color" content="#26251F" />
    {[orgSchema, ...schema].map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a href="/" class="brand" aria-label="Panta — home">
          <RippleMark size={34} />
          <span class="brand__word">panta</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <div class:list={['nav-drop', { 'nav-drop--active': workActive }]}>
            <a
              class="nav-drop__trigger"
              href="/services/"
              aria-current={currentPath === '/services/' ? 'page' : undefined}
            >
              Services
              <svg class="nav-drop__caret" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <div class="nav-mega" aria-label="What we do">
              <div class="container nav-mega__grid">
                <div class="nav-mega__intro">
                  <p class="nav-mega__label">What we do</p>
                  <p class="nav-mega__head">One good move, felt everywhere.</p>
                  <p class="nav-mega__sub">
                    What we do for clients — plus the work we build and run ourselves.
                  </p>
                  <a class="nav-mega__worklink" href="/work/">See client work <span aria-hidden="true">→</span></a>
                  <a class="nav-mega__overview" href="/services/">All services</a>
                </div>
                <div class="nav-mega__cards">
                  {/* Hairline rows with arrows, two columns — the pattern the
                      homepage hero index used before it came out. It reads as a
                      list of things you can go to, which is what a menu is, and
                      it deliberately does not compete with the header CTA. */}
                  <div class="nav-mega__services">
                    <p class="nav-mega__next-label">Services</p>
                    <ul class="nav-mega__svc-list">
                      {services.map((s) => (
                        <li>
                          <a
                            class="nav-mega__svc"
                            href={serviceHref(s)}
                            aria-current={currentPath === `/services/${s.slug}/` ? 'page' : undefined}
                            data-track="cta_click"
                            data-track-cta={`service_${s.slug}`}
                            data-track-location="mega_menu"
                          >
                            <span>{s.indexLabel ?? s.title}</span>
                            <span class="nav-mega__svc-arrow" aria-hidden="true">→</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="nav-mega__next">
                    <p class="nav-mega__next-label">What we’re building</p>
                    {megaNext.map((p) => (
                      <a
                        class="nav-mega__nextlink"
                        href={p.href}
                        aria-current={currentPath === p.href ? 'page' : undefined}
                        data-track="cta_click"
                        data-track-cta={p.cta}
                        data-track-location="mega_menu"
                      >{p.label}<span aria-hidden="true"> →</span></a>
                    ))}
                    <p class="nav-mega__next-note">Our own work, not services — talk to us if you want to shape them.</p>
                  </div>
                </div>
              </div>
              <div class="nav-mega__foot">
                <div class="container nav-mega__foot-inner">
                  <span class="nav-mega__foot-label">Start here</span>
                  {megaQuickLinks.map((l) => (
                    <a
                      href={l.href}
                      aria-current={currentPath === l.href ? 'page' : undefined}
                      data-track="cta_click"
                      data-track-cta={l.cta}
                      data-track-location="mega_menu"
                    >{l.label}</a>
                  ))}
                </div>
              </div>
            </div>
          </div>
          {flatNavItems.filter((item) => item.desktop).map((item) => (
            <a
              href={item.href}
              aria-current={currentPath === item.href ? 'page' : undefined}
              data-track="cta_click"
              data-track-cta={item.cta}
              data-track-location="header"
            >
              {item.label}
            </a>
          ))}
          <a
            href={reviewHref}
            class="btn btn--primary"
            data-track="cta_click"
            data-track-cta="consultation"
            data-track-location="header"
          >{settings.headerCtaLabel}</a>
        </nav>
        {/* Below 859px .site-nav is hidden and the CTA above goes with it, so
            the mobile header had no ask at all — only a hamburger concealing
            one. This compact twin fills that gap. It is .btn--primary and sits
            inside <header>, which check-launch.mjs strips before counting
            filled buttons, so it costs nothing against the §7.3 cap. */}
        <a
          href={reviewHref}
          class="btn btn--primary header-cta-sm"
          data-track="cta_click"
          data-track-cta="consultation"
          data-track-location="header_mobile"
        >Get a free review</a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu">
          <span class="nav-toggle__bar"></span>
          <span class="nav-toggle__bar"></span>
          <span class="nav-toggle__bar"></span>
        </button>
      </div>
      <div class="mobile-nav" id="mobile-nav">
        <nav class="container mobile-nav__inner" aria-label="Mobile">
          <p class="mobile-nav__label">What we do</p>
          <ul class="mobile-nav__list">
            <li>
              <a href="/services/" aria-current={currentPath === '/services/' ? 'page' : undefined}>All services</a>
            </li>
            {/* Enumerated for the same reason the desktop mega is — this panel
                is the only nav a phone gets, and it used to name one abstraction
                where the list itself fits fine. */}
            {services.map((s) => (
              <li>
                <a
                  class="mobile-nav__sub"
                  href={serviceHref(s)}
                  aria-current={currentPath === `/services/${s.slug}/` ? 'page' : undefined}
                  data-track="cta_click"
                  data-track-cta={`service_${s.slug}`}
                  data-track-location="mobile_nav"
                >{s.indexLabel ?? s.title}</a>
              </li>
            ))}
          </ul>
          {/* Its own labelled group, not a tail on the services list. These
              were previously four anchors crammed into a single <li>, which is
              why they ran on with no separation — and invalid list markup
              besides. */}
          {mobileQuickLinks.length > 0 && (
            <>
              <p class="mobile-nav__label">Start here</p>
              <ul class="mobile-nav__list">
                {mobileQuickLinks.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      aria-current={currentPath === l.href ? 'page' : undefined}
                      data-track="cta_click"
                      data-track-cta={l.cta}
                      data-track-location="mobile_nav"
                    >{l.label}</a>
                  </li>
                ))}
              </ul>
            </>
          )}
          <p class="mobile-nav__label">What we’re building</p>
          <ul class="mobile-nav__list">
            {megaNext.map((p) => (
              <li>
                <a
                  class="mobile-nav__sub"
                  href={p.href}
                  aria-current={currentPath === p.href ? 'page' : undefined}
                  data-track="cta_click"
                  data-track-cta={p.cta}
                  data-track-location="mobile_nav"
                >{p.label}</a>
              </li>
            ))}
          </ul>
          <p class="mobile-nav__label">Panta</p>
          <ul class="mobile-nav__list">
            {flatNavItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={currentPath === item.href ? 'page' : undefined}
                  data-track="cta_click"
                  data-track-cta={item.cta}
                  data-track-location="mobile_nav"
                >{item.label}</a>
              </li>
            ))}
          </ul>
          <a
            href={reviewHref}
            class="btn btn--primary mobile-nav__cta"
            data-track="cta_click"
            data-track-cta="consultation"
            data-track-location="mobile_nav"
          >{settings.headerCtaLabel}</a>
        </nav>
      </div>
    </header>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const panel = document.getElementById('mobile-nav');

      const setOpen = (open: boolean) => {
        if (!toggle || !panel) return;
        panel.classList.toggle('is-open', open);
        toggle.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', String(open));
      };

      toggle?.addEventListener('click', () => {
        setOpen(!panel?.classList.contains('is-open'));
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && panel?.classList.contains('is-open')) {
          setOpen(false);
          toggle?.focus();
        }
      });

      // Tap outside the header closes the panel.
      document.addEventListener('click', (e) => {
        if (
          panel?.classList.contains('is-open') &&
          e.target instanceof Node &&
          !document.querySelector('.site-header')?.contains(e.target)
        ) {
          setOpen(false);
        }
      });
    </script>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="site-footer__grid">
          <div>
            <a href="/" class="brand" aria-label="Panta — home" style="color: var(--cream);">
              <RippleMark size={30} />
              <span class="brand__word">panta</span>
            </a>
            <p class="site-footer__tag">{settings.footerTagline}</p>
            <p style="font-size: 0.95rem; max-width: 34ch;">{settings.footerDescriptor}</p>
          </div>
          <nav aria-label="Footer">
            <p class="label" style="color: var(--sage);">Explore</p>
            <ul class="footer-list">
              {footerLinks.map((l) => (
                <li>
                  <a
                    href={l.href}
                    data-track="cta_click"
                    data-track-cta={l.cta}
                    data-track-location="footer"
                  >{l.label}</a>
                </li>
              ))}
            </ul>
            <p class="label" style="color: var(--sage); margin-top: 1.5rem;">What we’re building</p>
            <ul class="footer-list">
              {footerNextLinks.map((l) => (
                <li>
                  <a
                    href={l.href}
                    data-track="cta_click"
                    data-track-cta={l.cta}
                    data-track-location="footer"
                  >{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
          <div>
            <p class="label" style="color: var(--sage);">Say hello</p>
            <ul class="footer-list">
              <li><a href={`mailto:${settings.email}`}>{settings.email}</a></li>
              <li><span style="color: var(--stone);">{settings.locationLine}</span></li>
            </ul>
            <SocialLinks profiles={settings.socialProfiles} />
          </div>
        </div>
        <div class="site-footer__meta">
          <span>© {year} Panta LLC. All rights reserved.</span>
          <span>{settings.replyLine}</span>
        </div>
      </div>
    </footer>

    {/*
      The consent banner and Vercel's Speed Insights both stood here. The
      banner existed only to gate GA4, and with Plausible there is nothing to
      gate — it is cookieless and stores nothing on the device, so a banner
      would ask permission for something that needs none. Speed Insights went
      with the second and third trackers; Core Web Vitals are still visible in
      the Vercel dashboard from the edge, without shipping a script for them.
    */}
  </body>
</html>
